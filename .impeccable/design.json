  "narrative": {
    "northStar": "The Quiet Console",
    "overview": "The harness is a room you glance into while agents work. Most of the time nothing needs you, and the screen should look like it: near-monochrome surfaces, small precise type, lists that read like good CLI output. Color is a signal, not a decoration: teal means an agent is working, amber means it is waiting on you, red means it broke. Everything else, including things that finished successfully, recedes to neutral.",
    "keyCharacteristics": [
      "Restrained palette: tinted neutrals plus one accent (signal teal) on ≤ 10% of any screen.",
      "Status always pairs a dot with a word; color is never the only carrier.",
      "Flat, tonal layering; a shadow appears only on surfaces that float over others.",
      "Fixed rem type scale, 14px body, one sans and its mono sibling.",
      "Every Layout primitives do the layout; blocks stay skeletal; state lives in data-* / ARIA attributes.",
      "Motion is 90–240ms ease-out, state-only, and collapses to instant under prefers-reduced-motion."
    ],
    "rules": [
      { "name": "The Done Goes Quiet Rule", "body": "A finished session is gray, not green. Only running, waiting and failed are colored.", "section": "colors" },
      { "name": "The One Signal Rule", "body": "Signal teal covers ≤ 10% of any screen. If two primary buttons sit side by side, one is wrong.", "section": "colors" },
      { "name": "The Word Beside the Dot Rule", "body": "Every colored status ships with its word or an accessible name.", "section": "colors" },
      { "name": "The No Shouting Rule", "body": "Nothing is larger than 22px, and nothing is uppercase-tracked.", "section": "typography" },
      { "name": "The Mono Means Machine Rule", "body": "Monospace marks text a machine produced or will parse.", "section": "typography" },
      { "name": "The Only What Floats Rule", "body": "If it does not overlap other content, it has no shadow.", "section": "elevation" }
    ],
    "dos": [
      "Do compose layout from the Every Layout primitives first and keep blocks to token assignments.",
      "Do express variants and state through data-* and ARIA attributes in the exceptions layer.",
      "Do read every color from a semantic role; a raw oklch() outside tokens.css is a bug.",
      "Do pair every status color with its word, and announce state changes through the stream bar.",
      "Do show the error code and the next action for every StructuredError.",
      "Do keep transitions between 90 and 240ms with --ease-out, with reduced-motion fallbacks.",
      "Do keep text contrast ≥ 4.5:1 and control edges ≥ 3:1 in both themes."
    ],
    "donts": [
      "Don't build busy IDE chrome: dozens of panels, toolbars, icon rows and tabs competing for attention.",
      "Don't bring back the old designer's Tailwind/daisyUI defaults: stock purple primary, pink secondary.",
      "Don't color a finished session green on a resting list.",
      "Don't loop animations to show liveness.",
      "Don't use border-left / border-right thicker than 1px as a colored accent.",
      "Don't use gradient text, glassmorphism, neon glows, or green-on-black hacker styling.",
      "Don't set anything above 22px or use uppercase tracked eyebrows.",
      "Don't add shadows to surfaces that don't float, or nest a pane inside a pane.",
      "Don't reach for a modal first.",
      "Don't restyle native scrollbars, checkboxes or selects beyond theme color."
    ]
  }
}
