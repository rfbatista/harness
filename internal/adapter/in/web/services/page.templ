package services

import (
	"operators-mcp/internal/adapter/in/web/components"
	"operators-mcp/internal/adapter/in/web/shell"
)

// Page is a project's Services page. servicesPage renders it from the seed:
// the services grouped Running and Not running, each row with its status,
// ports, where it runs and who started it, kept live by the services feed.
templ Page(frame shell.Frame, projectID, projectName string, seed Seed) {
	@shell.AppShell(frame) {
		@templ.JSONScript("services-seed", seed)
		<main id="main" class="[ frame ]" x-data="servicesPage" data-seed="services-seed">
			<header class="[ toolbar ]">
				<a class="[ crumb ]" href={ templ.SafeURL("/projects/" + projectID) }>{ projectName } /</a>
				<h1>Services</h1>
				<span class="[ badge ]" data-tone="signal" role="status" data-running-badge x-bind:hidden="!hasRunning" x-text="runningLabel"></span>
			</header>
			<div class="[ split-view ]" data-scroll data-wide-list x-bind:data-detail="detailOpen ? '' : null" x-bind:data-no-detail="noDetail ? '' : null" data-no-detail x-on:service-log-close="closeLog">
				<div class="[ list divide-end ]" data-services role="group" aria-label="Services" x-bind:aria-busy="loading">
					<template x-for="notice in notices" x-bind:key="notice.key">
						<div class="[ pad-s ]" style="padding: var(--space-s) var(--space-l) 0">
							<div class="[ banner ]" data-tone="attention" role="status" data-services-notice x-bind:data-key="notice.key">
								<div class="[ flow ] [ flow-space-3xs grow ]">
									<strong x-text="notice.title"></strong>
									<span x-text="notice.message"></span>
									<span class="[ code ]" x-bind:hidden="!notice.hasCode"><span x-text="notice.code"></span> · <span x-text="notice.next"></span></span>
								</div>
								<a class="[ button ]" data-size="sm" x-bind:href="notice.href" x-text="notice.action"></a>
							</div>
						</div>
					</template>
					<template x-if="refusal">
						<div class="[ pad-s ]" style="padding: var(--space-s) var(--space-l) 0">
							<div class="[ banner ]" data-tone="danger" role="alert" data-services-refusal>
								<div class="[ flow ] [ flow-space-3xs grow ]">
									<strong x-text="refusal.title"></strong>
									<span x-text="refusal.message"></span>
									<span class="[ code ]"><span x-text="refusal.code"></span> · <span x-text="refusal.next"></span></span>
								</div>
								<template x-for="link in refusal.links" x-bind:key="link.href">
									<a class="[ button ]" data-size="sm" x-bind:href="link.href" x-text="link.text"></a>
								</template>
								<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissRefusal">Dismiss</button>
							</div>
						</div>
					</template>
					<template x-if="error">
						<div class="[ pad-s ]" style="padding: var(--space-s) var(--space-l) 0">
							<div class="[ banner ]" data-tone="danger" role="alert">
								<div class="[ flow ] [ flow-space-3xs grow ]">
									<span x-text="error.message"></span>
									<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
								</div>
								<button type="button" class="[ button ]" data-size="sm" x-on:click="retry">Try again</button>
								<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
							</div>
						</div>
					</template>
					<template x-if="skeleton">
						@components.SkeletonRows("Loading services", 4, "7rem")
					</template>
					<template x-for="group in groups" x-bind:key="group.key">
						<div data-service-group x-bind:data-group="group.key">
							<div class="[ group ]">
								<span x-text="group.label"></span>
								<span class="[ badge ]" x-bind:data-tone="group.tone" x-text="group.count"></span>
							</div>
							<template x-for="row in group.rows" x-bind:key="row.id">
								<div class="[ row ]" data-layout="service" data-service x-bind:data-name="row.name" x-bind:aria-current="row.current ? 'true' : null">
									<span class="[ status ]" data-service-status x-bind:data-state="row.status.state" x-bind:data-tone="row.status.tone" x-text="row.status.word"></span>
									<div class="[ main ]">
										<div class="[ head ]">
											<span class="[ name ]" data-service-name x-text="row.name"></span>
											<span class="[ badge ]" x-text="row.kindLabel"></span>
											<span class="[ badge ]" data-tone="attention" data-not-sandboxed title="The sandbox setting was off: this run is not confined" x-bind:hidden="!row.notSandboxed">not sandboxed</span>
										</div>
										<div class="[ line ]" x-bind:title="row.line" x-text="row.line"></div>
										<div class="[ facts ]">
											<span class="[ ports ]" x-bind:hidden="!row.hasPorts">
												<template x-for="port in row.ports" x-bind:key="port.text">
													<span>
														<a data-service-port x-bind:href="port.href" x-bind:aria-label="port.name" target="_blank" rel="noopener" x-bind:hidden="!port.link" x-text="port.text"></a>
														<span x-bind:hidden="port.link" x-text="port.text"></span>
													</span>
												</template>
											</span>
											<span data-service-where x-bind:hidden="!row.where" x-text="row.where"></span>
											<span data-service-by x-bind:hidden="!row.startedBy" x-text="row.startedByText"></span>
											<span data-service-time x-text="row.time"></span>
										</div>
										<p class="[ reason ]" data-service-reason x-bind:hidden="!row.hasReason"><span x-text="row.reason"></span> <button type="button" class="[ button ]" data-variant="link" data-size="sm" x-bind:data-service-id="row.id" x-on:click="openLogRow">Open log</button></p>
									</div>
									<div class="[ actions ]">
										<button type="button" class="[ button ]" data-variant="primary" data-size="sm" data-action="start" x-show="row.start.show" x-bind:data-service-id="row.id" x-bind:aria-label="row.start.name" x-bind:title="row.start.title" x-bind:disabled="row.start.disabled" x-bind:aria-busy="row.start.busy" x-on:click="startRow" x-text="row.start.text"></button>
										<button type="button" class="[ button ]" data-size="sm" data-action="stop" x-show="row.stop.show" x-bind:data-service-id="row.id" x-bind:aria-label="row.stop.name" x-bind:disabled="row.stop.disabled" x-bind:aria-busy="row.stop.busy" x-on:click="stopRow" x-text="row.stop.text"></button>
										<button type="button" class="[ button ]" data-size="sm" data-action="restart" x-show="row.restart.show" x-bind:data-service-id="row.id" x-bind:aria-label="row.restart.name" x-bind:disabled="row.restart.disabled" x-bind:aria-busy="row.restart.busy" x-on:click="restartRow" x-text="row.restart.text"></button>
										<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-action="log" x-bind:data-service-id="row.id" x-bind:aria-label="row.logName" x-bind:title="row.logName" x-on:click="openLogRow">Log</button>
									</div>
								</div>
							</template>
						</div>
					</template>
					<template x-if="empty">
						<div class="[ empty ]" data-services-empty>
							<h2>No services yet</h2>
							<p>A service is a program that keeps running for this project, like a dev server, a worker or a database. Define it once as a command or a container image, then start and stop it here and read its log.</p>
							<p>Agents can start, stop and read the logs of your services, but only you create or edit them.</p>
							<div class="[ actions ]">
								<a class="[ button ]" href="/agents/mcp">Give agents the services tool</a>
							</div>
						</div>
					</template>
				</div>
				<template x-for="id in logIds" x-bind:key="id">
					<section class="[ pane service-log ]" x-data="serviceLog(id)" x-bind:aria-label="'Log of ' + logView.name" data-service-log>
						<header>
							<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-split-back x-on:click="$dispatch('service-log-close')">Back to the services</button>
							<span class="[ status ]" x-bind:data-state="logView.status.state" x-bind:data-tone="logView.status.tone" x-text="logView.status.word"></span>
							<h2 x-text="logView.name"></h2>
							<span class="[ meta ]" x-text="logView.runLine"></span>
							<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-label="'Close the log of ' + logView.name" x-on:click="$dispatch('service-log-close')">Close</button>
						</header>
						<template x-if="error">
							<div class="[ banner ]" data-tone="danger" role="alert">
								<div class="[ flow ] [ flow-space-3xs grow ]">
									<span x-text="error.message"></span>
									<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
								</div>
								<button type="button" class="[ button ]" data-size="sm" x-on:click="retry">Try again</button>
							</div>
						</template>
						<div class="[ log ]" role="log" tabindex="0" aria-live="off" aria-label="Log" x-ref="log" x-on:scroll="onScroll" x-bind:aria-busy="loading" data-log>
							<p class="[ earlier ]" data-log-note x-bind:hidden="!hasNote" x-text="note"></p>
							<template x-for="line in lines" x-bind:key="line.id">
								<div x-bind:class="line.kind === 'reset' ? 'reset' : 'ln'" x-bind:data-harness="line.harness ? '' : null" data-log-line><b x-show="line.harness" x-text="line.prefix"></b><span x-text="line.body"></span></div>
							</template>
							<p class="[ empty-log ]" x-bind:hidden="!empty">Nothing has been written to the log yet.</p>
						</div>
						<footer>
							<span role="status" aria-live="polite" data-log-follow x-text="footer"></span>
							<span x-bind:hidden="!hasUnseen" x-text="unseenText"></span>
							<button type="button" class="[ button push ]" data-variant="ghost" data-size="sm" x-bind:hidden="following" x-on:click="jump">Jump to latest</button>
						</footer>
					</section>
				</template>
			</div>
		</main>
	}
}
