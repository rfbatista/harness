package services

import (
	"operators-mcp/internal/adapter/in/web/components"
	"operators-mcp/internal/adapter/in/web/shell"
)

// Page is a project's Services page. servicesPage renders it from the seed:
// the services grouped Running and Not running, each row with its status,
// ports, where it runs and who started it, kept live by the services feed.
templ Page(frame shell.Frame, projectID, projectName string, seed Seed) {
	@shell.AppShell(frame) {
		@templ.JSONScript("services-seed", seed)
		<main id="main" class="[ frame ]" x-data="servicesPage" data-seed="services-seed">
			<header class="[ toolbar ]">
				<a class="[ crumb ]" href={ templ.SafeURL("/projects/" + projectID) }>{ projectName } /</a>
				<h1>Services</h1>
				<span class="[ badge ]" data-tone="signal" role="status" data-running-badge x-bind:hidden="!hasRunning" x-text="runningLabel"></span>
			</header>
			<div class="[ split-view ]" data-scroll data-wide-list data-no-detail>
				<div class="[ list divide-end ]" data-services role="group" aria-label="Services" x-bind:aria-busy="loading">
					<template x-if="error">
						<div class="[ pad-s ]" style="padding: var(--space-s) var(--space-l) 0">
							<div class="[ banner ]" data-tone="danger" role="alert">
								<div class="[ flow ] [ flow-space-3xs grow ]">
									<span x-text="error.message"></span>
									<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
								</div>
								<button type="button" class="[ button ]" data-size="sm" x-on:click="retry">Try again</button>
								<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
							</div>
						</div>
					</template>
					<template x-if="skeleton">
						@components.SkeletonRows("Loading services", 4, "7rem")
					</template>
					<template x-for="group in groups" x-bind:key="group.key">
						<div data-service-group x-bind:data-group="group.key">
							<div class="[ group ]">
								<span x-text="group.label"></span>
								<span class="[ badge ]" x-bind:data-tone="group.tone" x-text="group.count"></span>
							</div>
							<template x-for="row in group.rows" x-bind:key="row.id">
								<div class="[ row ]" data-layout="service" data-service x-bind:data-name="row.name">
									<span class="[ status ]" data-service-status x-bind:data-state="row.status.state" x-bind:data-tone="row.status.tone" x-text="row.status.word"></span>
									<div class="[ main ]">
										<div class="[ head ]">
											<span class="[ name ]" data-service-name x-text="row.name"></span>
											<span class="[ badge ]" x-text="row.kindLabel"></span>
											<span class="[ badge ]" data-tone="attention" data-not-sandboxed title="The sandbox setting was off: this run is not confined" x-bind:hidden="!row.notSandboxed">not sandboxed</span>
										</div>
										<div class="[ line ]" x-bind:title="row.line" x-text="row.line"></div>
										<div class="[ facts ]">
											<span class="[ ports ]" x-bind:hidden="!row.hasPorts">
												<template x-for="port in row.ports" x-bind:key="port.text">
													<span>
														<a data-service-port x-bind:href="port.href" x-bind:aria-label="port.name" target="_blank" rel="noopener" x-bind:hidden="!port.link" x-text="port.text"></a>
														<span x-bind:hidden="port.link" x-text="port.text"></span>
													</span>
												</template>
											</span>
											<span data-service-where x-bind:hidden="!row.where" x-text="row.where"></span>
											<span data-service-by x-bind:hidden="!row.startedBy" x-text="row.startedByText"></span>
											<span data-service-time x-text="row.time"></span>
										</div>
										<p class="[ reason ]" data-service-reason x-bind:hidden="!row.hasReason" x-text="row.reason"></p>
									</div>
								</div>
							</template>
						</div>
					</template>
					<template x-if="empty">
						<div class="[ empty ]" data-services-empty>
							<h2>No services yet</h2>
							<p>A service is a program that keeps running for this project, like a dev server, a worker or a database. Define it once as a command or a container image, then start and stop it here and read its log.</p>
							<p>Agents can start, stop and read the logs of your services, but only you create or edit them.</p>
							<div class="[ actions ]">
								<a class="[ button ]" href="/agents/mcp">Give agents the services tool</a>
							</div>
						</div>
					</template>
				</div>
			</div>
		</main>
	}
}
