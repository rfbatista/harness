package architecture

// tabLayers is the Layers tab's panel. It is its own Alpine component,
// architectureLayersTab, nested in architecturePage: it reads and edits the
// page's draft and errors through the page's scope.
templ tabLayers() {
	<section role="tabpanel" id="architecture-panel-layers" aria-labelledby="architecture-tab-layers" x-show="isTab('layers')" x-data="architectureLayersTab" class="[ flow ]">
		<h2>Layers</h2>
		<p class="[ color-ink-muted ]">The parts of the repository, by folder or by pattern, and which agents may read and change each. A path belongs to one layer: when layers overlap, the narrower pattern wins (a regex over a folder, a deeper folder over a shallower one, the first regex over a later one).</p>
		<div class="[ cluster ]">
			<button type="button" class="[ button ]" data-add-layer="folder" x-on:click="add('folder')">Add layer by folder</button>
			<button type="button" class="[ button ]" data-add-layer="regex" x-on:click="add('regex')">Add layer by regex</button>
		</div>
		<template x-if="previewFailed">
			<div class="[ banner ]" data-tone="attention" role="status" data-preview-failed>
				<span class="[ grow ]" x-text="previewFailed"></span>
			</div>
		</template>
		<template x-if="isEmpty">
			<p class="[ color-ink-muted ]" data-no-layers>No layers yet. Without layers, a rule cannot tell an edit inside an agent's area from one outside it.</p>
		</template>
		<div class="[ flow ]" role="list" aria-label="Layers">
			<template x-for="row in rows" x-bind:key="row.i">
				<section class="[ pane ]" role="listitem" x-bind:data-layer="row.i" x-bind:aria-label="row.title">
					<header>
						<span class="[ grow ]" x-text="row.title"></span>
						<span class="[ text-sm color-ink-muted ]" data-layer-count x-text="row.countText"></span>
						<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-move="up" x-bind:disabled="row.first" x-bind:aria-label="row.moveUpLabel" x-on:click="move(row.i, -1)">Up</button>
						<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-move="down" x-bind:disabled="row.last" x-bind:aria-label="row.moveDownLabel" x-on:click="move(row.i, 1)">Down</button>
						<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-remove-layer x-bind:aria-label="row.removeLabel" x-on:click="remove(row.i)">Remove</button>
					</header>
					<div class="[ content ] [ flow ]">
						<div class="[ layer-fields ]">
							<div class="[ field ]">
								<label x-bind:for="row.ids.name">Name</label>
								<input x-bind:id="row.ids.name" data-field="name" class="[ text-sm ]" autocomplete="off" spellcheck="false" x-model="row.layer.name" x-bind:aria-invalid="row.nameError !== ''"/>
								<template x-if="row.nameError">
									<span class="[ error ]" x-bind:data-error-for="row.namePath" x-text="row.nameError"></span>
								</template>
							</div>
							<div class="[ field ]" role="group" x-bind:aria-labelledby="row.ids.matchBy">
								<span x-bind:id="row.ids.matchBy" class="[ text-sm weight-medium ]">Match by</span>
								<span class="[ segmented ]">
									<button type="button" data-match-kind="folder" x-bind:aria-pressed="row.kind === 'folder'" x-on:click="setKind(row.i, 'folder')">Folder</button>
									<button type="button" data-match-kind="regex" x-bind:aria-pressed="row.kind === 'regex'" x-on:click="setKind(row.i, 'regex')">Regex</button>
								</span>
							</div>
							<div class="[ field ] [ layer-pattern ]">
								<label x-bind:for="row.ids.pattern" x-text="row.patternLabel"></label>
								<input x-bind:id="row.ids.pattern" data-field="pattern" class="[ text-sm font-mono ]" autocomplete="off" spellcheck="false" x-bind:placeholder="row.placeholder" x-model="row.pattern" x-bind:aria-invalid="row.patternError !== ''"/>
								<template x-if="row.patternError">
									<span class="[ error ]" x-bind:data-error-for="row.patternPath" x-text="row.patternError"></span>
								</template>
								<template x-if="!row.patternError">
									<span class="[ hint ]" x-text="row.patternHint"></span>
								</template>
							</div>
							<div class="[ field ]">
								<label x-bind:for="row.ids.context">Bounded context (optional)</label>
								<input x-bind:id="row.ids.context" data-field="bounded_context" class="[ text-sm ]" autocomplete="off" spellcheck="false" x-model="row.context" x-bind:aria-invalid="row.contextError !== ''"/>
								<template x-if="row.contextError">
									<span class="[ error ]" x-bind:data-error-for="row.contextPath" x-text="row.contextError"></span>
								</template>
								<template x-if="!row.contextError">
									<span class="[ hint ]">Type the name of one of the project's bounded contexts.</span>
								</template>
							</div>
							<div class="[ field ]">
								<label x-bind:for="row.ids.purpose">Purpose (optional)</label>
								<input x-bind:id="row.ids.purpose" data-field="purpose" class="[ text-sm ]" autocomplete="off" x-model="row.purpose"/>
							</div>
						</div>
						<template x-if="row.sample.length > 0">
							<div class="[ flow ] [ flow-space-3xs ]">
								<span class="[ text-sm color-ink-faint ]">Matched paths</span>
								<ul class="[ flow ] [ flow-space-3xs font-mono text-sm ]" data-layer-sample>
									<template x-for="p in row.sample" x-bind:key="p">
										<li x-text="p"></li>
									</template>
									<template x-if="row.more > 0">
										<li class="[ color-ink-faint ]" x-text="row.moreText"></li>
									</template>
								</ul>
							</div>
						</template>
					</div>
				</section>
			</template>
		</div>
		<template x-if="hasPreview">
			<section class="[ pane ]" aria-label="Repository coverage" data-coverage>
				<header>
					<span class="[ grow ]">Repository coverage</span>
				</header>
				<div class="[ content ] [ flow ]">
					<div class="[ flow ] [ flow-space-3xs ]">
						<span class="[ weight-medium ]">Unmatched: <span data-unmatched-count x-text="unmatchedText"></span></span>
						<span class="[ text-sm color-ink-muted ]">Files in no layer fall to the access set for unlayered paths.</span>
						<ul class="[ flow ] [ flow-space-3xs font-mono text-sm ]" data-unmatched>
							<template x-for="p in unmatchedSample" x-bind:key="p">
								<li x-text="p"></li>
							</template>
						</ul>
					</div>
					<div class="[ flow ] [ flow-space-3xs ]">
						<span class="[ weight-medium ]" data-overlap-title x-text="overlapTitle"></span>
						<ul class="[ flow ] [ flow-space-3xs text-sm ]" data-overlaps>
							<template x-for="o in overlaps" x-bind:key="o.path">
								<li data-overlap><span class="[ font-mono ]" x-text="o.path"></span> <span class="[ badge ]" data-tone="attention">! overlap</span> <span x-text="o.text"></span></li>
							</template>
						</ul>
					</div>
				</div>
			</section>
		</template>
	</section>
}
