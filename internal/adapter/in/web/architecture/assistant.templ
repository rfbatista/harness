package architecture

// assistantPanel is the architecture assistant: an Assistant button for the
// toolbar and the side panel it opens. It is its own Alpine component,
// architectureAssistant, nested in architecturePage: it reads the page's
// draft and sends it with each turn, and it never saves anything. Without an
// assistant the button is disabled and the reason is beside it.
templ assistantPanel() {
	<div class="[ assistant ]" x-data="architectureAssistant" x-on:pagehide.window="leave">
		<button type="button" class="[ button ]" data-size="sm" data-assistant-open x-bind:disabled="unavailable" x-bind:aria-expanded="open" aria-controls="architecture-assistant" x-on:click="toggle">Assistant</button>
		<template x-if="unavailable">
			<span class="[ text-xs color-ink-muted ]" data-assistant-unavailable role="status">
				<span x-text="reason"></span>
				<template x-if="fixUrl">
					<a x-bind:href="fixUrl">Fix this</a>
				</template>
			</span>
		</template>
		<aside id="architecture-assistant" class="[ assistant-panel ]" data-assistant-panel role="complementary" aria-label="Architecture assistant" x-show="open" x-on:keydown="onPanelKey">
			<header>
				<h2>Architecture assistant</h2>
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-assistant-close x-on:click="close">Close</button>
			</header>
			<div class="[ log ]" role="log" aria-live="polite" aria-label="Conversation">
				<template x-if="messages.length === 0">
					<p class="[ color-ink-muted text-sm ]">Ask for the layers, the access or a rule for this repository, or a change to what is there. Nothing is saved until you press Save.</p>
				</template>
				<template x-for="m in messages" x-bind:key="m.id">
					<div class="[ message ]" data-assistant-message x-bind:data-who="m.who" x-show="m.who === 'person' || m.text !== ''">
						<span x-text="m.text"></span>
					</div>
				</template>
				<template x-for="(line, i) in activity" x-bind:key="i">
					<p class="[ activity-line ]" data-assistant-activity x-text="line"></p>
				</template>
				<template x-if="running">
					<p class="[ working ]" role="status">The assistant is working…</p>
				</template>
				<template x-if="failure">
					<p class="[ notice ]" data-tone="danger" data-assistant-error role="alert" x-text="failure"></p>
				</template>
				<template x-if="lost">
					<div class="[ notice ]" data-tone="attention" data-assistant-lost role="alert">
						<span>This conversation was lost: the server no longer knows it.</span>
						<button type="button" class="[ button ]" data-size="sm" data-assistant-new x-on:click="startAgain">Start a new conversation</button>
					</div>
				</template>
			</div>
			<div class="[ compose ]">
				<label class="[ visually-hidden ]" for="architecture-assistant-input">Message to the assistant</label>
				<textarea id="architecture-assistant-input" rows="3" data-assistant-input x-ref="input" x-model="input" x-on:keydown.enter="onInputKey" placeholder="Set up the layers, or ask for a change…"></textarea>
				<div class="[ actions ]">
					<template x-if="running">
						<button type="button" class="[ button ]" data-size="sm" data-assistant-stop x-on:click="stop">Stop</button>
					</template>
					<button type="button" class="[ button ]" data-variant="primary" data-size="sm" data-assistant-send x-bind:disabled="!canSend" x-on:click="send">Send</button>
				</div>
			</div>
		</aside>
	</div>
}
