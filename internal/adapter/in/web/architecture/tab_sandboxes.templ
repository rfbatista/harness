package architecture

// tabSandboxes is the Sandboxes tab's panel. It is its own Alpine component,
// architectureSandboxesTab, nested in architecturePage: it reads and edits the
// page's draft and errors through the page's scope.
templ tabSandboxes() {
	<section role="tabpanel" id="architecture-panel-sandboxes" aria-labelledby="architecture-tab-sandboxes" x-show="isTab('sandboxes')" x-data="architectureSandboxesTab" class="[ flow ]">
		<h2>Sandboxes</h2>
		<p class="[ color-ink-muted ]">Where agents run, what they can reach from there and what they cannot.</p>
		<template x-for="(row, i) in rows()" x-bind:key="i">
			<section class="[ pane ]" data-entry="sandbox">
				<header>
					<span class="[ grow font-mono ]" x-text="row.name || 'New sandbox'"></span>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-label="removeLabel(row)" x-on:click="remove(i)">Remove</button>
				</header>
				<div class="[ content flow ]">
					<div class="[ field ]">
						<label>
							Name
							<input data-field="name" class="[ text-sm font-mono ]" autocomplete="off" placeholder="seatbelt" x-model="row.name" x-bind:aria-invalid="bad(i, 'name')"/>
						</label>
						<template x-if="err(i, 'name')">
							<span class="[ error ]" x-bind:data-error-for="ptr(i, 'name')"><span aria-hidden="true">✕</span> <span x-text="err(i, 'name')"></span></span>
						</template>
					</div>
					<div class="[ field ]">
						<label>
							Runs
							<input data-field="runs" class="[ text-sm ]" autocomplete="off" placeholder="What runs inside it" x-model="row.runs" x-bind:aria-invalid="bad(i, 'runs')"/>
						</label>
						<template x-if="err(i, 'runs')">
							<span class="[ error ]" x-bind:data-error-for="ptr(i, 'runs')"><span aria-hidden="true">✕</span> <span x-text="err(i, 'runs')"></span></span>
						</template>
					</div>
					<div class="[ field ]">
						<label>
							Can reach
							<input data-field="can_reach" class="[ text-sm ]" autocomplete="off" placeholder="Separated by commas" x-bind:value="csv(row, 'can_reach')" x-on:change="setCsv(row, 'can_reach', $event)"/>
						</label>
					</div>
					<div class="[ field ]">
						<label>
							Cannot reach
							<input data-field="cannot_reach" class="[ text-sm ]" autocomplete="off" placeholder="Separated by commas" x-bind:value="csv(row, 'cannot_reach')" x-on:change="setCsv(row, 'cannot_reach', $event)"/>
						</label>
					</div>
					<div class="[ field ]">
						<label>
							Used by
							<input data-field="used_by" class="[ text-sm ]" autocomplete="off" placeholder="all, or agent names separated by commas" x-bind:value="csv(row, 'used_by')" x-on:change="setCsv(row, 'used_by', $event)" x-bind:aria-invalid="bad(i, 'used_by')"/>
						</label>
						<template x-if="err(i, 'used_by')">
							<span class="[ error ]" x-bind:data-error-for="ptr(i, 'used_by')"><span aria-hidden="true">✕</span> <span x-text="err(i, 'used_by')"></span></span>
						</template>
					</div>
				</div>
			</section>
		</template>
		<div>
			<button type="button" class="[ button ]" data-size="sm" x-on:click="add">Add a sandbox</button>
		</div>
	</section>
}
