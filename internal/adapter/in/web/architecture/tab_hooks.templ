package architecture

// tabHooks is the Hooks tab's panel. It is its own Alpine component,
// architectureHooksTab, nested in architecturePage: it reads and edits the
// page's draft and errors through the page's scope.
templ tabHooks() {
	<section role="tabpanel" id="architecture-panel-hooks" aria-labelledby="architecture-tab-hooks" x-show="isTab('hooks')" x-data="architectureHooksTab" class="[ flow ]">
		<h2>Hooks</h2>
		<p class="[ color-ink-muted ]">Rules that run at fixed points in an agent's work, blocking or only warning. They apply to every agent session in this repository, as soon as they are saved.</p>
		<div class="[ cluster ]">
			<button type="button" class="[ button ]" data-size="sm" x-bind:disabled="cannotAddEdit" x-on:click="addEdit">Add edit-outside-layer rule</button>
			<button type="button" class="[ button ]" data-size="sm" x-on:click="addCommand">Add command rule</button>
		</div>
		<template x-if="noRules">
			<p class="[ color-ink-muted ]">No rules yet. Layers are only advice until a rule enforces them.</p>
		</template>
		<template x-for="g in groups" x-bind:key="g.key">
			<section class="[ flow ]" x-bind:data-group="g.key">
				<h3 x-text="g.title"></h3>
				<template x-for="r in g.rules" x-bind:key="r.index">
					<div class="[ pane ]" x-bind:data-rule-index="r.index">
						<header>
							<span class="[ weight-medium ]" x-text="r.rule.id"></span>
							<span class="[ badge ]" data-mode x-bind:data-tone="r.rule.mode === 'blocking' ? 'danger' : 'attention'" x-text="r.modeText"></span>
							<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="remove(r.index)">Delete</button>
						</header>
						<div class="[ flow ] [ pad-m ]">
							<div class="[ field ]">
								<label x-bind:for="'rule-' + r.index + '-id'">Rule id</label>
								<input x-bind:id="'rule-' + r.index + '-id'" data-field="id" class="[ text-sm ]" autocomplete="off" placeholder="stay-in-your-layer" x-bind:value="r.rule.id ?? ''" x-bind:aria-invalid="fieldInvalid(r.index, 'id')" x-on:input="set(r.index, 'id', $event.target.value)"/>
								<template x-if="fieldError(r.index, 'id')">
									<span class="[ error ]" x-bind:data-error-for="pointer(r.index, 'id')" x-text="fieldError(r.index, 'id')"></span>
								</template>
							</div>
							<div class="[ field ]" role="group" aria-label="Mode">
								<span class="[ text-sm weight-medium ]">Mode</span>
								<div class="[ cluster ]">
									<template x-for="m in modes" x-bind:key="m.value">
										<button type="button" class="[ button ]" data-size="sm" x-bind:aria-pressed="r.rule.mode === m.value" x-on:click="set(r.index, 'mode', m.value)" x-text="m.text"></button>
									</template>
								</div>
								<template x-if="fieldError(r.index, 'mode')">
									<span class="[ error ]" x-bind:data-error-for="pointer(r.index, 'mode')" x-text="fieldError(r.index, 'mode')"></span>
								</template>
							</div>
							<template x-if="!r.isEdit">
								<div class="[ flow ]">
									<div class="[ field ]">
										<label x-bind:for="'rule-' + r.index + '-at'">Lifecycle point</label>
										<select x-bind:id="'rule-' + r.index + '-at'" data-field="at" x-bind:aria-invalid="fieldInvalid(r.index, 'at')" x-on:change="set(r.index, 'at', $event.target.value)">
											<option value="" x-bind:selected="!r.rule.at">Choose a lifecycle point</option>
											<template x-for="p in lifecyclePoints" x-bind:key="p.value">
												<option x-bind:value="p.value" x-bind:selected="r.rule.at === p.value" x-text="p.label"></option>
											</template>
										</select>
										<template x-if="fieldError(r.index, 'at')">
											<span class="[ error ]" x-bind:data-error-for="pointer(r.index, 'at')" x-text="fieldError(r.index, 'at')"></span>
										</template>
									</div>
									<div class="[ field ]">
										<label x-bind:for="'rule-' + r.index + '-command'">Command</label>
										<input x-bind:id="'rule-' + r.index + '-command'" data-field="command" class="[ text-sm ]" autocomplete="off" placeholder="go test ./..." x-bind:value="r.rule.command ?? ''" x-bind:aria-invalid="fieldInvalid(r.index, 'command')" x-on:input="set(r.index, 'command', $event.target.value)"/>
										<template x-if="fieldError(r.index, 'command')">
											<span class="[ error ]" x-bind:data-error-for="pointer(r.index, 'command')" x-text="fieldError(r.index, 'command')"></span>
										</template>
									</div>
									<div class="[ field ]">
										<label x-bind:for="'rule-' + r.index + '-paths'">Paths (regex)</label>
										<input x-bind:id="'rule-' + r.index + '-paths'" data-field="paths" class="[ text-sm ]" autocomplete="off" placeholder="^internal/domain/" x-bind:value="r.paths" x-bind:aria-invalid="fieldInvalid(r.index, 'paths')" x-on:input="setText(r.index, 'paths', $event.target.value)"/>
										<template x-if="fieldError(r.index, 'paths')">
											<span class="[ error ]" x-bind:data-error-for="pointer(r.index, 'paths')" x-text="fieldError(r.index, 'paths')"></span>
										</template>
									</div>
									<template x-if="r.atTool">
										<div class="[ field ]">
											<label x-bind:for="'rule-' + r.index + '-tools'">Tools (comma separated)</label>
											<input x-bind:id="'rule-' + r.index + '-tools'" data-field="tools" class="[ text-sm ]" autocomplete="off" placeholder="Edit, Write, MultiEdit" x-bind:value="r.tools" x-bind:aria-invalid="fieldInvalid(r.index, 'tools')" x-on:change="setList(r.index, 'tools', $event.target.value)"/>
											<template x-if="fieldError(r.index, 'tools')">
												<span class="[ error ]" x-bind:data-error-for="pointer(r.index, 'tools')" x-text="fieldError(r.index, 'tools')"></span>
											</template>
										</div>
									</template>
									<div class="[ field ]">
										<label x-bind:for="'rule-' + r.index + '-timeout'">Timeout in seconds (default 30, at most 300)</label>
										<input x-bind:id="'rule-' + r.index + '-timeout'" data-field="timeout_seconds" type="number" min="1" max="300" class="[ text-sm ]" placeholder="30" x-bind:value="r.timeout" x-bind:aria-invalid="fieldInvalid(r.index, 'timeout_seconds')" x-on:change="setTimeout(r.index, $event.target.value)"/>
										<template x-if="fieldError(r.index, 'timeout_seconds')">
											<span class="[ error ]" x-bind:data-error-for="pointer(r.index, 'timeout_seconds')" x-text="fieldError(r.index, 'timeout_seconds')"></span>
										</template>
									</div>
								</div>
							</template>
							<div class="[ field ]">
								<label x-bind:for="'rule-' + r.index + '-agents'">Agents (comma separated; empty is every agent)</label>
								<input x-bind:id="'rule-' + r.index + '-agents'" data-field="agents" class="[ text-sm ]" autocomplete="off" placeholder="go-developer, plain" x-bind:value="r.agents" x-bind:aria-invalid="fieldInvalid(r.index, 'agents')" x-on:change="setList(r.index, 'agents', $event.target.value)"/>
								<template x-if="fieldError(r.index, 'agents')">
									<span class="[ error ]" x-bind:data-error-for="pointer(r.index, 'agents')" x-text="fieldError(r.index, 'agents')"></span>
								</template>
							</div>
							<div class="[ field ]">
								<label x-bind:for="'rule-' + r.index + '-message'">Message the agent sees</label>
								<textarea x-bind:id="'rule-' + r.index + '-message'" data-field="message" rows="2" class="[ text-sm ]" x-bind:value="r.rule.message ?? ''" x-bind:aria-invalid="fieldInvalid(r.index, 'message')" x-on:input="set(r.index, 'message', $event.target.value)"></textarea>
								<template x-if="fieldError(r.index, 'message')">
									<span class="[ error ]" x-bind:data-error-for="pointer(r.index, 'message')" x-text="fieldError(r.index, 'message')"></span>
								</template>
							</div>
							<template x-if="fieldError(r.index, 'kind')">
								<span class="[ error ]" x-bind:data-error-for="pointer(r.index, 'kind')" x-text="fieldError(r.index, 'kind')"></span>
							</template>
							<div class="[ flow ] [ flow-space-3xs ]">
								<span class="[ text-sm weight-medium ]">What the agent sees</span>
								<pre class="[ font-mono text-sm pre-wrap ]" data-preview x-text="r.preview"></pre>
								<p class="[ text-xs color-ink-faint ]" x-text="r.outcome"></p>
							</div>
						</div>
					</div>
				</template>
			</section>
		</template>
		<p class="[ text-xs color-ink-faint ]">Rules also guard writes made through the shell (sed -i, tee, cp, mv, rm), but only as far as the edit proxy catches them: hook coverage of shell writes depends on the edit proxy (ADR 0002).</p>
	</section>
}
