package architecture

// tabOutput is the Output tab's panel. It is its own Alpine component,
// architectureOutputTab, nested in architecturePage: it reads the page's
// saved record, draft and export state through the page's scope. Its two
// views are the architecture file (tabOutputFile, …/architecture/file) and
// the diagram (tabOutputDiagram, …/architecture/diagram).
templ tabOutput() {
	<section role="tabpanel" id="architecture-panel-output" aria-labelledby="architecture-tab-output" x-show="isTab('output')" x-data="architectureOutputTab" class="[ flow ]">
		<nav class="[ segmented ]" aria-label="Output views" data-size="sm">
			<template x-for="v in views" x-bind:key="v.slug">
				<button type="button" x-bind:aria-pressed="v.pressed" x-bind:data-view-button="v.slug" x-on:click="openView(v.slug)" x-text="v.label"></button>
			</template>
		</nav>
		<div class="[ flow ]" data-view="file" x-show="isFile">
			@tabOutputFile()
		</div>
		<template x-if="isDiagram">
			<div class="[ flow ]" data-view="diagram">
				@tabOutputDiagram()
			</div>
		</template>
	</section>
}
