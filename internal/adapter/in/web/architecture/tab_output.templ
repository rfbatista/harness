package architecture

// tabOutput is the Output tab's panel. It is its own Alpine component,
// architectureOutputTab, nested in architecturePage: it reads and edits the
// page's draft and errors through the page's scope.
templ tabOutput() {
	<section role="tabpanel" id="architecture-panel-output" aria-labelledby="architecture-tab-output" x-show="isTab('output')" x-data="architectureOutputTab" class="[ flow ]">
		<h2>Output</h2>
		<p class="[ color-ink-muted ]">The architecture file in the repository, and a diagram of the architecture.</p>
	</section>
}
