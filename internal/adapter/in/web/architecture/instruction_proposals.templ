package architecture

// instructionProposals is the Proposals section of the Instructions & rules
// tab: the instruction files agents proposed (ADR 0092), above the files list.
// It is its own Alpine component, architectureInstructionProposals, nested in
// the tab's scope. Open proposals come first; decided ones stay with their
// decision and note. Each row shows the summary, the skills, the file count and
// when it was proposed, the task and the session that proposed it. A proposal
// opens in a pane beside the list (instructionProposalPane).
templ instructionProposals() {
	<section class="[ flow ] [ instruction-proposals ]" aria-labelledby="proposals-heading" data-proposals-section x-data="architectureInstructionProposals">
		<div class="head">
			<h3 id="proposals-heading">Proposals</h3>
			<template x-if="hasOpen">
				<span class="[ badge ]" data-tone="attention" data-open-count x-text="openText"></span>
			</template>
			<span class="[ text-sm color-ink-muted ]">Skills an agent proposed from its task's instruction draft. Approving saves every file as a new version; new sessions get them.</span>
		</div>
		<p class="[ visually-hidden ]" role="status" aria-live="polite" data-proposals-live x-text="announcement"></p>
		<p class="[ error ]" role="alert" data-proposals-error x-show="hasLoadError"><span aria-hidden="true">✕</span> <span x-text="loadError"></span></p>
		<div class="[ arch-split ]" x-bind:data-pane="paneOpen" x-show="hasList">
			<ul class="[ arch-entries ]" role="list" aria-label="Proposals">
				<template x-for="row in rows" x-bind:key="row.id">
					<li x-bind:data-proposal="row.id" x-bind:data-state="row.state" x-bind:data-viewing="row.viewing">
						<div class="[ entry-row ]">
							<div class="[ entry-main ]">
								<div class="[ entry-title ]">
									<button type="button" class="[ open-file ]" data-open-proposal x-bind:aria-label="row.openLabel" x-bind:aria-expanded="row.viewing" x-on:click="openFromRow(row.id)" x-text="row.summary"></button>
									<span class="[ badge ]" data-state-badge x-bind:data-tone="row.tone" x-text="row.label"></span>
									<template x-for="skill in row.skills" x-bind:key="skill">
										<span class="[ badge ]"><code x-text="skill"></code></span>
									</template>
									<template x-if="row.staleBadge">
										<span class="[ badge ]" data-tone="attention" data-stale-files x-text="row.staleBadge"></span>
									</template>
								</div>
								<p class="[ entry-note ]" data-proposal-meta x-text="row.note"></p>
								<template x-if="row.hasDecisionNote">
									<p class="proposal-note" data-proposal-note><span class="[ entry-label ]">Note</span> <span x-text="row.decisionNote"></span></p>
								</template>
							</div>
							<template x-if="row.task">
								<div class="[ entry-meta ]" data-meta="task"><span class="[ entry-label ]">Task</span> <a x-bind:href="row.taskHref" x-text="row.task.title"></a></div>
							</template>
							<div class="[ entry-meta ]" data-meta="session"><span class="[ entry-label ]">Session</span> <span x-text="row.session"></span></div>
						</div>
					</li>
				</template>
			</ul>
			<div class="[ arch-side ]" x-show="paneOpen">
				@instructionProposalPane()
			</div>
		</div>
		<div class="[ empty ]" data-proposals-empty x-show="isEmpty">
			<h2>No proposal yet</h2>
			<p>An agent in architect mode writes a skill in its task's instruction draft and submits it with <code>propose_instruction_files</code>. It appears here with a diff per file, you get an inbox item, and you approve, reject or send it back in one place. At the Verify step the architect offers to create a verification skill when the repository has none.</p>
		</div>
	</section>
}

// instructionProposalPane is the open proposal: its facts, the notice about
// stale files or the refusal of an approval, the decision, and each file's diff
// in the code view's diff-view. It stands in the proposals component's scope.
templ instructionProposalPane() {
	<p data-proposal-loading role="status" x-show="paneBusy">Reading the proposal…</p>
	<p class="[ error ]" role="alert" data-proposal-error x-show="hasPaneError"><span aria-hidden="true">✕</span> <span x-text="paneError"></span></p>
	<template x-if="hasPane">
		<section class="[ entry-card ] [ instruction-proposal ]" x-bind:aria-label="paneLabel" data-proposal-pane>
			<header>
				<h3 class="[ grow ]" tabindex="-1" data-pane-heading x-init="focusHeading($el)" x-text="paneTitle"></h3>
				<span class="[ badge ]" data-pane-state x-bind:data-tone="paneTone" x-text="paneStateLabel"></span>
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-close-proposal aria-label="Close the proposal" x-on:click="close">✕</button>
			</header>
			<div class="[ content flow ]">
				<template x-if="hasApproved">
					<div class="[ banner ]" data-tone="signal" role="status" data-approved-notice>
						<div class="[ flow ] [ flow-space-3xs grow ]">
							<span><strong>Approved.</strong> <span x-text="approvedNotice"></span></span>
						</div>
					</div>
				</template>
				<div class="[ entry-kv ]">
					<div><span class="[ entry-label ]">Skills</span> <span><template x-for="skill in paneSkills" x-bind:key="skill.name"><span><code x-text="skill.name"></code><span x-text="skill.sep"></span></span></template></span></div>
					<div><span class="[ entry-label ]">Proposed by</span> <span><span x-text="paneSessionOn"></span><template x-if="paneTask"><a x-bind:href="paneTaskHref" x-text="paneTask.title"></a></template></span></div>
					<div><span class="[ entry-label ]">When</span> <span x-text="paneProposed"></span></div>
					<template x-if="paneIsDecided">
						<div><span class="[ entry-label ]">Decided</span> <span x-text="paneDecided"></span></div>
					</template>
				</div>
				<template x-if="hasRefusal">
					<div class="[ banner ]" data-tone="danger" role="alert" data-refusal>
						<div class="[ flow ] [ flow-space-3xs grow ]">
							<span><strong x-text="refusalText"></strong></span>
							<ul class="refused-paths">
								<template x-for="r in refusalPaths" x-bind:key="r.path">
									<li><span x-text="r.path"></span><span class="[ color-ink-muted ]" x-text="r.suffix"></span></li>
								</template>
							</ul>
							<span class="[ code ]">INSTRUCTION_CHANGED · send it back so the session re-reads the files and submits again</span>
						</div>
						<button type="button" class="[ button ]" data-size="sm" data-sendback-from-refusal x-bind:disabled="cannotDecide" x-on:click="askToSendBack">Send back…</button>
					</div>
				</template>
				<template x-if="staleNotice">
					<div class="[ banner ]" data-tone="attention" role="status" data-stale-notice>
						<div class="[ flow ] [ flow-space-3xs grow ]">
							<span><strong x-text="staleNoticeText"></strong> Approving will be refused until the session re-reads <span>them</span>. Send it back so the session rebases its draft.</span>
						</div>
						<button type="button" class="[ button ]" data-size="sm" data-sendback-from-notice x-bind:disabled="cannotDecide" x-on:click="askToSendBack">Send back…</button>
					</div>
				</template>
				<p class="[ error ]" role="alert" data-decide-error x-show="hasDecideError"><span aria-hidden="true">✕</span> <span x-text="decideError"></span></p>
				<template x-if="paneIsOpen">
					<div class="decision" role="group" aria-label="Decide">
						<button type="button" class="[ button ]" data-variant="primary" data-size="sm" data-approve x-bind:disabled="cannotDecide" x-on:click="approve" x-text="approveText"></button>
						<button type="button" class="[ button ]" data-size="sm" data-open-reject aria-controls="proposal-ask" x-bind:aria-expanded="askRejecting" x-bind:disabled="cannotDecide" x-on:click="askToReject">Reject…</button>
						<button type="button" class="[ button ]" data-size="sm" data-open-sendback aria-controls="proposal-ask" x-bind:aria-expanded="asksSendBack" x-bind:disabled="cannotDecide" x-on:click="askToSendBack">Send back…</button>
						<span class="[ grow ]"></span>
						<span class="[ text-xs color-ink-faint ]">One decision for the whole proposal</span>
					</div>
				</template>
				<template x-if="isAsking">
					<form class="[ banner ] [ instruction-ask ]" id="proposal-ask" role="group" data-ask x-bind:data-tone="askView.tone" x-bind:aria-label="askView.aria" x-on:submit.prevent="submitAsk" novalidate>
						<p><strong x-text="askView.title"></strong> <span x-text="askView.body"></span></p>
						<div class="[ field ]">
							<label for="proposal-note">Note <span class="[ color-ink-muted ]" x-text="askView.requirement"></span></label>
							<textarea id="proposal-note" rows="3" x-model="note" x-init="focusNote($el)" x-bind:placeholder="askView.placeholder" x-bind:aria-invalid="hasNoteError" aria-describedby="proposal-note-error"></textarea>
							<span class="[ error ]" id="proposal-note-error" data-ask-error x-show="hasNoteError"><span aria-hidden="true">✕</span> <span x-text="noteError"></span></span>
						</div>
						<div class="[ cluster ]">
							<button type="submit" class="[ button ]" data-size="sm" x-bind:data-variant="askView.variant" x-bind:disabled="cannotSubmit" x-text="askView.button"></button>
							<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-cancel-ask x-on:click="cancelAsk">Cancel</button>
						</div>
					</form>
				</template>
				<div class="files-head">
					<h4 id="proposal-files-heading">Files</h4>
					<span class="[ text-xs color-ink-muted ]" x-text="paneOps"></span>
				</div>
				<div class="[ diff-view ]" data-diff-set aria-labelledby="proposal-files-heading">
					<div class="bar">
						<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-collapse-all x-on:click="toggleAll" x-text="collapseAllLabel"></button>
						<span class="[ text-xs color-ink-faint ]">Base is the file's version the draft read; a create has no base, a remove no proposed text.</span>
					</div>
					<template x-for="f in paneFiles" x-bind:key="f.key">
						<section class="file" x-bind:id="f.id" x-bind:aria-labelledby="f.nameId" x-bind:data-op="f.op" x-bind:data-path="f.path" x-bind:data-stale="f.stale" x-bind:data-collapsed="f.collapsed">
							<header class="head">
								<button type="button" class="toggle" x-bind:aria-expanded="f.expanded" x-bind:aria-controls="f.bodyId" x-bind:aria-label="f.toggleLabel" x-on:click="toggleFile(f.path)">
									<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 6l4.5 4.5L12.5 6"></path></svg>
								</button>
								<span class="change-mark" x-bind:data-change="f.change" x-bind:title="f.op" x-text="f.mark"></span>
								<span class="[ badge ]" data-op-badge x-bind:data-tone="f.opTone" x-text="f.op"></span>
								<h3 class="path" x-bind:id="f.nameId" x-bind:title="f.path" x-text="f.path"></h3>
								<template x-if="f.stale">
									<span class="[ badge ]" data-tone="attention" data-stale x-text="f.staleText"></span>
								</template>
								<template x-if="f.savedText">
									<span class="[ badge ]" data-tone="success" data-saved x-text="f.savedText"></span>
								</template>
								<template x-if="f.againstText">
									<span class="[ text-xs color-ink-faint ]" x-text="f.againstText"></span>
								</template>
								<span class="stat"><span class="added" x-text="f.addedText"></span><span class="deleted" x-text="f.deletedText"></span></span>
							</header>
							<div class="hunks" x-bind:id="f.bodyId">
								<div class="code-lines" data-wrap x-bind:style="f.digitsStyle" x-init="drawFile($el, f.path)"></div>
							</div>
						</section>
					</template>
				</div>
			</div>
		</section>
	</template>
}
