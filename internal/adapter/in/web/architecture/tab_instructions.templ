package architecture

// tabInstructions is the Instructions & rules tab's panel. It is its own Alpine
// component, architectureInstructionsTab, nested in architecturePage: it reads
// and edits the page's draft and errors through the page's scope.
templ tabInstructions() {
	<section role="tabpanel" id="architecture-panel-instructions" aria-labelledby="architecture-tab-instructions" x-show="isTab('instructions')" x-data="architectureInstructionsTab" class="[ flow ]">
		<h2>Instructions &amp; rules</h2>
		<p class="[ color-ink-muted ]">The files agents read: rules, skills and sub-agent prompts, who they apply to and when they load. Only the path is stored, never the prose.</p>
		<template x-for="(row, i) in rows()" x-bind:key="i">
			<section class="[ pane ]" data-entry="instruction">
				<header>
					<span class="[ grow font-mono ]" x-text="row.path || 'New instruction file'"></span>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-label="removeLabel(row)" x-on:click="remove(i)">Remove</button>
				</header>
				<div class="[ content flow ]">
					<div class="[ field ]">
						<label>
							Path
							<input data-field="path" class="[ text-sm font-mono ]" autocomplete="off" placeholder="CLAUDE.md" x-model="row.path" x-bind:aria-invalid="bad(i, 'path')"/>
						</label>
						<template x-if="err(i, 'path')">
							<span class="[ error ]" x-bind:data-error-for="ptr(i, 'path')"><span aria-hidden="true">✕</span> <span x-text="err(i, 'path')"></span></span>
						</template>
					</div>
					<div class="[ cluster ]">
						<div class="[ field ]">
							<label>
								Kind
								<select data-field="kind" class="[ text-sm ]" x-model="row.kind" x-bind:aria-invalid="bad(i, 'kind')">
									<option value="rules">Rules</option>
									<option value="skill">Skill</option>
									<option value="subagent_prompt">Sub-agent prompt</option>
								</select>
							</label>
							<template x-if="err(i, 'kind')">
								<span class="[ error ]" x-bind:data-error-for="ptr(i, 'kind')"><span aria-hidden="true">✕</span> <span x-text="err(i, 'kind')"></span></span>
							</template>
						</div>
						<div class="[ field ]">
							<label>
								Loaded
								<select data-field="loaded" class="[ text-sm ]" x-model="row.loaded" x-bind:aria-invalid="bad(i, 'loaded')">
									<option value="always">Always</option>
									<option value="on_demand">On demand</option>
								</select>
							</label>
							<template x-if="err(i, 'loaded')">
								<span class="[ error ]" x-bind:data-error-for="ptr(i, 'loaded')"><span aria-hidden="true">✕</span> <span x-text="err(i, 'loaded')"></span></span>
							</template>
						</div>
					</div>
					<div class="[ field ]">
						<span class="[ text-sm weight-medium ]">Applies to</span>
						@agentList("applies_to", "Applies to", "bad(i, 'applies_to')")
						<template x-if="err(i, 'applies_to')">
							<span class="[ error ]" x-bind:data-error-for="ptr(i, 'applies_to')"><span aria-hidden="true">✕</span> <span x-text="err(i, 'applies_to')"></span></span>
						</template>
					</div>
					<div class="[ field ]">
						<label>
							Note
							<input data-field="note" class="[ text-sm ]" autocomplete="off" placeholder="One line, optional" x-model="row.note"/>
						</label>
					</div>
				</div>
			</section>
		</template>
		<div>
			<button type="button" class="[ button ]" data-size="sm" x-on:click="add">Add an instruction file</button>
		</div>
	</section>
}
