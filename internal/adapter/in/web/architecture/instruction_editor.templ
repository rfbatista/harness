package architecture

import "operators-mcp/internal/adapter/in/web/components"

// instructionEditor is the pane beside the Instructions list that shows one
// instruction file: a monospace text area, a Markdown preview toggle, Save and
// Discard with a dirty marker, and what went wrong when the file could not be
// opened or saved. A new file asks for its kind and path first (prefilled from
// the kind). It is part of architectureInstructionsTab's scope. The file is the
// harness's own copy (ADR 0057); it is saved on its own against its version and
// never touches the page's save bar. The text area carries the writing helper's
// pen (kind instruction_file): it reads the file's path and kind, from the two
// hidden inputs below, and replaces the text only when the person accepts a draft. A refusal, a feed event and a tab switch
// keep the person's text.
templ instructionEditor(v View) {
	<section class="[ entry-card ] [ instruction-editor ]" data-instruction-editor aria-label="Instruction file" x-show="paneOpen()">
		<header>
			<h3 class="[ grow ]"><code class="[ font-mono ]" data-editor-path x-text="paneTitle"></code></h3>
			<template x-if="hasFile">
				<span class="[ text-xs color-ink-faint ]" data-file-version x-show="!isNewFile" x-text="versionText"></span>
			</template>
			<span class="[ badge ]" data-tone="attention" data-dirty role="status" x-show="fileDirty">Unsaved changes</span>
			<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-editor-close aria-label="Close the file" x-on:click="closeFile">✕</button>
		</header>
		<div class="[ content flow ]">
			<p class="[ text-sm color-ink-muted ]" role="status" data-opening x-show="isOpening">Opening…</p>
			<p class="[ banner ]" data-tone="attention" role="alert" data-not-found x-show="hasNotFound" x-text="notFound"></p>
			<p class="[ banner ]" data-tone="danger" role="alert" data-open-error x-show="hasOpenError" x-text="openError"></p>
			<div class="[ cluster ]" data-new-file x-show="isNewFile">
				<div class="[ field ]">
					<label>
						Kind
						<select data-new-kind class="[ text-sm ]" x-model="newKind" x-on:change="kindChanged">
							<option value="memory">Memory</option>
							<option value="skill">Skill</option>
							<option value="subagent">Sub-agent</option>
						</select>
					</label>
				</div>
				<div class="[ field grow ]">
					<label>
						Path
						<input data-new-path class="[ text-sm font-mono ]" autocomplete="off" spellcheck="false" x-model="newPath" x-bind:aria-invalid="pathInvalid"/>
					</label>
				</div>
			</div>
			<template x-if="hasPathError">
				<p class="[ error ]" data-error-for="path"><span aria-hidden="true">✕</span> <span x-text="pathError"></span></p>
			</template>
			<form class="[ instruction-ask ]" data-rename-form aria-label="Rename the file" x-show="renameShown" x-on:submit.prevent="renameFile">
				<div class="[ field ]">
					<label>
						New path
						<input data-rename-path class="[ text-sm font-mono ]" autocomplete="off" spellcheck="false" x-model="renamePath" x-bind:aria-invalid="pathInvalid"/>
					</label>
				</div>
				<p class="[ text-sm color-ink-muted ]" role="status" data-rename-dirty x-show="fileDirty" x-text="renameDirtyText"></p>
				<div class="[ cluster ]">
					<button type="submit" class="[ button ]" data-variant="primary" data-size="sm" data-confirm-rename x-bind:disabled="cannotChange">Rename</button>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-cancel-rename x-on:click="cancelRename">Cancel</button>
				</div>
			</form>
			<div class="[ banner ] [ instruction-ask ]" data-tone="danger" role="alertdialog" aria-label="Delete the file" data-delete-confirm x-show="deleteAsked">
				<p x-text="deleteText"></p>
				<div class="[ cluster ]">
					<button type="button" class="[ button ]" data-variant="danger" data-size="sm" data-confirm-delete x-bind:disabled="cannotChange" x-on:click="deleteFile">Delete file</button>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-cancel-delete x-on:click="cancelDelete">Cancel</button>
				</div>
			</div>
			<p class="[ banner ]" data-tone="attention" role="status" data-deleted-notice x-show="fileDeleted">This file was deleted elsewhere. Your text is kept here; Save puts the file back.</p>
			<div class="[ banner ] [ instruction-notice ]" data-tone="attention" role="alert" data-newer-notice x-show="newerShown">
				<p x-text="newerText"></p>
				<div class="[ cluster ]">
					<button type="button" class="[ button ]" data-size="sm" data-reload x-on:click="reloadFile">Reload</button>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-show-diff x-bind:disabled="!canShowDiff" x-on:click="toggleChanges" x-text="diffLabel">Show changes</button>
				</div>
			</div>
			<div class="[ instruction-diff ] [ font-mono text-xs ]" data-instruction-diff role="group" aria-label="Your text against the newest version" x-show="diffShown">
				<template x-for="(line, i) in diffLines" x-bind:key="i">
					<div data-diff-line x-bind:data-diff-line="line.type" x-text="line.text"></div>
				</template>
			</div>
			<p class="[ banner ]" data-tone="danger" role="alert" data-save-error x-show="hasSaveError" x-text="saveError"></p>
			<div class="[ md-editor ]" x-show="hasFile">
				<div class="[ md-bar ]" role="group" aria-label="File view">
					<button type="button" data-view="text" aria-pressed="true" x-bind:aria-pressed="textPressed" x-on:click="showText">Write</button>
					<button type="button" data-view="preview" aria-pressed="false" x-bind:aria-pressed="previewPressed" x-on:click="showPreview">Preview</button>
					<span class="[ text-xs color-ink-faint ]">Markdown</span>
				</div>
				<input type="hidden" id="instruction-pen-path" x-bind:value="penPath"/>
				<input type="hidden" id="instruction-pen-kind" x-bind:value="penKind"/>
				<div x-bind:hidden="!textShown">
					@components.WritingPen(components.Pen{
						ID: "pen-instruction-file", Kind: "instruction_file", Noun: "instruction file", Label: "Instruction file",
						ProjectID: v.ProjectID, ProjectName: v.ProjectName,
						Siblings: []components.PenSibling{
							{Label: "Path", Selector: "#instruction-pen-path"},
							{Label: "Kind", Selector: "#instruction-pen-kind"},
						},
						Available: v.Frame.Helper.Available, Reason: v.Frame.Helper.Reason, FixURL: v.Frame.Helper.FixURL,
					}) {
						<textarea data-file-text aria-label="Instruction file text" spellcheck="false" x-model="body" x-bind:aria-invalid="bodyInvalid"></textarea>
					}
				</div>
				<div class="[ prose md-preview ]" data-file-preview x-bind:hidden="!previewShown" x-effect="paintPreview($el)" hidden></div>
			</div>
			<p class="[ error ]" data-error-for="content" x-show="hasBodyError"><span aria-hidden="true">✕</span> <span x-text="bodyError"></span></p>
			<div class="[ cluster ]" x-show="hasFile">
				<button type="button" class="[ button ]" data-variant="primary" data-size="sm" data-save x-bind:disabled="cannotSave" x-on:click="saveFile">Save</button>
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-discard x-bind:disabled="cannotDiscard" x-on:click="discardText">Discard</button>
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-rename x-show="!isNewFile" x-bind:disabled="cannotChange" x-on:click="askRename">Rename</button>
				<button type="button" class="[ button ]" data-variant="danger-outline" data-size="sm" data-delete x-show="!isNewFile" x-bind:disabled="cannotChange" x-on:click="askDelete">Delete</button>
			</div>
		</div>
	</section>
}
