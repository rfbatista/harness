package architecture

// tabOrchestration is the Orchestration tab's panel. It is its own Alpine
// component, architectureOrchestrationTab, nested in architecturePage: it reads
// and edits the page's draft and errors through the page's scope. Model routing
// and hand-offs are tables as in the published design; Edit opens a row's
// editor in place, below it.
templ tabOrchestration() {
	<section role="tabpanel" id="architecture-panel-orchestration" aria-labelledby="architecture-tab-orchestration" x-show="isTab('orchestration')" x-data="architectureOrchestrationTab" class="[ flow ]">
		@panelHead("Orchestration", "Which model each agent runs on, and who hands work to whom. Use plain for a session with no agent.") {
			<button type="button" class="[ button ]" data-variant="primary" data-size="sm" data-add="route" x-on:click="addRoute">Add route</button>
			<button type="button" class="[ button ]" data-size="sm" data-add="handoff" x-on:click="addHandoff">Add hand-off</button>
		}
		<section class="[ entry-card ]" data-card>
			<header>
				<h3 class="[ grow ]">Model routing</h3>
			</header>
			<table class="[ entry-table ]">
				<thead>
					<tr><th>Agent</th><th>Model</th><th>Used for</th><th><span class="[ visually-hidden ]">Actions</span></th></tr>
				</thead>
				<template x-for="(row, i) in routes()" x-bind:key="i">
					<tbody data-entry="route" x-bind:data-open="isRouteOpen(i)">
						<tr data-row>
							<td><span class="[ agent-chip ]" data-agent x-bind:data-slot="slotOf(row.agent)"><i></i><span x-text="row.agent || 'New route'"></span></span></td>
							<td><span class="[ badge ]" data-model x-text="row.model"></span></td>
							<td class="[ color-ink-muted ]" data-note x-text="row.note"></td>
							<td class="[ entry-action ]">@editButton("isRouteOpen(i)", "editRoute(i)")</td>
						</tr>
						<tr data-editor-row x-show="isRouteOpen(i)">
							<td colspan="4">
				<div class="[ content flow ]" data-editor>
					<div class="[ cluster ]">
						<div class="[ field ]">
							<label>
								Agent
								@agentSelect("agent", "routeBad(i, 'agent')")
							</label>
							<template x-if="routeErr(i, 'agent')">
								<span class="[ error ]" x-bind:data-error-for="routePtr(i, 'agent')"><span aria-hidden="true">✕</span> <span x-text="routeErr(i, 'agent')"></span></span>
							</template>
						</div>
						<div class="[ field ]">
							<label>
								Model
								<input data-field="model" class="[ text-sm font-mono ]" autocomplete="off" placeholder="claude-opus-5-5" x-model="row.model" x-bind:aria-invalid="routeBad(i, 'model')"/>
							</label>
							<template x-if="routeErr(i, 'model')">
								<span class="[ error ]" x-bind:data-error-for="routePtr(i, 'model')"><span aria-hidden="true">✕</span> <span x-text="routeErr(i, 'model')"></span></span>
							</template>
						</div>
					</div>
					<div class="[ field ]">
						<label>
							Note
							<input data-field="note" class="[ text-sm ]" autocomplete="off" placeholder="One line, optional" x-model="row.note"/>
						</label>
					</div>
														@entryEditorFoot("closeRoute()", "removeRoute(i)")
									</div>
							</td>
						</tr>
					</tbody>
				</template>
			</table>
		</section>
		<section class="[ entry-card ]" data-card>
			<header>
				<h3 class="[ grow ]">Hand-offs</h3>
			</header>
			<table class="[ entry-table ]">
				<thead>
					<tr><th>From</th><th>To</th><th>When</th><th><span class="[ visually-hidden ]">Actions</span></th></tr>
				</thead>
				<template x-for="(row, i) in handoffRows()" x-bind:key="i">
					<tbody data-entry="handoff" x-bind:data-open="isHandoffOpen(i)">
						<tr data-row>
							<td><span class="[ agent-chip ]" data-agent x-bind:data-slot="slotOf(row.from)"><i></i><span x-text="row.from || '…'"></span></span></td>
							<td><span class="[ agent-chip ]" data-agent x-bind:data-slot="slotOf(row.to)"><i></i><span x-text="row.to || '…'"></span></span></td>
							<td class="[ color-ink-muted ]" data-note x-text="row.when"></td>
							<td class="[ entry-action ]">@editButton("isHandoffOpen(i)", "editHandoff(i)")</td>
						</tr>
						<tr data-editor-row x-show="isHandoffOpen(i)">
							<td colspan="4">
				<div class="[ content flow ]" data-editor>
					<div class="[ cluster ]">
						<div class="[ field ]">
							<label>
								From
								@agentSelect("from", "handoffBad(i, 'from')")
							</label>
							<template x-if="handoffErr(i, 'from')">
								<span class="[ error ]" x-bind:data-error-for="handoffPtr(i, 'from')"><span aria-hidden="true">✕</span> <span x-text="handoffErr(i, 'from')"></span></span>
							</template>
						</div>
						<div class="[ field ]">
							<label>
								To
								@agentSelect("to", "handoffBad(i, 'to')")
							</label>
							<template x-if="handoffErr(i, 'to')">
								<span class="[ error ]" x-bind:data-error-for="handoffPtr(i, 'to')"><span aria-hidden="true">✕</span> <span x-text="handoffErr(i, 'to')"></span></span>
							</template>
						</div>
					</div>
					<div class="[ field ]">
						<label>
							When
							<input data-field="when" class="[ text-sm ]" autocomplete="off" placeholder="A spec for the harness server is approved." x-model="row.when" x-bind:aria-invalid="handoffBad(i, 'when')"/>
						</label>
						<template x-if="handoffErr(i, 'when')">
							<span class="[ error ]" x-bind:data-error-for="handoffPtr(i, 'when')"><span aria-hidden="true">✕</span> <span x-text="handoffErr(i, 'when')"></span></span>
						</template>
					</div>
														@entryEditorFoot("closeHandoff()", "removeHandoff(i)")
									</div>
							</td>
						</tr>
					</tbody>
				</template>
			</table>
		</section>
	</section>
}
