package architecture

// tabTools is the Tools tab's panel. It is its own Alpine component,
// architectureToolsTab, nested in architecturePage: it reads and edits the
// page's draft and errors through the page's scope.
templ tabTools() {
	<section role="tabpanel" id="architecture-panel-tools" aria-labelledby="architecture-tab-tools" x-show="isTab('tools')" x-data="architectureToolsTab" class="[ flow ]">
		<h2>Tools</h2>
		<p class="[ color-ink-muted ]">The functions, MCP servers and APIs agents can call, and when and how to call them. A tool that writes needs usage prose.</p>
		<template x-for="(row, i) in rows()" x-bind:key="i">
			<section class="[ pane ]" data-entry="tool">
				<header>
					<span class="[ grow font-mono ]" x-text="row.name || 'New tool'"></span>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-label="removeLabel(row)" x-on:click="remove(i)">Remove</button>
				</header>
				<div class="[ content flow ]">
					<div class="[ cluster ]">
						<div class="[ field ]">
							<label>
								Name
								<input data-field="name" class="[ text-sm font-mono ]" autocomplete="off" placeholder="codegraph" x-model="row.name" x-bind:aria-invalid="bad(i, 'name')"/>
							</label>
							<template x-if="err(i, 'name')">
								<span class="[ error ]" x-bind:data-error-for="ptr(i, 'name')"><span aria-hidden="true">✕</span> <span x-text="err(i, 'name')"></span></span>
							</template>
						</div>
						<div class="[ field ]">
							<label>
								Kind
								<select data-field="kind" class="[ text-sm ]" x-model="row.kind" x-bind:aria-invalid="bad(i, 'kind')">
									<option value="mcp">MCP server</option>
									<option value="function">Function</option>
									<option value="api">API</option>
									<option value="cli">CLI</option>
								</select>
							</label>
							<template x-if="err(i, 'kind')">
								<span class="[ error ]" x-bind:data-error-for="ptr(i, 'kind')"><span aria-hidden="true">✕</span> <span x-text="err(i, 'kind')"></span></span>
							</template>
						</div>
					</div>
					<div class="[ field ]">
						<label>
							Used by
							<input data-field="used_by" class="[ text-sm ]" autocomplete="off" placeholder="all, or agent names separated by commas" x-bind:value="csv(row, 'used_by')" x-on:change="setCsv(row, 'used_by', $event)" x-bind:aria-invalid="bad(i, 'used_by')"/>
						</label>
						<template x-if="err(i, 'used_by')">
							<span class="[ error ]" x-bind:data-error-for="ptr(i, 'used_by')"><span aria-hidden="true">✕</span> <span x-text="err(i, 'used_by')"></span></span>
						</template>
					</div>
					<div class="[ field ]" data-inline>
						<label><input type="checkbox" data-field="writes" x-model="row.writes"/> Writes: it changes something outside the session</label>
					</div>
					<div class="[ field ]">
						<label>
							Usage
							<textarea data-field="usage" rows="3" class="[ text-sm ]" placeholder="When and how to call it" x-model="row.usage" x-bind:aria-invalid="bad(i, 'usage')"></textarea>
						</label>
						<template x-if="err(i, 'usage')">
							<span class="[ error ]" x-bind:data-error-for="ptr(i, 'usage')"><span aria-hidden="true">✕</span> <span x-text="err(i, 'usage')"></span></span>
						</template>
					</div>
				</div>
			</section>
		</template>
		<div>
			<button type="button" class="[ button ]" data-size="sm" x-on:click="add">Add a tool</button>
		</div>
	</section>
}
