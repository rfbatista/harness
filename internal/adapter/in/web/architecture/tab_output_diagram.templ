package architecture

// tabOutputDiagram is the Output tab's diagram view, as the published
// architecture-diagram design lays it out: a head with Download SVG and Copy
// Mermaid, the draft and problems banners, the drawing, and beside it the Show
// options, the focus card and the Key. The drawing is made in the browser from
// the page's draft. Agents are buttons that focus them. With no layers it is
// the empty state that opens the layers editor. It is the component
// architectureOutputDiagram, which exists only while this view is open.
templ tabOutputDiagram() {
	<div class="[ flow ]" x-data="architectureOutputDiagram">
		<template x-if="ready">
			<div class="[ flow ]">
				<div class="[ arch-head ]" data-diagram-head>
					<div class="[ flow ] [ flow-space-3xs ]">
						<h2>Architecture diagram</h2>
						<p class="[ color-ink-muted text-sm ]">Generated from the architecture. It cannot drift: change the record and the diagram changes. Click an agent to see what it can change, read and call.</p>
					</div>
					<div class="[ cluster ]">
						<button type="button" class="[ button ]" data-size="sm" data-download-svg x-on:click="downloadSvg">Download SVG</button>
						<button type="button" class="[ button ]" data-size="sm" data-copy-mermaid x-on:click="copyMermaid">Copy Mermaid</button>
					</div>
				</div>
				<p class="[ text-sm color-ink-muted ]" role="status" data-diagram-notice x-show="notice" x-text="notice"></p>
				<template x-if="isDraft">
					<div class="[ banner ]" data-tone="attention" role="status" data-draft-banner>
						<span aria-hidden="true" class="[ weight-bold ]">!</span>
						<div><b>Showing an unsaved draft.</b> The saved diagram, and every agent session, still uses the last saved version.</div>
					</div>
				</template>
				<template x-if="hasProblems">
					<div class="[ banner ]" data-tone="danger" role="status" data-problems-banner>
						<span aria-hidden="true" class="[ weight-bold ]">!</span>
						<div><b x-text="problemsTitle"></b> <span x-text="problemsText"></span></div>
					</div>
				</template>
				<template x-if="isEmpty">
					<div class="[ arch-empty ]" data-diagram-empty>
						<h3>Nothing to draw yet</h3>
						<p>The diagram needs at least one layer and one agent with access. Define layers first.</p>
						<button type="button" class="[ button ]" data-variant="primary" data-open-layers x-on:click="openLayers">Open layers editor</button>
					</div>
				</template>
				<template x-if="!isEmpty">
					<div class="[ diagram-work ]">
						<div class="[ diagram-canvas ]" role="region" aria-label="Architecture diagram, scrolls sideways when narrow" tabindex="0" data-diagram-scroll>
							<div data-diagram-picture x-effect="paint" x-on:click="pickFromPicture" x-on:keydown="pickFromKey"></div>
						</div>
						<aside>
							<section class="[ dg-card ]" data-diagram-show>
								<header><h3>Show</h3></header>
								<div class="[ dg-body dg-options ]">
									<label><input type="checkbox" data-show="guards" x-model="showGuards"/><span>Hooks as guards<small>Blocking ✕ and warning ! on the write edges</small></span></label>
									<label><input type="checkbox" data-show="sandboxes" x-model="showSandboxes"/><span>Sandbox regions<small>Dashed = inside the OS sandbox</small></span></label>
									<label><input type="checkbox" data-show="handoffs" x-model="showHandoffs"/><span>Hand-offs<small>Orchestration arrows between agents</small></span></label>
								</div>
							</section>
							<section class="[ dg-card ]" data-focus-card>
								<header><h3 data-focus-name data-focus-title x-text="focusTitle"></h3></header>
								<div class="[ dg-body ]">
									<div class="[ cluster ]" role="group" aria-label="Focus an agent">
										<template x-for="a in agentButtons" x-bind:key="a.name">
											<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-focus-agent x-bind:data-agent-name="a.name" x-bind:aria-pressed="a.pressed" x-on:click="pick(a.name)" x-text="a.name"></button>
										</template>
									</div>
									<template x-if="!hasFocus">
										<div class="[ flow ] [ flow-space-xs text-sm color-ink-muted ]" data-focus-none>
											<p>Showing only <b>change</b> edges to keep the picture legible. Read access is the default for everyone (no edge drawn).</p>
											<p>Click an agent to see its read edges, the guards on the layers it cannot change, and its tools.</p>
										</div>
									</template>
									<template x-if="hasFocus">
										<div class="[ flow ]" aria-label="Focused agent" data-focus-panel>
											<dl class="[ flow ] [ flow-space-2xs text-sm ]">
												<div><dt class="[ weight-medium ]">Can change</dt><dd data-focus-change x-text="focusChange"></dd></div>
												<div><dt class="[ weight-medium ]">Can read only</dt><dd data-focus-read x-text="focusRead"></dd></div>
												<div><dt class="[ weight-medium ]">Warnings behind a blocking guard</dt><dd data-focus-warnings x-text="focusWarnings"></dd></div>
												<div><dt class="[ weight-medium ]">Tools</dt><dd data-focus-tools x-text="focusTools"></dd></div>
												<div><dt class="[ weight-medium ]">Hand-offs</dt><dd data-focus-handoffs x-text="focusHandoffs"></dd></div>
												<div><dt class="[ weight-medium ]">Instructions</dt><dd data-focus-instructions x-text="focusInstructions"></dd></div>
											</dl>
											<div><button type="button" class="[ button ]" data-size="sm" data-clear-focus x-on:click="clearFocus">Clear focus</button></div>
										</div>
									</template>
								</div>
							</section>
							<section class="[ dg-card ]">
								<header><h3>Key</h3></header>
								<div class="[ dg-body ]">
									<ul class="[ dg-key ]" aria-label="How to read the diagram" data-diagram-key>
										<li><svg width="26" height="8" aria-hidden="true"><line x1="0" y1="4" x2="26" y2="4" class="[ dg-edge-change ]" stroke-width="2.4"></line></svg> may change (and read)</li>
										<li><svg width="26" height="8" aria-hidden="true"><line x1="0" y1="4" x2="26" y2="4" class="[ dg-edge-read ]" stroke-width="1.5" stroke-dasharray="6 4"></line></svg> may read only</li>
										<li><svg width="22" height="18" aria-hidden="true"><circle cx="11" cy="9" r="7" class="[ dg-guard-block ]" stroke-width="2"></circle></svg> blocking hook guards the write</li>
										<li><svg width="22" height="18" aria-hidden="true"><circle cx="11" cy="9" r="7" class="[ dg-guard-warn ]" stroke-width="2.2"></circle></svg> warning-only hook</li>
										<li><svg width="26" height="18" aria-hidden="true"><rect x="1" y="2" width="24" height="14" rx="4" class="[ dg-region ]" stroke-width="1.5" stroke-dasharray="6 4"></rect></svg> sandbox (what runs inside)</li>
									</ul>
								</div>
							</section>
						</aside>
					</div>
				</template>
			</div>
		</template>
	</div>
}
