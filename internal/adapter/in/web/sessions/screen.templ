package sessions

import "operators-mcp/internal/adapter/in/web/pullrequests"

// The session screen (direction A): a fixed head, the tab row with the open
// terminal's tools at its end, then the pane. The markup is the design
// system's (design-system/session-screen.js builds every state of it). Nested
// components (menus, dialogs, terminals) only dispatch events; the page
// handles them on <main>, so page methods always run on the page.

var icons = map[string]string{
	"more":      `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><circle cx="3.5" cy="8" r="1.3"/><circle cx="8" cy="8" r="1.3"/><circle cx="12.5" cy="8" r="1.3"/></svg>`,
	"jump":      `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2.5v8M4.5 7 8 10.5 11.5 7M3.5 13.5h9"/></svg>`,
	"text":      `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1.5 12.5 5 3.5l3.5 9M2.8 9.5h4.4M10 12.5l2.25-5.5 2.25 5.5M10.7 11h3.1"/></svg>`,
	"focus":     `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6V2.5H6M10 2.5h3.5V6M13.5 10v3.5H10M6 13.5H2.5V10"/></svg>`,
	"unfocus":   `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2.5V6H2.5M13.5 6H10V2.5M10 13.5V10h3.5M2.5 10H6v3.5"/></svg>`,
	"back":      `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3 5 8l5 5"/></svg>`,
	"copy":      `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5"/><path d="M10.5 3.5v-.5a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h.5"/></svg>`,
	"trash":     `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 4.5h11M6.5 4.5V3h3v1.5M4 4.5l.7 8.6a1 1 0 0 0 1 .9h4.6a1 1 0 0 0 1-.9l.7-8.6"/></svg>`,
	"branch":    `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="4.5" cy="3.5" r="1.5"/><circle cx="4.5" cy="12.5" r="1.5"/><circle cx="11.5" cy="5.5" r="1.5"/><path d="M4.5 5v6M11.5 7c0 3-7 2-7 4"/></svg>`,
	"stop":      `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><rect x="4" y="4" width="8" height="8" rx="1.5"/></svg>`,
	"reconnect": `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 8a5 5 0 1 1-1.5-3.5M13 2.5v3h-3"/></svg>`,
}

templ icon(name string) {
	@templ.Raw(icons[name])
}

// sessionHead is one fixed-height row (two short lines on a phone): back,
// title, state · agent · age, then the actions. Nothing in it grows: the
// checks panel, the ⋯ menu, the Delete confirm and the phone sheet open in the
// top layer. The capture listeners give ⋯ to the sheet on a phone. usage adds
// the selected session's token totals (usageTotalsChip) after agent · age.
templ sessionHead(usage bool) {
	<header class="[ session-head ]" x-on:click.capture="moreCapture($event)" x-on:keydown.capture="moreCapture($event)">
		<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-icon data-split-back aria-label="Sessions" x-on:click="closeDetail">
			@icon("back")
		</button>
		<h2 x-text="selected.title"></h2>
		<p class="[ meta ]">
			<span class="[ status ]" x-bind:data-state="selected.state" x-text="selected.word"></span>
			<span class="[ who ]" x-text="who"></span>
			if usage {
				<span class="[ usage-total ]" x-data="usageTotalsChip" x-show="hasSession(selected.id)" x-text="sessionText(selected.id)" x-bind:title="sessionTitle(selected.id)"></span>
			}
			<template x-if="selected.tokenSavers">
				<span class="[ token-savers ]" title="Token savers this session runs with" x-text="selected.tokenSavers"></span>
			</template>
			<template x-if="selected.tokenSaversMissing">
				<span class="[ badge ]" data-tone="attention" data-token-savers-missing x-bind:title="selected.tokenSaversMissingTitle" x-text="selected.tokenSaversMissing"></span>
			</template>
			<template x-if="selected.commitCheckOff">
				<span class="[ badge ]" data-tone="attention" data-commit-check-off x-bind:title="selected.commitCheckOff">Commit check off</span>
			</template>
			<template x-if="selected.sandboxChip">
				<span class="[ sandbox-chips ]" data-sandbox-chips>
					<button type="button" class="[ badge ]" data-sandbox title="Open the Sandbox tab" x-bind:data-tone="selected.sandboxTone" x-text="selected.sandboxChip" x-on:click="showSandbox"></button>
					<button type="button" class="[ badge ]" data-sandbox-visibility title="Open the Sandbox tab" x-bind:data-tone="selected.sandboxTone" x-text="selected.visibilityChip" x-on:click="showSandbox"></button>
				</span>
			</template>
			<template x-for="bar in statusCheckBars" x-bind:key="bar.key">
				<span class="[ checks ]" x-text="bar.meta"></span>
			</template>
		</p>
		<div class="[ actions ]">
			<template x-for="ws in selectedWorkspaces" x-bind:key="ws">
				@pullrequests.Badge("ws")
			</template>
			<template x-for="bar in statusCheckBars" x-bind:key="bar.key">
				@checksControl()
			</template>
			<template x-if="historyHref">
				<a class="[ button ]" data-variant="ghost" data-size="sm" data-wide x-bind:href="historyHref">Git history</a>
			</template>
			<template x-if="selected.stoppable">
				<button type="button" class="[ button ]" data-size="sm" x-bind:disabled="cannotStop" x-bind:aria-busy="stopping" x-on:click="stopSelected">Stop</button>
			</template>
			<div class="[ menu ]" x-data="menu" data-align="end">
				<button type="button" class="[ button ]" id="session-more" data-variant="ghost" data-size="sm" data-icon aria-label="More session actions">
					@icon("more")
				</button>
				<div class="[ popup ]" role="menu" popover="manual">
					<template x-if="historyHref">
						<a role="menuitem" data-narrow x-bind:href="historyHref">
							@icon("branch")
							Git history
						</a>
					</template>
					<button type="button" role="menuitem" data-action="copy-id">
						@icon("copy")
						Copy session id <span class="[ meta ]" x-text="shortId"></span>
					</button>
					<hr role="separator"/>
					<button type="button" role="menuitem" data-action="ask-delete" data-tone="danger">
						@icon("trash")
						Delete session…
					</button>
				</div>
			</div>
		</div>
		@deleteConfirm()
		@sessionSheet()
	</header>
}

// checksControl is a delegate's status-check loop in the head: a button with
// the interval the select shows, and the panel it opens.
templ checksControl() {
	<div style="display: contents" x-data="sessionsStatusCheck(bar)">
		<template x-if="controllable">
			<button type="button" class="[ button check-button ]" data-variant="ghost" data-size="sm" aria-haspopup="dialog" aria-expanded="false" x-ref="button" x-bind:aria-label="buttonLabel" x-bind:aria-busy="busy" x-on:click="openPanel()">
				<span class="[ status ]" x-bind:data-state="buttonDot" x-text="'Checks · ' + every"></span><span class="[ next ]" x-text="buttonNext"></span><span class="[ chevron ]"></span>
			</button>
		</template>
		<div class="[ popup ]" role="dialog" id="session-checks" popover="manual" aria-labelledby="session-checks-title" x-data="popupDialog" x-on:dialog-open.window="openFrom($event)">
			<div class="[ check-panel ]">
				<h3 id="session-checks-title">Status checks</h3>
				<p class="[ state ]"><span class="[ status ]" x-bind:data-state="panelDot" x-text="panelWord"></span><span x-text="nextWords"></span><span x-text="'· ' + lastWords"></span></p>
				<div class="[ field-row ]">
					<label for="session-checks-every">Check every</label>
					<select id="session-checks-every" data-size="sm" data-fit x-model="minutes" x-bind:disabled="busy" x-bind:aria-busy="busy" x-on:change="retune()">
						<template x-for="i in intervals" x-bind:key="i.value">
							<option x-bind:value="i.value" x-text="i.label"></option>
						</template>
					</select>
				</div>
				<p class="[ hint ]">The task's architect is woken on this timer to check on this session.</p>
			</div>
			<template x-if="error">
				<div class="[ message ]" data-tone="danger" role="alert">
					<span x-text="error.message"></span>
					<button type="button" class="[ button ]" data-size="sm" data-variant="ghost" x-on:click="retry()">Retry</button>
				</div>
			</template>
			<footer>
				<span x-text="'Last check: ' + lastWords"></span>
				<button type="button" class="[ button ]" data-size="sm" x-bind:disabled="busy" x-on:click="toggle()" x-text="toggleWord"></button>
			</footer>
		</div>
	</div>
}

// deleteConfirm asks before a session goes; anchored to ⋯, a sheet on a phone.
templ deleteConfirm() {
	<div class="[ popup ]" role="alertdialog" id="session-delete" popover="manual" data-trap aria-labelledby="session-delete-title" aria-describedby="session-delete-text" x-data="popupDialog" x-on:dialog-open.window="openFrom($event)">
		<div class="[ confirm-panel ]">
			<h3 id="session-delete-title">Delete this session?</h3>
			<p id="session-delete-text" x-text="deleteConsequence"></p>
		</div>
		<footer>
			<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-initial-focus x-on:click="close()">Keep it</button>
			<button type="button" class="[ button ]" data-variant="danger" data-size="sm" x-bind:aria-busy="deleting" x-on:click="act('delete')">Delete session</button>
		</footer>
	</div>
}

// sessionSheet is every action of the head, on a phone: ⋯ opens it there.
templ sessionSheet() {
	<div class="[ popup ]" role="dialog" id="session-sheet" popover="manual" aria-labelledby="session-sheet-title" x-data="popupDialog" x-on:dialog-open.window="openFrom($event)">
		<header>
			<span id="session-sheet-title" x-text="selected.title"></span>
			<button type="button" class="[ button ]" data-variant="ghost" x-on:click="close()">Close</button>
		</header>
		<template x-for="bar in statusCheckBars" x-bind:key="bar.key">
			<div style="display: contents" x-data="sessionsStatusCheck(bar)">
				<template x-if="controllable">
					<div style="display: contents">
						<div class="[ sheet-checks ]">
							<span class="[ status ]" x-bind:data-state="buttonDot" x-text="'Checks · ' + buttonNext"></span>
							<label class="[ visually-hidden ]" for="session-sheet-every">Check every</label>
							<select id="session-sheet-every" data-fit x-model="minutes" x-bind:disabled="busy" x-on:change="retune()">
								<template x-for="i in intervals" x-bind:key="i.value">
									<option x-bind:value="i.value" x-text="i.label"></option>
								</template>
							</select>
						</div>
						<div class="[ menu ]" role="menu" style="display: block">
							<button type="button" role="menuitem" x-bind:disabled="busy" x-on:click="toggle()" x-text="toggleWord"></button>
							<hr role="separator"/>
						</div>
					</div>
				</template>
			</div>
		</template>
		<div class="[ menu ]" role="menu" style="display: block">
			<template x-if="historyHref">
				<a role="menuitem" x-bind:href="historyHref">
					@icon("branch")
					Git history
				</a>
			</template>
			<button type="button" role="menuitem" x-on:click="act('text-size')">
				@icon("text")
				Text size <span class="[ meta ]" x-text="textSizeLabel"></span>
			</button>
			<button type="button" role="menuitem" x-on:click="act('copy-id')">
				@icon("copy")
				Copy session id
			</button>
			<template x-if="selected.stoppable">
				<button type="button" role="menuitem" x-bind:disabled="cannotStop" x-on:click="act('stop')">
					@icon("stop")
					Stop session
				</button>
			</template>
			<hr role="separator"/>
			<button type="button" role="menuitem" data-tone="danger" x-on:click="act('ask-delete')">
				@icon("trash")
				Delete session…
			</button>
		</div>
	</div>
}

// paneTabs is the tab row: in focus mode its lead names the session; the
// open terminal's tools sit at its end (contract L7).
templ paneTabs() {
	<div class="[ pane-tabs ]" x-bind:data-focus="focusActive ? '' : null">
		<template x-if="focusActive">
			<span class="[ lead ]"><span class="[ status ]" x-bind:data-state="selected.state" data-dot-only x-bind:aria-label="selected.word"></span><span x-text="selected.title"></span></span>
		</template>
		<div class="[ tabs ]" role="tablist" aria-label="Session views">
			<button type="button" role="tab" x-bind:aria-selected="agentTabSelected" x-on:click="showAgent">
				Agent
				<template x-if="attention">
					<span class="[ status ]" data-state="waiting" data-dot-only aria-label="waiting on you"></span>
				</template>
			</button>
			<button type="button" role="tab" x-bind:aria-selected="historyTabSelected" x-on:click="showHistory">History</button>
			<button type="button" role="tab" x-bind:aria-selected="appTabSelected" x-on:click="showApp">App</button>
			<template x-if="hasTask">
				<button type="button" role="tab" x-bind:aria-selected="designTabSelected" x-on:click="showDesign">
					Design
					<template x-if="designBadge">
						<span class="[ badge ]" data-tone="signal" x-text="designBadge"></span>
					</template>
				</button>
			</template>
			<template x-if="hasCode">
				<button type="button" role="tab" x-bind:aria-selected="codeTabSelected" x-on:click="showCode">
					Code
					<template x-if="codeBadge">
						<span class="[ badge ]" x-text="codeBadge"></span>
					</template>
				</button>
			</template>
			@conversationTab()
			<template x-if="hasMergeTab">
				<button type="button" role="tab" x-bind:aria-selected="mergeTabSelected" x-on:click="showMerge">Merge</button>
			</template>
			<button type="button" role="tab" data-quiet x-bind:aria-selected="sandboxTabSelected" x-on:click="showSandbox">Sandbox</button>
		</div>
		<template x-if="paneTools">
			@paneTools()
		</template>
	</div>
}

// paneTools are the open terminal's: the connection (a quiet dot while live,
// a word and Reconnect while down), Jump to latest while scrolled up, text
// size and focus mode. None of them focuses the terminal but Reconnect (F2).
templ paneTools() {
	<div class="[ tools ]" role="group" x-bind:aria-label="paneTools.groupLabel">
		<template x-if="paneTools.down">
			<span class="[ status ]" x-bind:data-state="paneTools.statusState" role="status"><span class="[ word ]" x-text="paneTools.word"></span></span>
		</template>
		<template x-if="paneTools.down">
			<button type="button" class="[ button ]" data-size="sm" x-bind:disabled="paneTools.reconnectDisabled" x-bind:aria-busy="paneTools.reconnectBusy" x-on:click="requestReconnect()">
				@icon("reconnect")
				<span class="[ word ]">Reconnect</span>
			</button>
		</template>
		<template x-if="!paneTools.down">
			<span class="[ status ]" data-dot-only role="status" x-bind:data-state="paneTools.dotState" x-bind:aria-label="paneTools.dotLabel" x-bind:title="paneTools.dotLabel"></span>
		</template>
		<template x-if="paneTools.jump">
			<button type="button" class="[ button jump ]" data-size="sm" x-bind:aria-label="paneTools.jumpLabel" x-on:click="requestJump()">
				@icon("jump")
				<template x-if="paneTools.jumpCount">
					<span x-text="paneTools.jumpCount"></span>
				</template>
				<span class="[ word ]" x-text="paneTools.jumpCount ? 'new lines' : 'latest'"></span>
			</button>
		</template>
		<template x-if="!paneTools.down">
			<span class="[ sep ]"></span>
		</template>
		<template x-if="!paneTools.down">
			<div class="[ menu pref ]" x-data="menu" data-align="end">
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-icon aria-label="Text size" title="Text size">
					@icon("text")
				</button>
				<div class="[ popup ]" role="menu" popover="manual">
					<div class="[ group ]">Text size</div>
					<template x-for="size in textSizes" x-bind:key="size.value">
						<button type="button" role="menuitemradio" data-action="text-size" x-bind:data-value="size.value" x-bind:aria-checked="size.checked ? 'true' : 'false'"><span x-text="size.label"></span><span class="[ meta ]" x-text="size.px + 'px'"></span></button>
					</template>
				</div>
			</div>
		</template>
		<template x-if="!paneTools.down">
			<button type="button" class="[ button pref ]" data-variant="ghost" data-size="sm" x-bind:class="focusActive ? 'exit-focus' : ''" x-bind:data-icon="focusActive ? null : ''" x-bind:aria-pressed="focusActive ? 'true' : 'false'" x-bind:aria-label="focusActive ? null : 'Focus mode'" x-bind:title="focusActive ? null : 'Focus mode'" x-on:click="toggleFocus()">
				<span x-show="!focusActive">
					@icon("focus")
				</span>
				<span x-show="focusActive">
					@icon("unfocus")
				</span>
				<span class="[ word ]" x-show="focusActive">Exit focus</span>
			</button>
		</template>
	</div>
}

// paneNote is the strip at the top of the Agent pane when there is no live
// terminal: why, and Resume when the server would take it.
templ paneNote() {
	<div class="[ pane-note ]" role="status" x-bind:data-tone="paneNote.failed ? 'danger' : null">
		<span class="[ text ]" x-text="paneNote.text"></span>
		<template x-if="paneNote.resumable">
			<button type="button" class="[ button ]" data-variant="primary" data-size="sm" x-bind:disabled="cannotResume" x-bind:aria-busy="resumingSelected" x-on:click="resume()">Resume session</button>
		</template>
	</div>
}
