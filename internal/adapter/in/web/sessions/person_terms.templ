package sessions

// The person's terminals: a dock under the Files viewer (design-system
// css/blocks/person-terms.css, web/src .../components/personTerms.js). The Files
// tab hosts it, in the viewer's column, once per session (sid is the Alpine
// expression naming the session's id, ended the one saying it is over); its
// tree opens a terminal with the window event person-terminal-open-requested.

var personIcons = map[string]string{
	"term":  `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 3.5h11v9h-11zM5 6.5l2 1.75L5 10M8.5 10h2.5"/></svg>`,
	"lock":  `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 7.25h7v5.5h-7zM6 7.25V5.5a2 2 0 014 0v1.75"/></svg>`,
	"close": `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7"/></svg>`,
	"warn":  `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2.5l6 10.5H2zM8 6.5v3M8 11.25v.01"/></svg>`,
	"max":   `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 6V3.5H6M10 3.5h2.5V6M12.5 10v2.5H10M6 12.5H3.5V10"/></svg>`,
	"min":   `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3.5V6H3.5M12.5 6H10V3.5M10 12.5V10h2.5M3.5 10H6v2.5"/></svg>`,
	"reconnect": `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 8a5 5 0 1 1-1.5-3.5M13 2.5v3h-3"/></svg>`,
}

templ personIcon(name string) {
	@templ.Raw(personIcons[name])
}

// PersonTerms is the dock. It shows only while there is a terminal or a
// refusal to show.
templ PersonTerms(sid, ended string) {
	<section
		class="[ person-terms ]"
		aria-label="Your terminals"
		x-data={ "sessionsPersonTerms(" + sid + ")" }
		x-effect={ "setSessionEnded(" + ended + ")" }
		x-show="visible"
		x-bind:style="dockStyle"
		x-bind:data-expanded="expanded ? '' : null"
		x-on:person-terminal-open-requested.window="openRequested"
		x-on:keydown.escape.window="escape"
		x-on:terminal-status.stop="terminalStatus"
		data-person-terms
	>
		<div
			class="[ separator ]"
			role="separator"
			aria-orientation="horizontal"
			aria-label="Resize terminals"
			aria-valuemin="0"
			aria-valuemax="100"
			tabindex="0"
			x-bind:aria-valuenow="handleValue"
			x-bind:data-dragging="dragging ? '' : null"
			x-on:pointerdown="dragStart"
			x-on:pointermove="dragMove"
			x-on:pointerup="dragEnd"
			x-on:pointercancel="dragEnd"
			x-on:keydown="handleKey"
		></div>
		<template x-if="refusal">
			<div class="[ term-refused ]" role="alert" x-bind:data-code="refusal.code">
				<span class="[ mark ]">@personIcon("warn")</span>
				<div class="[ flow ] [ flow-space-3xs ]">
					<strong x-text="refusal.title"></strong>
					<p x-text="refusal.detail"></p>
					<code x-text="refusal.code"></code>
				</div>
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-icon aria-label="Dismiss" x-on:click="dismissRefusal">@personIcon("close")</button>
			</div>
		</template>
		<header class="[ term-tabs ]">
			<div class="[ term-list ]" role="tablist" aria-label="Your terminals" x-on:keydown="tabKey">
				<template x-for="tab in tabs" x-bind:key="tab.id">
					<span class="[ term-tab ]" x-bind:data-current="tab.currentAttr" x-bind:data-ended="tab.endedAttr">
						<button type="button" role="tab" x-bind:aria-selected="tab.selected" x-bind:tabindex="tab.tabindex" x-bind:title="tab.title" x-on:click="select(tab.id)">
							<template x-if="tab.locked">@personIcon("lock")</template>
							<template x-if="!tab.locked">@personIcon("term")</template>
							<span class="[ where ]" x-text="tab.where"></span>
							<span class="[ label ]" x-text="tab.label"></span>
							<template x-if="tab.note">
								<span class="[ status ]" data-state="done" data-dot-only aria-label="ended"></span>
							</template>
						</button>
						<button type="button" class="[ button close ]" data-variant="ghost" data-size="sm" data-icon x-bind:aria-label="tab.closeLabel" x-on:click="close(tab.id)">@personIcon("close")</button>
					</span>
				</template>
			</div>
			<div class="[ tools ]" role="group" aria-label="Terminal tools">
				<template x-if="down">
					<button type="button" class="[ button ]" data-size="sm" x-on:click="reconnect">
						@personIcon("reconnect")
						<span class="[ word ]">Reconnect</span>
					</button>
				</template>
				<span class="[ count ]" x-text="count" aria-label="Terminals running"></span>
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-icon x-bind:aria-label="expandLabel" x-bind:title="expandLabel" x-bind:aria-pressed="expanded ? 'true' : 'false'" x-on:click="toggleExpanded">
					<span x-show="!expanded">@personIcon("max")</span>
					<span x-show="expanded">@personIcon("min")</span>
				</button>
			</div>
		</header>
		<template x-for="tab in tabs" x-bind:key="tab.id">
			<div
				class="[ terminal ]"
				x-show="tab.isCurrent"
				x-data="sessionsPersonTerminal(tab.id)"
				x-bind:data-state="state"
				x-on:terminal-focus-requested.window="focus"
				x-on:terminal-reconnect-requested.window="reconnectRequested"
				x-on:terminal-jump-requested.window="jumpRequested"
				x-on:terminal-text-size.window="textSizeRequested"
			>
				<template x-if="tab.readonlyNote">
					<div class="[ pane-note ]" role="status">
						<span class="[ text ]"><strong>Read-only.</strong> The resources folder is read-only here, so nothing you write reaches the agent. Reading and grep work.</span>
					</div>
				</template>
				<template x-if="tab.note">
					<div class="[ pane-note ]" role="status" x-bind:data-tone="tab.toneAttr">
						<span class="[ text ]"><strong x-text="tab.note.strong"></strong> <span x-text="tab.note.rest"></span></span>
						<template x-if="tab.reopen">
							<button type="button" class="[ button ]" data-variant="primary" data-size="sm" x-on:click="reopen(tab.id)">Open a new one here</button>
						</template>
					</div>
				</template>
				<div class="[ screen ]" x-ref="screen" x-on:click="focus"></div>
				<template x-if="state === 'connecting'">
					<p class="[ notice ]" role="status"><span class="[ skeleton ]"></span>Connecting to the terminal…</p>
				</template>
			</div>
		</template>
	</section>
}
