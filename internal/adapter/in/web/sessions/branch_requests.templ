package sessions

import (
	"strconv"

	"operators-mcp/internal/adapter/in/web/components"
)

// branchRequestsButton is the title row's Branch requests button, after
// Reviews, and the popover it opens (task-branch-requests, the page's
// popupDialog): every branch action an agent of this task waits to make, as a
// card tagged "Branch" with Approve, Deny and a note (ADR 0069). The server
// paints how many wait until the browser has read them; a task with none
// paints the button hidden and it appears once an agent asks. The
// announcements go to the page's live region (the announce event).
templ branchRequestsButton(v PageView) {
	if v.BranchRequests != nil {
		@templ.JSONScript("branch-requests-seed", v.BranchRequests)
		<span
			style="display: contents"
			x-data="branchRequests"
			data-seed="branch-requests-seed"
			data-ticket-id={ v.BranchRequests.TicketID }
			data-pending={ strconv.Itoa(v.PendingBranchRequests) }
		>
			<button
				type="button"
				class="[ button ]"
				id="task-branch-requests-button"
				data-variant="ghost"
				data-size="sm"
				aria-haspopup="dialog"
				aria-expanded="false"
				aria-controls="task-branch-requests"
				x-show="buttonShown"
				x-on:click="openPopover"
				x-bind:aria-label="buttonName"
				{ branchRequestsButtonAttrs(v.PendingBranchRequests)... }
			>
				Branch requests <span class="[ badge ]" data-tone="attention" x-text="buttonCount">{ strconv.Itoa(v.PendingBranchRequests) }</span>
			</button>
			<div
				class="[ popup ] [ context-popover ]"
				role="dialog"
				id="task-branch-requests"
				popover="manual"
				data-align="auto"
				data-kind="branch-requests"
				aria-labelledby="task-branch-requests-title"
				x-data="popupDialog"
				x-on:dialog-open.window="openFrom($event)"
				x-on:dialog-dismiss.window="dismissFrom($event)"
				x-on:dialog-close.window="popoverClosed($event)"
			>
				<div class="[ pop-head ]">
					<h3 id="task-branch-requests-title">Branch requests waiting on you</h3>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-initial-focus x-on:click="close()">Close</button>
				</div>
				<div class="[ pop-body ] [ reviews ]" data-attention tabindex="0" aria-labelledby="task-branch-requests-title">
					<template x-if="error">
						<div class="[ banner ]" data-tone="danger" role="alert">
							<div class="[ flow ] [ flow-space-3xs grow ]">
								<span x-text="error.message"></span>
								<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
							</div>
							<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
						</div>
					</template>
					<h4 class="[ visually-hidden ]" tabindex="-1" data-branch-requests-heading x-text="headline"></h4>
					<template x-for="card in pendingCards" x-bind:key="card.id">
						@components.BranchRequestCard()
					</template>
				</div>
			</div>
		</span>
	}
}
