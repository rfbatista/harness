package sessions

import (
	"strconv"

	"operators-mcp/internal/adapter/in/web/components"
)

// conversationTab opens the selected session's Conversation: shown on the
// task's architect and its delegates only. Its badge counts messages that
// arrived while another tab was in front.
templ conversationTab() {
	<template x-if="hasConversation">
		<button type="button" role="tab" x-bind:aria-selected="conversationTabSelected" x-on:click="showConversation">
			Conversation
			<template x-if="conversationBadge">
				<span class="[ badge ]" data-tone="signal" x-text="conversationBadge"></span>
			</template>
		</button>
	</template>
}

// conversationPanel is the task messages between the architect and its
// delegates (sessionsConversation), oldest first. Every field is an agent's
// text and is bound with x-text; links to artifacts open their sandboxed view
// in a new tab, as the Design tab's "Open in a new tab" does.
templ conversationPanel() {
	<section class="[ frame ]" aria-label="Conversation" x-data="sessionsConversation(panel)">
		<template x-if="showsFilter">
			<div class="[ conversation-bar ] [ divide-bottom ]">
				<label for="conversation-filter" class="[ color-ink-muted ]">Show</label>
				<select id="conversation-filter" data-size="sm" data-fit x-model="filter">
					<option value="">Every delegate</option>
					<template x-for="d in delegates" x-bind:key="d.id">
						<option x-bind:value="d.id" x-text="d.label"></option>
					</template>
				</select>
			</div>
		</template>
		<div class="[ conversation ]" x-ref="log" data-scroll tabindex="0" aria-label="Messages">
			<template x-for="m in views" x-bind:key="m.id">
				<article class="[ message ]" x-bind:data-undelivered="m.undelivered">
					<header class="[ head ]">
						<span><strong x-text="m.from"></strong> → <span x-text="m.to"></span></span>
						<span class="[ badge ]" x-text="m.kind"></span>
						<template x-for="b in m.badges" x-bind:key="b.word">
							<span class="[ badge ]" x-bind:data-tone="b.tone" x-text="b.word"></span>
						</template>
						<span class="[ meta ]" x-text="m.age"></span>
					</header>
					<template x-if="m.replyTo">
						<p class="[ aside ]">Reply to “<span x-text="m.replyTo"></span>”</p>
					</template>
					<template x-if="m.subject">
						<p class="[ subject ]" x-text="m.subject"></p>
					</template>
					<p class="[ body ]" x-bind:data-clamped="clamped(m)" x-text="m.body"></p>
					<template x-if="m.long">
						<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-expanded="expanded(m)" x-on:click="toggle(m.id)" x-text="toggleWord(m)"></button>
					</template>
					<template x-if="m.hasLinks">
						<p class="[ links ]">
							<template x-for="d in m.documents" x-bind:key="d.id">
								<a x-bind:href="d.href" x-text="d.title"></a>
							</template>
							<template x-for="a in m.artifacts" x-bind:key="a.id">
								<span>
									<template x-if="a.href">
										<a x-bind:href="a.href" target="_blank" rel="noopener noreferrer" x-text="a.title"></a>
									</template>
									<template x-if="!a.href">
										<span class="[ color-ink-faint ]" x-text="a.title"></span>
									</template>
								</span>
							</template>
						</p>
					</template>
					<template x-if="m.undelivered">
						<p class="[ aside ]">Not delivered yet: it reaches the session when its current turn ends, or when the session reads its messages.</p>
					</template>
				</article>
			</template>
			<template x-if="loading">
				<div class="[ flow ] [ flow-space-s ]" aria-hidden="true">
					<span class="[ skeleton ]" style="--skeleton-width: 40%"></span>
					<span class="[ skeleton ]" style="--skeleton-width: 85%"></span>
					<span class="[ skeleton ]" style="--skeleton-width: 70%"></span>
				</div>
			</template>
			<template x-if="isEmpty">
				@components.Empty("No messages yet", "Delegates report to the architect here, ask it questions and ask it for reviews; the architect answers them here too.")
			</template>
		</div>
	</section>
}

// statusCheckBar is the selected delegate's status-check loop: how often the
// architect is woken to check on it, and the person's controls
// (sessionsStatusCheck). An ended loop shows its words only.
templ statusCheckBar() {
	<div class="[ check-bar ]" x-data="sessionsStatusCheck(bar)" role="group" aria-label="Status checks">
		<span class="[ status ]" x-bind:data-state="bar.state" x-text="bar.detail"></span>
		<template x-if="controllable">
			<div class="[ cluster ] [ gutter-xs ]">
				<label class="[ visually-hidden ]" for="status-check-interval">Check every</label>
				<select id="status-check-interval" data-size="sm" data-fit x-model="minutes" x-bind:disabled="busy" x-bind:aria-busy="busy" x-on:change="retune">
					<template x-for="i in intervals" x-bind:key="i.value">
						<option x-bind:value="i.value" x-text="i.label"></option>
					</template>
				</select>
				<button type="button" class="[ button ]" data-size="sm" x-bind:aria-busy="busy" x-bind:disabled="busy" x-on:click="toggle" x-text="toggleWord"></button>
			</div>
		</template>
		<template x-if="error">
			<div class="[ banner ]" data-tone="danger" role="alert">
				<div class="[ flow ] [ flow-space-3xs grow ]">
					<span x-text="error.message"></span>
					<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
				</div>
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
			</div>
		</template>
	</div>
}

// reviewBand is the requests the task's architect raised for the person
// (reviewsInbox, scoped to the task): pending ones first, amber because they
// wait on the person, then the settled ones under "Earlier reviews". The
// server paints how many wait (task.pending_reviews) until the browser has
// read them; a task with none renders the band hidden, and it appears once
// the architect raises one. Its announcements go to the page's live region
// (the announce event), so the page keeps one.
templ reviewBand(v PageView) {
	if v.Reviews != nil {
		@templ.JSONScript("reviews-seed", v.Reviews)
		<section
			class="[ reviews ]"
			aria-label="Review requests"
			x-data="reviewsInbox"
			data-seed="reviews-seed"
			data-ticket-id={ v.Reviews.TicketID }
			data-pending={ strconv.Itoa(v.PendingReviews) }
			if v.Task.ArchitectSessionID != nil {
				data-architect
			}
			{ bandAttrs(v.PendingReviews)... }
			x-bind:hidden="hidesBand"
			x-bind:data-attention="attentionAttr"
		>
			if v.PendingReviews > 0 {
				<div class="[ flow ] [ flow-space-s ]" x-show="notLoaded">
					<p class="[ reviews-head ]">
						@components.Status("waiting", "waiting")
						<span>{ waitingLine(v.PendingReviews) }</span>
					</p>
					<span class="[ skeleton ]" style="--skeleton-width: 50%"></span>
					<span class="[ skeleton ]" style="--skeleton-width: 80%"></span>
				</div>
			}
			@components.ReviewsError()
			<template x-if="hasPending">
				<div class="[ flow ] [ flow-space-2xs ]">
					<h2 class="[ reviews-head ]" tabindex="-1" data-reviews-heading>
						<span class="[ status ]" data-state="waiting">waiting</span>
						<span x-text="headline"></span>
					</h2>
					<template x-for="card in pendingCards" x-bind:key="card.id">
						@components.ReviewCard()
					</template>
				</div>
			</template>
			<template x-if="hasSettled">
				<details>
					<summary x-text="settledLabel"></summary>
					<template x-for="card in settledCards" x-bind:key="card.id">
						@components.SettledReviewCard()
					</template>
				</details>
			</template>
		</section>
	}
}
