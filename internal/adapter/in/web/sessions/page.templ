package sessions

import (
	"strconv"

	"operators-mcp/internal/adapter/in/web/code"
	"operators-mcp/internal/adapter/in/web/components"
	"operators-mcp/internal/adapter/in/web/pullrequests"
	"operators-mcp/internal/adapter/in/web/shell"
	"operators-mcp/internal/adapter/in/web/tokensavers"
)

// Page is a task: its sessions in the inner list, the selected one's detail
// beside it. The server renders the first paint inside [data-ssr] and the
// same rows as an Alpine template; sessionsPage (in the browser) removes the
// server copy once the template has rendered.
templ Page(v PageView) {
	@shell.AppShell(v.Frame) {
		<main id="main"
			class="[ frame ]"
			x-data="sessionsPage"
			data-seed="sessions-seed"
			x-on:session-created="sessionCreated"
			x-on:new-session-cancelled="cancelCreating"
			x-on:artifact-published="artifactPublished"
			x-on:status-check-changed="statusCheckChanged"
			x-on:announce="announce"
			x-on:artifact-moved="artifactMoved"
			x-on:code-files-counted="codeCounted"
			x-on:code-expand="codeExpand"
			x-on:terminal-status="terminalStatus"
			x-on:run-shown="runShown"
			x-on:menu-select="menuSelect"
			x-on:dialog-action="dialogAction"
			x-effect="applyFocus()"
		>
			@templ.JSONScript("sessions-seed", v.Seed)
			if v.Code != nil {
				@templ.JSONScript("code-seed", v.Code.Seed)
			}
			if v.PullRequests != nil {
				@templ.JSONScript("pull-requests-seed", v.PullRequests)
				<div x-data="pullRequestWatch" data-seed="pull-requests-seed" hidden></div>
			}
			if v.Usage != nil {
				@templ.JSONScript("usage-totals-seed", v.Usage)
				<div x-data="usageTotalsWatch" data-seed="usage-totals-seed" hidden></div>
			}
			if !v.HasTask() {
				@brainstormsHeader(v)
			} else {
			<div x-data="tasksTaskEditor" data-seed="task-seed">
				@templ.JSONScript("task-seed", v.Task)
				<header class="[ toolbar ]">
					<a class="[ crumb ]" href={ templ.SafeURL("/projects/" + v.ProjectID) }>{ v.ProjectName } /</a>
					if v.Parent != nil {
						<a class="[ crumb ]" href={ templ.SafeURL(v.Parent.Href) } data-parent-task={ v.Parent.ID } title="The feature task this task belongs to">{ v.Parent.Title } /</a>
					}
					<h1 x-text="title">{ v.TaskTitle }</h1>
					<select data-size="sm" data-fit aria-label="Task status" x-model="status" x-on:change="changeStatus">
						for _, st := range v.StatusChoices {
							<option value={ st.Value } { selectedAttrs(st.Selected)... }>{ st.Label }</option>
						}
					</select>
					<span class="[ color-ink-faint text-sm ]" x-text="summary">{ v.Summary }</span>
					if v.Usage != nil {
						<span class="[ usage-total ]" x-data="usageTotalsChip" x-show="hasTask" x-text="taskText" x-bind:title="taskTitle"></span>
					}
					<div class="[ actions ]">
						if v.Documents != nil {
							<a
								class="[ button ]"
								data-variant="ghost"
								data-size="sm"
								href={ templ.SafeURL(v.Documents.Href) }
								x-data="tasksDocumentWatch"
								data-ticket-id={ v.Documents.TicketID }
								data-signature={ v.Documents.Signature }
								data-count={ strconv.Itoa(v.Documents.Count) }
							>
								Documents <span class="[ badge ]" x-text="count">{ strconv.Itoa(v.Documents.Count) }</span>
							</a>
						}
						<a
							class="[ button ]"
							data-variant="ghost"
							data-size="sm"
							href={ templ.SafeURL(taskDesignHref(v.ProjectID, v.Seed.TicketID)) }
							x-data="sessionsDesignWatch"
							data-seed="sessions-seed"
							data-design-assets
						>
							Design assets <span class="[ badge ]" x-text="count">{ strconv.Itoa(len(v.Seed.Artifacts)) }</span>
						</a>
						if v.Resources != nil {
							<span
								style="display: contents"
								x-data="tasksResourceWatch"
								data-project-id={ v.Resources.ProjectID }
								data-ticket-id={ v.Resources.TicketID }
								data-resource-ids={ v.Resources.ResourceIDs }
								data-comment-ids={ v.Resources.CommentIDs }
							>
								<a class="[ button ]" data-variant="ghost" data-size="sm" href={ templ.SafeURL(v.Resources.Href) } data-task-resources>
									Resources <span class="[ badge ]" x-text="resourceCount">{ strconv.Itoa(v.Resources.Resources) }</span>
								</a>
								<a class="[ button ]" data-variant="ghost" data-size="sm" href={ templ.SafeURL(v.Resources.Href + "#comments") } data-task-comments>
									Comments <span class="[ badge ]" x-text="commentCount">{ strconv.Itoa(v.Resources.Comments) }</span>
								</a>
							</span>
						}
						<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="startEditTask">Edit</button>
						<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-busy="checkingTaskDelete" x-on:click="askDeleteTask">Delete task</button>
						if v.NewSession.CanStart() {
							<button type="button" class="[ button ]" data-variant="primary" data-size="sm" disabled x-bind:disabled="cannotCreate" x-on:click="startCreating">
								New session <kbd>N</kbd>
							</button>
						} else {
							<a class="[ button ]" data-size="sm" href={ templ.SafeURL("/projects/" + v.ProjectID + "/repositories") }>Add a repository</a>
							<button type="button" class="[ button ]" data-variant="primary" data-size="sm" disabled title="Add a repository to this project first: a session runs in one.">
								New session
							</button>
						}
					</div>
				</header>
				@taskBand(v)
			</div>
			@contextStrip(v)
			}
			@reviewBand(v)
			if v.TokenSavers != nil {
				<details class="[ pad-inline-l pad-block-xs divide-bottom ]" data-token-savers>
					<summary class="[ text-sm ]">Token savers</summary>
					<div class="[ pad-block-s ]" style="max-inline-size: 44rem">
						@tokensavers.Section(*v.TokenSavers)
					</div>
				</details>
			}
			<template x-if="error">
				<div class="[ banner ] [ pad-s ]" data-tone="danger" role="alert">
					<div class="[ flow ] [ flow-space-3xs grow ]">
						<span x-text="error.message"></span>
						<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
					</div>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
				</div>
			</template>
			<p class="[ visually-hidden ]" role="status" aria-live="polite" x-text="announcement"></p>
			<div class="[ split-view ]" data-scroll x-bind:data-detail="detailOpenAttr" x-bind:data-expanded="expandedAttr">
				<div
					class="[ list ] [ divide-end ]"
					role="listbox"
					aria-label={ v.ListLabel() }
					tabindex="0"
					x-ref="list"
					x-on:keydown.enter.self.prevent="openSelected"
					x-on:keydown.j.prevent="next"
					x-on:keydown.down.prevent="next"
					x-on:keydown.k.prevent="previous"
					x-on:keydown.up.prevent="previous"
				>
					@ssrRows(v)
					@liveRows()
					<template x-if="isEmpty">
						@emptyList(v)
					</template>
				</div>
				@detail(v.NewSession, v.Code, v.Usage != nil, v.LockedMode())
			</div>
		</main>
	}
}

// contextStrip is what the page says about the task's context, in one row
// above the agents: a summary button per band with something to show, and
// the one open band's panel under it (tasksContextStrip owns which). A band
// that has nothing is painted hidden and appears once it has.
templ contextStrip(v PageView) {
	<div class="[ context-strip ]" role="group" aria-label="Task context" x-data="tasksContextStrip">
		@featureBand(v)
	</div>
}

// featureBand is the feature task's PRD and child tasks (ADR 0016). The
// server paints the children it read; tasksFeature re-renders them from the
// rail's store, so a child an agent creates while the page is open appears
// (its documents come with a reload). Its button is hidden until there is a
// child.
templ featureBand(v PageView) {
	<div
		style="display: contents"
		x-data="tasksFeature"
		data-task-id={ v.Seed.TicketID }
		data-project-id={ v.ProjectID }
		data-seed="feature-seed"
		data-children={ featureCount(v.Feature) }
	>
		@templ.JSONScript("feature-seed", v.FeatureSeed())
		<button
			type="button"
			class="[ cs-btn ]"
			id="band-feature-button"
			data-band="feature"
			aria-controls="band-feature"
			aria-expanded="false"
			x-bind:aria-expanded="expanded('feature')"
			x-on:click="toggle('feature')"
			x-bind:hidden="!hasChildren"
			{ hiddenIf(v.Feature == nil)... }
		>
			<span class="[ label ]">Feature</span>
			{ " " }
			<span class="[ badge ]" x-text="count">{ featureCount(v.Feature) }</span>
			{ " " }
			<span class="[ phrase ]" x-text="phrase">{ featurePhrase(v.Feature) }</span>
			<span class="[ chevron ]" aria-hidden="true"></span>
		</button>
		<section
			class="[ band-panel feature ]"
			id="band-feature"
			aria-labelledby="band-feature-button"
			data-band-panel="feature"
			x-show="expanded('feature') && hasChildren"
			style="display: none"
		>
			<header class="[ band-head ]">
				<span x-text="showing">{ featureShowing(v.Feature) }</span>
				if v.Feature != nil && v.Feature.PRD != nil {
					<a class="[ button ]" data-variant="ghost" data-size="sm" href={ templ.SafeURL(v.Feature.PRD.Href) } data-prd title={ "updated " + v.Feature.PRD.Updated }>{ v.Feature.PRD.Title }</a>
				}
			</header>
			<div class="[ list ]" data-band-scroll tabindex="0" x-bind:aria-label="scrollLabel" aria-label={ featureScrollLabel(v.Feature) }>
				<div x-ignore data-ssr role="group">
					if v.Feature != nil {
						for _, c := range v.Feature.Children {
							<div class="[ row ]" data-child-id={ c.ID } { doneAttr(c.Status == "done")... }>
								<span class="[ badge ]" data-status={ c.Status }>{ c.StatusLabel }</span>
								<span class="[ title ]"><a href={ templ.SafeURL(c.Href) }>{ c.Title }</a></span>
								<span class="[ meta ]">{ docCount(len(c.Documents)) }</span>
							</div>
						}
					}
				</div>
				<template x-for="child in children" x-bind:key="child.id">
					<div class="[ row ]" x-bind:data-child-id="child.id" x-bind:data-done="child.done ? '' : null">
						<span class="[ badge ]" x-bind:data-status="child.status" x-text="child.statusLabel"></span>
						<span class="[ title ]"><a x-bind:href="child.href" x-text="child.title"></a></span>
						<span class="[ meta ]" x-text="child.docCount"></span>
					</div>
				</template>
			</div>
		</section>
	</div>
}

// brainstormsHeader heads the project's sessions page: its feature
// brainstorms, the product-mode sessions that run with no task. There is no
// task to edit, so no task band.
templ brainstormsHeader(v PageView) {
	<header class="[ toolbar ]">
		<a class="[ crumb ]" href={ templ.SafeURL("/projects/" + v.ProjectID) }>{ v.ProjectName } /</a>
		<h1>{ BrainstormsTitle }</h1>
		<span class="[ color-ink-faint text-sm ]" x-text="summary">{ v.Summary }</span>
		<div class="[ actions ]">
			if v.NewSession.CanStart() {
				<button type="button" class="[ button ]" data-variant="primary" data-size="sm" disabled x-bind:disabled="cannotCreate" x-on:click="startCreating">
					New session <kbd>N</kbd>
				</button>
			} else {
				<a class="[ button ]" data-size="sm" href={ templ.SafeURL("/projects/" + v.ProjectID + "/repositories") }>Add a repository</a>
				<button type="button" class="[ button ]" data-variant="primary" data-size="sm" disabled title="Add a repository to this project first: a session runs in one.">
					New session
				</button>
			}
		</div>
	</header>
}

// emptyList is the list's empty state: a task's, or the project's brainstorms.
templ emptyList(v PageView) {
	if v.HasTask() {
		@components.Empty("No sessions for this task yet", "A session is an agent working on this task. Start one from the TUI: open the task and press n.")
	} else {
		@components.Empty("No feature brainstorms yet", "A feature brainstorm is a product-mode session with no task: the agent interviews you, writes the PRD on a new feature task and creates one child task per piece of work. Start one with New session, or from the board.")
	}
}

// ssrRows is the first paint: complete without JavaScript, ignored by Alpine,
// removed once the live template renders.
templ ssrRows(v PageView) {
	<div x-ignore data-ssr role="group">
		if v.Empty() {
			@emptyList(v)
		}
		for _, g := range v.Groups {
			<div class="[ group ]">
				{ g.Label }
				@components.Badge(strconv.Itoa(g.Count), g.Tone)
			</div>
			for _, r := range g.Rows {
				<div class="[ row ]" data-stacked role="option" data-session-id={ r.ID } aria-selected={ strconv.FormatBool(r.Selected) } { attentionAttrs(r.Attention)... } { roleAttrs(r.Role, r.Depth)... }>
					@components.Status(r.State, r.Word)
					<span class="[ title ]">
						if r.Badge != "" {
							@components.Badge(r.Badge, "")
						}
						{ r.Title }
					</span>
					<span class="[ meta ]" title={ r.Meta }>{ r.Meta }</span>
				</div>
			}
		}
	</div>
}

// liveRows is the same markup bound to sessionsPage's groups.
templ liveRows() {
	<template x-for="group in groups" x-bind:key="group.key">
		<div role="group">
			<div class="[ group ]">
				<span x-text="group.label"></span>
				<span class="[ badge ]" x-bind:data-tone="group.tone" x-text="group.count"></span>
			</div>
			<template x-for="row in group.rows" x-bind:key="row.id">
				<div class="[ row ]" data-stacked role="option" x-bind:data-session-id="row.id" x-bind:aria-selected="row.selected" x-bind:data-attention="row.attention" x-bind:data-fresh="row.fresh" x-bind:data-role="row.roleAttr" x-bind:data-depth="row.depthAttr" x-on:click="open(row.id)">
					<span class="[ status ]" x-bind:data-state="row.state" x-text="row.word"></span>
					<span class="[ title ]">
						<template x-if="row.badge">
							<span><span class="[ badge ]" x-text="row.badge"></span>{ " " }</span>
						</template>
						<span x-text="row.title"></span>
						@pullrequests.Badge("row.workspaceId")
					</span>
					<span class="[ meta ]" x-bind:title="row.meta" x-text="row.meta"></span>
					<template x-if="row.resumable">
						<button type="button" class="[ button action ]" data-variant="ghost" data-size="sm" x-bind:aria-label="row.resumeLabel" x-bind:disabled="cannotResume" x-on:click.stop="resume(row.id)">Resume</button>
					</template>
				</div>
			</template>
		</div>
	</template>
}

// detail is the right-hand pane: the new-session form while creating,
// otherwise the selected session. Alpine renders it, since it follows the
// selection.
templ detail(form NewSessionForm, paint *code.View, usage bool, lockedMode string) {
	<section class="[ frame ]" aria-label="Session detail" x-on:keydown.window.n="startCreatingFromKey">
		if paint != nil {
			@code.Static(*paint)
		}
		<template x-if="creating">
			@newSessionForm(form, lockedMode)
		</template>
		<template x-if="showingSession">
			<section class="[ session ]" aria-label="Session">
				@sessionHead(usage)
				@paneTabs()
				<template x-for="t in terminalPanes" x-bind:key="t.key">
					@terminalPane()
				</template>
				<template x-if="noteOnly">
					<div class="[ terminal ]" data-state="ended">
						@paneNote()
						<div class="[ screen ]"></div>
					</div>
				</template>
				<template x-for="panel in historyPanels" x-bind:key="panel.key">
					@historyPanel()
				</template>
				<template x-for="panel in appPanels" x-bind:key="panel.key">
					@appPanel()
				</template>
				<template x-for="panel in designPanels" x-bind:key="panel.key">
					@designPanel()
				</template>
				<template x-for="panel in codePanels" x-bind:key="panel.key">
					@codePanel()
				</template>
				<template x-for="panel in conversationPanels" x-bind:key="panel.key">
					@conversationPanel()
				</template>
				<template x-if="appUnavailable">
					@components.Empty("No worktree to run from", "This session was not started on a repository, so there is no application to run. Start a session on a repository to run its app beside the agent.")
				</template>
			</section>
		</template>
		<template x-if="showingNothing">
			@components.Empty("Pick a session", "Select one on the left, move with J and K, or start a new one with N.")
		</template>
	</section>
}

// newSessionForm starts an interactive session on this task, in a terminal
// on the server. The choices are rendered by the server; sessionsNewSession
// submits them to the API and the page attaches to the new terminal. With
// lockedMode "product" (the project's sessions page, which has no task) the
// Mode field is a line saying so: no other mode starts without a task.
templ newSessionForm(form NewSessionForm, lockedMode string) {
	<form
		class="[ flow ] [ pad-l ]"
		x-data="sessionsNewSession(projectId, ticketId)"
		data-default-repository={ form.DefaultRepository() }
		data-locked-mode={ lockedMode }
		x-on:submit.prevent="submit"
		x-on:keydown.escape="cancel"
	>
		if lockedMode == "" {
			<h2>New session</h2>
		} else {
			<h2>New feature brainstorm</h2>
		}
		<div class="[ field ]">
			<label for="new-session-prompt">First message <span class="[ color-ink-faint weight-regular ]">(optional)</span></label>
			<textarea id="new-session-prompt" class="[ font-mono text-sm ]" x-bind:placeholder="promptPlaceholder" x-model="prompt" x-ref="prompt"></textarea>
			if lockedMode == "" {
				<span class="[ hint ]">claude starts in a terminal on the server, on this task's branch.</span>
			} else {
				<span class="[ hint ]">claude starts in a terminal on the server, on its own branch of the repository.</span>
			}
		</div>
		<div class="[ switcher ]">
			<div class="[ field ]">
				<label for="new-session-agent">Agent</label>
				<div class="[ dropdown ]" x-data="dropdown">
					<select id="new-session-agent" x-model="agentId">
						<option value="" data-description="claude with no agent definition">Plain claude</option>
						for _, a := range form.Agents {
							<option value={ a.ID } { descriptionAttrs(a.Description)... }>{ a.Name }</option>
						}
					</select>
				</div>
			</div>
			<div class="[ field ]">
				if lockedMode == "" {
					<label for="new-session-mode">Mode</label>
					<div class="[ dropdown ]" x-data="dropdown">
						<select id="new-session-mode" x-model="mode">
							<option value="" data-description="Runs the agent as it is">Default</option>
							<option value="architect" data-description="Grills you on the design, writes per-application specs and delegates them">Architect</option>
							<option value="implement" data-description="Turns a spec into reviewed tickets, then implements them test first">Implement</option>
							<option value="design" data-description="Publishes pages, images and videos as it works">Design</option>
							<option value="product" data-description="Interviews you, writes the PRD on this task and creates one child task per piece of work, each with a brief">Product</option>
						</select>
					</div>
				} else {
					<span class="[ label ]">Mode</span>
					<span data-locked-mode-word>Product — the only mode that runs without a task.</span>
				}
				<span class="[ hint ]" x-text="modeHint"></span>
			</div>
			<div class="[ field ]">
				<label for="new-session-repository">Repository</label>
				<select id="new-session-repository" x-model="repositoryId" x-on:change="repositoryChanged">
					for _, r := range form.Repositories {
						<option value={ r.ID }>{ r.Name }</option>
					}
				</select>
			</div>
			<div class="[ field ]">
				<label for="new-session-base">Branch off</label>
				<div class="[ dropdown ]" x-data="combobox" x-bind:aria-busy="loadingBranches" x-bind:data-error="branchError" x-on:dropdown-retry="loadBranches">
					<select id="new-session-base" x-model="baseBranch" x-bind:disabled="loadingBranches">
						<option value="" data-pinned>The checked-out branch</option>
						<optgroup label="Branches">
							<template x-for="b in localBranches" x-bind:key="b.name">
								<option x-bind:value="b.name" x-text="b.name"></option>
							</template>
						</optgroup>
						<template x-if="hasRemoteBranches">
							<optgroup label="Remote branches">
								<template x-for="b in remoteBranches" x-bind:key="b.name">
									<option x-bind:value="b.name" x-text="b.name"></option>
								</template>
							</optgroup>
						</template>
					</select>
				</div>
				<span class="[ hint ]" x-text="baseHint"></span>
			</div>
			<fieldset class="[ field ]">
				<legend>Permissions</legend>
				<div class="[ field ]" data-inline>
					<input type="radio" id="new-session-permissions-off" name="new-session-permissions" value="off" x-model="autoAccept"/>
					<label for="new-session-permissions-off">Ask me in the terminal</label>
				</div>
				<div class="[ field ]" data-inline>
					<input type="radio" id="new-session-permissions-edits" name="new-session-permissions" value="edits" x-model="autoAccept"/>
					<label for="new-session-permissions-edits">Accept file edits</label>
				</div>
				<div class="[ field ]" data-inline>
					<input type="radio" id="new-session-permissions-all" name="new-session-permissions" value="all" x-model="autoAccept" aria-describedby="new-session-permissions-all-hint"/>
					<label for="new-session-permissions-all">Accept everything</label>
				</div>
				<span class="[ hint ]" id="new-session-permissions-all-hint">Accept everything runs every command and edit without asking you.</span>
			</fieldset>
		</div>
		<template x-if="error">
			<div class="[ banner ]" data-tone="danger" role="alert">
				<div class="[ flow ] [ flow-space-3xs ]">
					<span x-text="error.message"></span>
					<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
				</div>
			</div>
		</template>
		<div class="[ cluster ]">
			<button type="submit" class="[ button ]" data-variant="primary" x-bind:disabled="cannotSubmit" x-bind:aria-busy="submitting">Start session</button>
			<button type="button" class="[ button ]" data-variant="ghost" x-on:click="cancel">Cancel</button>
		</div>
	</form>
}

// terminalPane is the selected session's PTY, drawn by xterm.js. It is
// mounted once per session (the x-for key), so switching sessions detaches.
templ terminalPane() {
	<div
		class="[ terminal ]"
		x-data="sessionsTerminal(t.id)"
		x-bind:data-state="state"
		x-bind:data-attention="attention ? '' : null"
		x-on:terminal-focus-requested.window="focus"
		x-on:terminal-reconnect-requested.window="reconnectRequested"
		x-on:terminal-jump-requested.window="jumpRequested"
		x-on:terminal-text-size.window="textSizeRequested"
	>
		<template x-if="state === 'ended' && paneNote">
			@paneNote()
		</template>
		<div class="[ screen ]" x-ref="screen" x-on:click="focus"></div>
		<template x-if="state === 'connecting'">
			@connectingNotice()
		</template>
	</div>
}

templ connectingNotice() {
	<p class="[ notice ]" role="status"><span class="[ skeleton ]"></span>Connecting to the terminal…</p>
}

// appPanel runs the session's repository's application from its worktree:
// a saved run command or a typed one, its output in a live terminal (keys go
// through, so Ctrl+C reaches the app). One run is on screen at a time; the
// session's earlier runs are a click away.
templ appPanel() {
	<section class="[ frame ]" aria-label="Application" x-data="runsAppPanel(panel)" x-on:terminal-exited="refresh" x-effect="reportRun()">
		<div class="[ flow ] [ flow-space-s pad-l divide-bottom ]">
			<div class="[ source ]" aria-label="Where the code comes from">
				<p>
					Runs <strong x-text="repositoryLabel"></strong>{ " " }
					<template x-if="hasBranch">
						<span>on branch <code x-text="branch"></code>{ " " }</span>
					</template>
					— this session's worktree, with the agent's changes, not your own checkout.
				</p>
				<p class="[ code color-ink-faint truncate ]" x-text="worktree" x-bind:title="worktree"></p>
			</div>
			<form class="[ cluster ] [ gutter-xs ]" x-on:submit.prevent="start">
				<label class="[ visually-hidden ]" for="run-choice">Command</label>
				<div class="[ dropdown ] [ grow ]" x-data="combobox" data-free-text data-free-text-label="Run “{q}”" data-placeholder="Type a command or pick a saved one" x-on:dropdown-change="commandPicked" x-on:input="commandTyped">
					<select id="run-choice" x-ref="command" x-bind:disabled="busy">
						<template x-for="c in commands" x-bind:key="c.name">
							<option x-bind:value="c.name" x-bind:data-description="c.command" x-text="c.name"></option>
						</template>
					</select>
				</div>
				<template x-if="canForget">
					<span class="[ code color-ink-muted truncate grow ]" x-text="chosenCommand"></span>
				</template>
				<button type="submit" class="[ button ]" data-variant="primary" data-size="sm" x-bind:disabled="cannotRun" x-bind:aria-busy="busy">Run</button>
				<template x-if="canForget">
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="forget">Remove</button>
				</template>
			</form>
			<template x-if="typing">
				<form class="[ cluster ] [ gutter-xs text-sm ]" x-on:submit.prevent="save">
					<label for="run-save-name" class="[ color-ink-muted ]">Save for this repository as</label>
					<input id="run-save-name" autocomplete="off" placeholder="server" x-model="saveName"/>
					<button type="submit" class="[ button ]" data-size="sm" x-bind:disabled="cannotSave">Save</button>
				</form>
			</template>
			<template x-if="hasRun">
				<div class="[ repel ]">
					<div class="[ cluster ] [ gutter-s text-sm ]">
						<span class="[ status ]" x-bind:data-state="runStatusState" x-text="runStatusWord"></span>
						<strong x-text="runLabel"></strong>
						<span class="[ code color-ink-faint truncate ]" x-text="runCommandLine"></span>
					</div>
					<div class="[ cluster ] [ gutter-xs ]">
						<button type="button" class="[ button ]" data-size="sm" x-bind:disabled="busy" x-on:click="restart">Restart</button>
						<button type="button" class="[ button ]" data-size="sm" x-show="running" x-bind:disabled="busy" x-on:click="stop">Stop</button>
					</div>
				</div>
			</template>
			<template x-if="hasHistory">
				<div class="[ cluster ] [ gutter-xs text-sm ]" role="group" aria-label="Earlier runs">
					<template x-for="h in history" x-bind:key="h.id">
						<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-pressed="h.current" x-on:click="show(h.id)">
							<span class="[ status ]" x-bind:data-state="h.state" x-text="h.label"></span>
						</button>
					</template>
				</div>
			</template>
			<template x-if="notice">
				<p class="[ text-sm color-ink-muted ]" role="status" x-text="notice"></p>
			</template>
			<template x-if="error">
				<div class="[ banner ]" data-tone="danger" role="alert">
					<div class="[ flow ] [ flow-space-3xs ]">
						<span x-text="error.message"></span>
						<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
					</div>
				</div>
			</template>
		</div>
		<template x-for="rid in runIds" x-bind:key="rid">
			<div
				class="[ terminal ]"
				x-data="sessionsRunTerminal(rid)"
				x-bind:data-state="state"
				x-on:terminal-reconnect-requested.window="reconnectRequested"
				x-on:terminal-jump-requested.window="jumpRequested"
				x-on:terminal-text-size.window="textSizeRequested"
			>
				<div class="[ screen ]" x-ref="screen" x-on:click="focus"></div>
				<template x-if="state === 'connecting'">
					@connectingNotice()
				</template>
			</div>
		</template>
		<template x-if="showsEmpty">
			@components.Empty("Nothing running", "Pick a saved command or type one, then Run. It runs in this session's worktree, so the agent's changes and the repository's env files are there.")
		</template>
	</section>
}

// codePanel is the session's Code tab (the code module's codePanel): its
// worktree's changes, files and map. It stays mounted behind the other tabs
// (x-show), so it counts the changed files for the tab's badge and follows
// code_changed while the session runs. As with the Design panel, the page's
// showingCode is read on a wrapper outside the panel's x-data.
templ codePanel() {
	<div class="[ frame ]" x-show="showingCode">
		<section class="[ frame ]" aria-label="Code" x-data="codePanel(panel)" x-on:code-tab.window="tabShown" x-on:session-ended.window="sessionEnded" x-on:popstate.window="popState">
			@code.Live()
		</section>
	</div>
}

// designPanel is what the session published, newest first, with the selected
// artifact rendered beside the list (ArtifactPreview: sandboxed frames, text
// titles). It stays mounted behind the other tabs (x-show), so its stream
// keeps counting publishes for the tab's badge. The bar moves the selected
// artifact to the project, or back to its task.
// The page's showingDesign is read from a wrapper outside the panel's x-data:
// evaluated on the panel itself, the page's getters would resolve `this`
// through the panel's scope, whose selectedId (an artifact) shadows the page's
// (a session), and the panel would never show.
templ designPanel() {
	<div class="[ frame ]" x-show="showingDesign">
		<section class="[ frame ]" aria-label="Design" x-data="sessionsDesignPanel(panel)" x-on:session-ended.window="sessionEnded">
			<template x-if="error">
				<div class="[ banner ] [ pad-s ]" data-tone="danger" role="alert">
					<div class="[ flow ] [ flow-space-3xs grow ]">
						<span x-text="error.message"></span>
						<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
					</div>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
				</div>
			</template>
			<div class="[ with-sidebar ] [ grow ]" style="--sidebar-target: 16rem" data-scroll>
				<div
					class="[ list ] [ divide-end ]"
					role="listbox"
					aria-label="Artifacts of this session"
					tabindex="0"
					x-on:keydown.j.prevent="next"
					x-on:keydown.down.prevent="next"
					x-on:keydown.k.prevent="previous"
					x-on:keydown.up.prevent="previous"
				>
					<template x-for="card in cards" x-bind:key="card.id">
						@ArtifactCard()
					</template>
					<template x-if="isEmpty">
						<div>
							@components.Empty("Nothing published yet", "When the agent publishes a page, an image, a video or a file for you to look at, it appears here and refreshes as it changes. Ask for one in the Agent tab.")
							<p class="[ pad-inline-l text-sm ]"><a x-bind:href="designHref" data-task-design>Project assets attached to this task are on its Design assets page</a></p>
						</div>
					</template>
				</div>
				@ArtifactPreview() {
					<a x-bind:href="designHref" data-task-design>Attached project assets are on the task's Design assets</a>
					<template x-if="canMoveCurrent">
						<form x-on:submit.prevent="move">
							<button type="submit" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-busy="moving" x-bind:aria-label="currentMoveAriaLabel" x-text="currentMoveLabel">Move to project</button>
						</form>
					</template>
				}
			</div>
		</section>
	</div>
}

// taskBand sits under the toolbar, in the task editor's scope: who moved
// the task's status last and why (seen live, over the feed), the
// description, the edit form, the delete confirmation, the editor's errors.
templ taskBand(v PageView) {
	<template x-if="statusLine">
		<p class="[ status-change ]">
			<span x-text="statusLine"></span>
			<template x-if="statusReason">
				<span class="[ truncate ]" x-bind:title="statusReason">{ " " }— <span x-text="statusReason"></span></span>
			</template>
		</p>
	</template>
	<template x-if="showsDescription">
		<p class="[ brief ]" x-text="description">{ v.TaskDescription }</p>
	</template>
	<template x-if="editingTask">
		<form class="[ flow ] [ flow-space-s pad-l divide-bottom ]" x-on:submit.prevent="save" x-on:keydown.escape="cancelEditTask">
			<div class="[ field ]">
				<label for="task-edit-title">Title</label>
				<input id="task-edit-title" autocomplete="off" x-model="draftTitle" x-ref="title"/>
			</div>
			<div class="[ field ]">
				<label for="task-edit-description">Description</label>
				<textarea id="task-edit-description" x-model="draftDescription"></textarea>
			</div>
			<div class="[ cluster ]">
				<button type="submit" class="[ button ]" data-variant="primary" data-size="sm" x-bind:disabled="cannotSaveTask" x-bind:aria-busy="savingTask">Save</button>
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="cancelEditTask">Cancel</button>
			</div>
		</form>
	</template>
	<template x-if="taskDeleteProblem">
		<div class="[ pad-inline-l pad-block-s ]">
			<div class="[ banner ]" data-tone="attention" role="alert">
				<div class="[ flow ] [ flow-space-3xs grow ]">
					<strong>This task cannot be deleted yet.</strong>
					<span x-text="taskDeleteProblem"></span>
				</div>
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="cancelDeleteTask">OK</button>
			</div>
		</div>
	</template>
	<template x-if="confirmingTaskDelete">
		<div class="[ pad-inline-l pad-block-s ]">
			<div class="[ banner ]" data-tone="danger" role="alertdialog" aria-label="Delete this task?">
				<div class="[ flow ] [ flow-space-3xs grow ]">
					<strong>Delete this task?</strong>
					<span>It has no sessions. Its title and description are removed for good.</span>
				</div>
				<div class="[ cluster ] [ gutter-xs ]">
					<button type="button" class="[ button ]" data-variant="danger" data-size="sm" x-bind:aria-busy="deletingTask" x-on:click="removeTask">Delete task</button>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="cancelDeleteTask">Keep it</button>
				</div>
			</div>
		</div>
	</template>
	<template x-if="taskError">
		<div class="[ pad-inline-l pad-block-s ]">
			<div class="[ banner ]" data-tone="danger" role="alert">
				<div class="[ flow ] [ flow-space-3xs grow ]">
					<span x-text="taskError.message"></span>
					<span class="[ code ]"><span x-text="taskError.code"></span> · <span x-text="taskError.next"></span></span>
				</div>
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissTaskError">Dismiss</button>
			</div>
		</div>
	</template>
}
