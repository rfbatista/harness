package sessions

// ArtifactCard is one artifact in a list of them (the Design tab, the
// project's design assets), bound to a card from artifactView's toCardView
// inside an x-for over `card in cards`. Titles and notes are text, never
// markup. Children go after the meta line: the library names the task there.
templ ArtifactCard() {
	<div class="[ artifact-card ]" role="option" x-bind:aria-selected="card.selected" x-bind:data-fresh="card.fresh" x-on:click="select(card.id)">
		<span class="[ title ]" x-text="card.title"></span>
		<span class="[ cluster ] [ gutter-3xs ]">
			<span class="[ badge ]" x-text="card.kindWord"></span>
			<template x-if="card.scopeMark">
				<span class="[ badge ]" data-tone="signal" x-text="card.scopeMark"></span>
			</template>
		</span>
		<span class="[ note ]" x-text="card.note"></span>
		<span class="[ meta ]"><span x-text="card.revision"></span><span x-text="card.updated"></span></span>
		{ children... }
	</div>
}

// ArtifactPreview renders the selected artifact (frames from toPreviewView)
// and a bar under it: the stream's status when the component follows one,
// the artifact's scope in words, the link out, then the children (the
// actions the page offers on it).
//
// Pages and dev servers are embedded only in a sandboxed frame. The Alpine
// CSP build refuses directives on an iframe, so the frame is literal markup
// (sandbox included) and its wrapper's x-init hands it to loadFrame, which
// sets only src and title. Tab leaves the frame (sequential focus crosses
// it) and lands on the bar, which says so.
templ ArtifactPreview() {
	<div class="[ preview ]" x-bind:data-kind="currentKind">
		<div class="[ stage ]">
			<template x-for="frame in frames" x-bind:key="frame.key">
				<div class="[ frame ]">
					<template x-if="frame.isPage">
						<div class="[ frame ]" x-init="loadFrame($el, frame)">
							<iframe sandbox="allow-scripts" referrerpolicy="no-referrer"></iframe>
						</div>
					</template>
					<template x-if="frame.embedsUrl">
						<div class="[ frame ]" x-init="loadFrame($el, frame)">
							<iframe sandbox="allow-scripts" referrerpolicy="no-referrer"></iframe>
						</div>
					</template>
					<template x-if="frame.notEmbeddable">
						<div class="[ pad-l ]">
							<div class="[ banner ]" data-tone="attention">
								<span>This dev server is not on this machine, so it is not embedded. The session published <strong x-text="frame.title"></strong> at <code x-text="frame.url"></code>.</span>
							</div>
						</div>
					</template>
					<template x-if="frame.isImage">
						<img x-bind:src="frame.src" x-bind:alt="frame.title"/>
					</template>
					<template x-if="frame.isVideo">
						<video controls preload="metadata" x-bind:src="frame.src" x-bind:aria-label="frame.frameTitle"></video>
					</template>
					<template x-if="frame.isFile">
						<div class="[ flow ] [ flow-space-s ]">
							<p><a x-bind:href="frame.openHref" x-bind:download="frame.fileName" x-text="frame.fileName"></a></p>
							<p class="[ text-sm color-ink-muted ]"><span x-text="frame.size"></span> · <code x-text="frame.mime"></code></p>
						</div>
					</template>
				</div>
			</template>
		</div>
		<div class="[ bar ]">
			<template x-if="followsFeed">
				<span class="[ status ]" x-bind:data-state="feedState" x-text="feedWord">connecting</span>
			</template>
			<template x-if="hasCurrent">
				<span class="[ badge ]" data-scope-word x-text="currentScopeWord"></span>
			</template>
			<span class="[ grow truncate ]"><kbd>Tab</kbd> leaves the frame · <kbd>J</kbd> <kbd>K</kbd> move the list</span>
			<template x-if="hasOpenHref">
				<a x-bind:href="currentOpenHref" target="_blank" rel="noopener noreferrer">Open in a new tab</a>
			</template>
			{ children... }
		</div>
	</div>
}
