package sessions

// mergePanel is the Merge tab: merge the session's branch with a merge commit
// into the repository's default branch, in its local checkout, which the
// harness server does (ADR 0021). The button is offered only where a merge
// can apply and is disabled while one runs; the newest result, the new HEAD
// or the refusal with its reason, shows below it and is the session's own, so
// it survives a reload (sessionsMerge).
templ mergePanel() {
	<section class="[ frame ]" aria-label="Merge" x-data="sessionsMerge(panel)">
		<div class="[ merge-tab ]" data-scroll>
			<h3>Merge this branch</h3>
			<p class="[ explain ]">
				The harness server merges <span class="[ font-mono ]" x-text="branch"></span> into <span class="[ font-mono ]" x-text="into"></span> in the repository's local checkout, with a merge commit.
				It never pushes, restarts nothing, and the task stays where it is.
			</p>
			<template x-if="offered">
				<div class="[ actions ]">
					<button type="button" class="[ button ]" data-variant="primary" data-merge x-bind:disabled="cannotMerge" x-bind:aria-busy="busyAttr" x-on:click="mergeNow" x-text="label"></button>
				</div>
			</template>
			<template x-if="notOffered">
				<div class="[ note ]" data-merge-unavailable>
					<p x-text="unavailable"></p>
				</div>
			</template>
			<template x-if="error">
				<div class="[ banner ]" data-tone="danger" role="alert">
					<span x-text="error"></span>
				</div>
			</template>
			<template x-if="hasResult">
				<div class="[ banner ]" data-merge-result x-bind:data-tone="resultTone" role="status">
					<div class="[ flow ] [ flow-space-3xs ]">
						<strong x-text="resultTitle"></strong>
						<p x-text="resultDetail"></p>
						<span class="[ code ]" x-show="resultCode" x-text="resultCode"></span>
					</div>
				</div>
			</template>
		</div>
	</section>
}
