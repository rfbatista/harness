package sessions

// The interview panel beside a session's terminal (the Agent tab), as the UX
// study "Interview panel" draws it. The agent stage holds the terminal and, when
// the session column is at least 56rem wide, the panel docked beside it; narrower,
// a peek strip over the terminal's foot opens the same panel as a sheet.
// sessionsInterviewPanel decides which, and fills the panel from the store
// "sessionsInterviews". The answer controls are drawn but not yet kept: the
// person answers in a later change, so they carry no state here.

// agentStage is the Agent tab's pane: the terminal, and what sits beside or over it.
templ agentStage() {
	<div class="[ agent-stage ]" x-data="sessionsInterviewPanel(t.id)" x-on:keydown.window.capture="claimKey" x-on:interview-sheet-opened.window="sheetOpened">
		@terminalPane()
		<template x-if="dockShown">
			@interviewPanel()
		</template>
		<template x-if="peeking">
			<div class="[ interview-peek ]" role="status" data-interview-peek>
				<span class="[ status ]" data-state="waiting" data-dot-only aria-hidden="true"></span>
				<span class="[ text ]" x-text="view.peek"></span>
				<button type="button" class="[ button ]" data-variant="primary" data-size="sm" x-on:click="openSheet">Answer</button>
			</div>
		</template>
		<template x-if="sheetShown">
			<div class="[ interview-modal ]" x-on:keydown.escape="closeSheet">
				<div class="[ interview-scrim ]" x-on:click="closeSheet"></div>
				<div class="[ interview-sheet ]" role="dialog" aria-modal="true" aria-label="Interview">
					<span class="[ grab ]" aria-hidden="true"></span>
					@interviewPanel()
				</div>
			</div>
		</template>
	</div>
}

// interviewPanel is the session's open interviews, newest first, each a card
// of its questions. Its scroller takes the focus only when the person asks
// (Alt+Shift+Q), never on what arrives.
templ interviewPanel() {
	<aside class="[ interview ]" aria-label="Interview panel" data-interview-panel>
		<header>
			<h2>Interview</h2>
			<span class="[ who ]" x-text="view.who"></span>
			<span class="[ grow ]"></span>
			<span class="[ badge ]" data-tone="attention" x-text="view.openLabel"></span>
			<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-icon aria-label="Hide interview panel" title="Hide panel" x-on:click="closePanel">
				@icon("close")
			</button>
		</header>
		<div class="[ scroll ]" tabindex="-1" data-interview-scroll>
			<template x-for="card in view.cards" x-bind:key="card.id">
				@interviewCard()
			</template>
		</div>
	</aside>
}

// interviewCard is one open interview: who asks and when, then its questions.
templ interviewCard() {
	<section class="[ interview-set ]" x-bind:aria-label="card.label" data-state="open">
		<header>
			<strong x-text="card.heading"></strong>
			<span class="[ asked ]" x-text="card.asked"></span>
		</header>
		<template x-for="q in card.questions" x-bind:key="q.key">
			@interviewQuestion()
		</template>
	</section>
}

// interviewQuestion is a question: its number and title in the legend, the
// agent's markdown body (drawn by placeBody, which escapes raw HTML), then the
// answer control for its kind. The recommended option is first and labelled,
// and nothing is checked.
templ interviewQuestion() {
	<fieldset class="[ interview-question ]">
		<legend>
			<span class="[ heading ]">
				<span class="[ number ]" x-text="q.number"></span>
				<h3 x-text="q.title"></h3>
			</span>
		</legend>
		<div class="[ body ]" x-effect="placeBody($el, q)"></div>
		<div class="[ answer ]">
			<template x-if="q.hint">
				<p class="[ hint ]" x-text="q.hint"></p>
			</template>
			<template x-if="q.recommendedText">
				<div class="[ recommendation ]">
					<span class="[ tag ]">Agent recommends</span>
					<p x-text="q.recommendedText"></p>
				</div>
			</template>
			<template x-if="q.text">
				<textarea rows="3" placeholder="Write your answer" x-bind:name="q.name" x-bind:aria-label="q.title"></textarea>
			</template>
			<div class="[ options ]">
				<template x-for="o in q.options" x-bind:key="o.id">
					<label class="[ interview-option ]" x-bind:data-recommended="o.recommended ? '' : null">
						<input x-bind:type="q.multiple ? 'checkbox' : 'radio'" x-bind:name="q.name" x-bind:value="o.value"/>
						<span class="[ text ]">
							<template x-if="o.recommended">
								<span class="[ tag ]">Agent recommends</span>
							</template>
							<span x-text="o.label"></span>
							<template x-if="o.description">
								<small x-text="o.description"></small>
							</template>
						</span>
					</label>
				</template>
				<template x-if="q.own">
					<label class="[ interview-option ]">
						<input x-bind:type="q.multiple ? 'checkbox' : 'radio'" x-bind:name="q.name" value="own"/>
						<span class="[ text ]"><span x-text="q.own.label"></span></span>
					</label>
				</template>
			</div>
		</div>
	</fieldset>
}
