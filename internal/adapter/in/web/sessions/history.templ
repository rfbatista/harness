package sessions

import "operators-mcp/internal/adapter/in/web/components"

// historyPanel is the History tab: the session's saved conversation
// (sessionsHistory), read-only, newest at the bottom, in the design system's
// transcript block. Every line is an agent's or a person's text and is bound
// with x-text. The log is focusable, so the keyboard scrolls it; tool lines
// open with Enter or Space.
templ historyPanel() {
	<section class="[ frame ]" aria-label="History" x-data="sessionsHistory(panel)">
		<template x-if="showsError">
			<div class="[ pane-note ]" data-tone="danger" role="status">
				<span class="[ text ]"><strong>History could not load.</strong> <span x-text="error"></span></span>
				<button type="button" class="[ button ]" data-size="sm" x-on:click="retry">Retry</button>
			</div>
		</template>
		<template x-if="isLoading">
			<div class="[ empty ]" role="status"><p>Loading the conversation…</p></div>
		</template>
		<template x-if="isMissing">
			@components.Empty("No saved conversation yet", "It appears here once the agent has written its first turn.")
		</template>
		<template x-if="showsLog">
			<div class="[ transcript ]" data-scroll role="log" tabindex="0" aria-label="Conversation history" x-on:scroll="onScroll">
				<div class="[ older ]">
					<template x-if="canLoadOlder">
						<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-busy="loadingOlder" x-on:click="older">Load older</button>
					</template>
					<template x-if="atStart">
						<span>Start of the conversation</span>
					</template>
				</div>
				<template x-for="line in lines" x-bind:key="line.cursor">
					<div class="[ line ]" x-bind:data-kind="line.kind" x-bind:data-cursor="line.cursor">
						<time x-bind:title="line.stamp" x-text="line.time"></time>
						<span class="[ mark ]" aria-hidden="true" x-text="line.mark"></span>
						<template x-if="!line.fold">
							<!-- One line: the log keeps white space, so none between these. -->
							<span class="[ text ]"><span x-text="line.text"></span><template x-if="line.cut"><span class="[ cut ]">cut at 16 KiB</span></template></span>
						</template>
						<template x-if="line.fold">
							<div class="[ fold ]">
								<button type="button" class="[ summary ]" x-bind:aria-expanded="expanded(line)" x-on:click="toggle(line)">
									<span class="[ tool ]" x-text="line.tool"></span>
									<span class="[ gist ]" x-text="line.gist"></span>
									<span class="[ meta ]" x-text="line.meta"></span>
								</button>
								<template x-if="expanded(line)">
									<pre class="[ detail ]"><span x-text="line.text"></span><template x-if="line.cut"><span class="[ cut ]">cut at 16 KiB</span></template></pre>
								</template>
							</div>
						</template>
					</div>
				</template>
				<template x-if="showsJump">
					<button type="button" class="[ button jump ]" data-size="sm" x-on:click="jump" x-text="jumpLabel"></button>
				</template>
			</div>
		</template>
	</section>
}
