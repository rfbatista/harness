package designsystem

// tabComponents is the Components tab's panel: the components on the left, the
// open one on the right with its purpose, its do and don't notes and one live
// preview per variant or state. A preview is a page built only from the
// draft's tokens (so an unsaved token shows at once), loaded through srcdoc
// into a frame with sandbox="" (no scripts, no same origin) whose document
// also carries a Content-Security-Policy that blocks the network. A frame is
// made and filled only once it nears the viewport; the page's script makes it,
// since the CSP build of Alpine refuses directives on an iframe. The edits are
// part of the page's draft, saved with the tokens by the one Save bar; what the
// browser finds wrong with them shows at once, with the server's codes.
templ tabComponents() {
	<section role="tabpanel" id="design-system-panel-components" aria-labelledby="design-system-tab-components" x-show="isTab('components')" class="[ flow ]">
		<div class="[ arch-head ]" data-panel-head>
			<div class="[ flow ] [ flow-space-3xs ]">
				<h2>Components</h2>
				<p class="[ color-ink-muted text-sm ]">How the tokens come together. Each preview is plain HTML and CSS built only from tokens; it never runs a script or reaches the network.</p>
			</div>
			<div class="[ cluster ]">
				<button type="button" class="[ button ]" data-variant="primary" data-size="sm" data-add-component x-on:click="addComponent">Add component</button>
			</div>
		</div>
		<template x-if="hasComponentProblems">
			<div class="[ banner ]" data-tone="danger" role="alert" data-component-problems>
				<ul class="[ flow ] [ flow-space-3xs text-sm grow ]">
					<template x-for="p in componentErrors" x-bind:key="p.key">
						<li data-problem><span x-text="p.label"></span>: <span class="[ code ]" x-text="p.code"></span> <span x-text="p.message"></span></li>
					</template>
				</ul>
			</div>
		</template>
		<template x-if="noComponents">
			<p class="[ color-ink-muted ]" data-no-components>No components yet. A component shows its purpose, its do and don't notes and a live preview of each variant and state.</p>
		</template>
		<template x-if="hasComponents">
			<div class="[ with-sidebar ]" data-side="start" style="--gutter: var(--space-l); --sidebar-target: 15rem">
				<nav class="[ flow ] [ flow-space-3xs ]" aria-label="Components" data-component-list>
					<template x-for="item in componentItems" x-bind:key="item.key">
						<button type="button" class="[ button ]" data-variant="ghost" style="justify-content: flex-start; inline-size: 100%" data-component-item x-bind:data-slug="item.slug" x-bind:aria-current="isCurrent(item)" x-on:click="selectComponent(item)">
							<span x-text="item.name"></span>
							<span class="[ color-ink-faint text-xs ]" x-text="item.countText"></span>
							<template x-if="item.flagged">
								<span class="[ badge ]" data-tone="attention" data-flag>check</span>
							</template>
						</button>
					</template>
				</nav>
				<div class="[ flow ]" data-component-detail>
					<div class="[ flow ] [ flow-space-3xs ]">
						<h3 data-component-name x-text="current.name"></h3>
						<p class="[ color-ink-muted ]" data-component-purpose x-text="current.purpose"></p>
					</div>
					<template x-if="currentFlagged">
						<div class="[ banner ]" data-tone="attention" data-missing-token>
							<span>A preview uses a token that does not exist: <code x-text="currentMissing"></code></span>
						</div>
					</template>
					<div class="[ switcher ]" style="--switcher-threshold: 40rem">
						<div class="[ flow ] [ flow-space-3xs ]" data-do>
							<h4 class="[ text-sm ]">Do</h4>
							<ul class="[ flow ] [ flow-space-3xs text-sm ]">
								<template x-for="n in currentDos" x-bind:key="n.key">
									<li x-text="n.text"></li>
								</template>
							</ul>
						</div>
						<div class="[ flow ] [ flow-space-3xs ]" data-dont>
							<h4 class="[ text-sm ]">Don't</h4>
							<ul class="[ flow ] [ flow-space-3xs text-sm ]">
								<template x-for="n in currentDonts" x-bind:key="n.key">
									<li x-text="n.text"></li>
								</template>
							</ul>
						</div>
					</div>
					<div class="[ grid ]" style="--grid-min: 14rem; --gutter: var(--space-m)" data-previews>
						<template x-for="card in currentCards" x-bind:key="card.key">
							<figure class="[ entry-card ]" style="margin: 0" data-preview-card x-bind:data-flagged="card.flagged">
								<div data-frame-host x-init="watchFrame($el, card)" x-effect="paintFrame($el, card)"></div>
								<figcaption class="[ cluster ] [ text-xs ]" style="padding: var(--space-xs) var(--space-s)">
									<b data-preview-label x-text="card.label"></b>
									<code x-text="card.state"></code>
								</figcaption>
							</figure>
						</template>
					</div>
					<section class="[ flow ] [ flow-space-s ]" data-component-editor aria-label="Edit component">
						<div class="[ repel ]">
							<h4>Edit component</h4>
							<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-remove-component x-on:click="removeComponent">Remove component</button>
						</div>
						<div class="[ switcher ]" style="--switcher-threshold: 36rem">
							<label class="[ field ]"><span>Name</span><input data-field="component-name" type="text" autocomplete="off" x-model="current.name"/></label>
							<label class="[ field ]"><span>Slug</span><input data-field="component-slug" type="text" class="[ font-mono ]" autocomplete="off" spellcheck="false" x-model="current.slug"/></label>
						</div>
						<label class="[ field ]"><span>Purpose</span><input data-field="component-purpose" type="text" autocomplete="off" x-model="current.purpose"/></label>
						<div class="[ switcher ]" style="--switcher-threshold: 36rem">
							<label class="[ field ]"><span>Do <span class="[ color-ink-faint text-xs ]">one per line</span></span><textarea data-field="component-do" rows="3" x-bind:value="doText" x-on:input="setDo($el)"></textarea></label>
							<label class="[ field ]"><span>Don't <span class="[ color-ink-faint text-xs ]">one per line</span></span><textarea data-field="component-dont" rows="3" x-bind:value="dontText" x-on:input="setDont($el)"></textarea></label>
						</div>
						<div class="[ flow ]" data-preview-editors>
							<template x-for="card in currentCards" x-bind:key="card.key">
								<div class="[ flow ] [ flow-space-2xs ]" data-preview-editor>
									<div class="[ repel ]">
										<h5 class="[ text-sm ]" x-text="card.label"></h5>
										<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-remove-preview x-bind:disabled="onlyPreview" x-on:click="removePreview(card)">Remove preview</button>
									</div>
									<div class="[ switcher ]" style="--switcher-threshold: 36rem">
										<label class="[ field ]"><span>Label</span><input data-field="preview-label" type="text" autocomplete="off" x-model="card.preview.label"/></label>
										<label class="[ field ]"><span>Variant</span><input data-field="preview-variant" type="text" autocomplete="off" x-model="card.preview.variant"/></label>
										<label class="[ field ]"><span>State</span><input data-field="preview-state" type="text" autocomplete="off" x-model="card.preview.state"/></label>
									</div>
									<label class="[ field ]"><span>HTML</span><textarea data-field="preview-html" class="[ font-mono text-sm ]" rows="4" spellcheck="false" x-model="card.preview.html"></textarea></label>
									<label class="[ field ]"><span>CSS <span class="[ color-ink-faint text-xs ]">only var(--token) values</span></span><textarea data-field="preview-css" class="[ font-mono text-sm ]" rows="4" spellcheck="false" x-model="card.preview.css"></textarea></label>
								</div>
							</template>
						</div>
						<div class="[ cluster ]">
							<button type="button" class="[ button ]" data-size="sm" data-add-preview x-on:click="addPreview">Add preview</button>
						</div>
					</section>
				</div>
			</div>
		</template>
	</section>
}
