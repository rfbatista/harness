package productowner

import "operators-mcp/internal/adapter/in/web/shell"

// Page is the product owner's page: <main> holds the island's mount, which the browser
// draws (toolbar, tabs, thread list and conversation are its grid items).
templ Page(frame shell.Frame, props Props) {
	@shell.AppShell(frame) {
		<main id="main" class="[ owner-page ]">
			<div data-island="owner-page" data-island-rendered="false"></div>
			@shell.PropsScript("owner-page", props.JSON())
		</main>
	}
}
