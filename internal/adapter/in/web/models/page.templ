package models

import "operators-mcp/internal/adapter/in/web/shell"

// Page is /models. Each tier, and each assistant (the writing helper), is a modelTier
// (web/src/modules/models/presentation/components/modelTier.js) that saves
// its select's change.
templ Page(frame shell.Frame, v View) {
	@shell.AppShell(frame) {
		<main id="main" class="[ frame ]">
			<header class="[ toolbar ]">
				<h1>Models</h1>
			</header>
			<div data-scroll>
				<div class="[ wrapper flow ] [ region ]" style="--wrapper-max: 52rem">
					<p class="[ color-ink-muted ]">The Claude model each kind of agent session starts with. Planning runs on the stronger model; the sessions it hands work to run on a cheaper one. A session you start outside architect mode uses the CLI's default model. A change reaches sessions started afterwards; a resumed session keeps the model it started with.</p>
					<section class="[ pane ]" aria-labelledby="models-claude-title">
						<header><h2 id="models-claude-title">Claude</h2></header>
						<ul role="list" class="[ list ]">
							for _, t := range v.Tiers {
								@tierRow(t)
							}
						</ul>
					</section>
					if len(v.Assistants) > 0 {
						<section class="[ pane ]" aria-labelledby="models-assistants-title">
							<header><h2 id="models-assistants-title">Assistants</h2></header>
							<ul role="list" class="[ list ]">
								for _, t := range v.Assistants {
									@tierRow(t)
								}
							</ul>
						</section>
					}
				</div>
			</div>
		</main>
	}
}

templ tierRow(t Tier) {
	<li class="[ flow ] [ flow-space-2xs ]" x-data="modelTier" data-setting={ t.Key }>
		<p class="[ visually-hidden ]" role="status" aria-live="polite" x-text="announcement"></p>
		<template x-if="error">
			<div class="[ banner ]" data-tone="danger" role="alert">
				<div class="[ flow ] [ flow-space-3xs grow ]">
					<span x-text="error.message"></span>
					<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
				</div>
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
			</div>
		</template>
		<div class="[ row ]" style="--row-columns: 9rem auto">
			<label class="[ title ]" for={ "model-" + t.Title }>{ t.Title }</label>
			<select id={ "model-" + t.Title } data-size="sm" data-fit x-bind:disabled="saving" x-bind:aria-busy="saving" x-on:change="choose">
				for _, c := range t.Choices() {
					<option value={ c.Value } selected?={ c.Value == t.Current }>{ c.Label }</option>
				}
			</select>
		</div>
		<p class="[ text-sm color-ink-muted ]">{ t.Lead }</p>
		if t.UnavailableReason != "" {
			<div class="[ banner ]" data-tone="attention">
				<svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M8 2l6.5 11.5h-13z"></path><path d="M8 6.5v3M8 11.6v.1"></path></svg>
				<span>Pens are disabled: { t.UnavailableReason }. The pens come back on the next page load.
					if t.FixURL != "" {
						<a href={ templ.SafeURL(t.FixURL) }>Fix it</a>
					}
				</span>
			</div>
		}
	</li>
}
