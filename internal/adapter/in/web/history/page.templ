package history

import (
	"strconv"

	"operators-mcp/internal/adapter/in/web/code"
	"operators-mcp/internal/adapter/in/web/components"
	"operators-mcp/internal/adapter/in/web/gitsync"
	"operators-mcp/internal/adapter/in/web/pullrequests"
	"operators-mcp/internal/adapter/in/web/shell"
)

// Page is a history: a repository's commit graph, every local branch in it
// (agents' session branches among them), or one session's branch beside its
// base with its uncommitted changes as the first row; the open commit (or
// the changes) beside it. Rows are links: opening one keeps the place in
// the graph (#c-<hash>).
templ Page(v PageView) {
	@shell.AppShell(v.Frame) {
		<main id="main" class="[ frame ]" { pullrequests.PanelAttrs(v.PullRequest)... }>
			<header class="[ toolbar ]">
				for _, c := range v.Crumbs {
					<a class="[ crumb ]" href={ templ.SafeURL(c.Href) }>{ c.Label } /</a>
				}
				<h1>{ v.Heading }</h1>
				if v.Git != nil {
					@gitHead(v)
				} else {
					<span class="[ color-ink-faint text-sm ]">{ v.Meta }</span>
				}
				if v.RemotesHref != "" {
					<div class="[ actions ]">
						<a class="[ button ]" data-variant="ghost" data-size="sm" href={ templ.SafeURL(v.RemotesHref) } aria-pressed={ strconv.FormatBool(v.Remotes) }>
							Remote branches
						</a>
					</div>
				}
				if v.PullRequest != nil {
					@pullrequests.Control(v.PullRequest)
				}
			</header>
			if v.PullRequest != nil {
				@pullrequests.Strip(v.PullRequest)
			}
			if v.Notice != "" {
				<div class="[ banner ]" role="status">{ v.Notice }</div>
			}
			if len(v.Rows) == 0 && v.Working == nil {
				<div data-scroll>
					@components.Empty("No commits yet", "This repository has no history to show.")
				</div>
			} else {
				<div class="[ split-view ]" data-scroll data-wide-list>
					<nav class="[ history ] [ divide-end ]" aria-label="Commits" data-scroll>
						if v.Working != nil {
							@workingRow(v.Working)
						}
						for _, r := range v.Rows {
							@commitRow(r)
						}
						@showMore(v)
					</nav>
					@openDetail(v)
				</div>
			}
		</main>
	}
}

// gitHead is the session branch's two comparisons under its name: "vs main",
// "vs upstream" with the chip that opens the sync panel, Fetch and how long
// ago the remote was fetched. The browser's sync module paints the chips; the
// server's own comparison reads until it has a state.
templ gitHead(v PageView) {
	<div class="[ flow ] [ flow-space-3xs ] git-head" x-data="syncWatch" data-seed="history-git-seed">
		@templ.JSONScript("history-git-seed", v.Git.seed())
		<code class="[ text-sm ]">{ v.Git.Branch }</code>
		if v.Git.State == nil {
			<span class="[ color-ink-faint text-sm ]" x-data={ "syncPanel(" + strconv.Quote(v.Git.WorkspaceID) + ")" } x-show="!shown">{ v.Meta }</span>
		} else {
			<div class="[ cluster ] [ gutter-xs ] [ text-sm color-ink-muted ]" x-data={ "syncPanel(" + strconv.Quote(v.Git.WorkspaceID) + ")" } x-show="!shown">
				<span>vs <code>{ v.Git.BaseRef }</code></span>
				@gitsync.Base(v.Git.Base)
				<span>vs upstream</span>
				<span class="sync-slot">
					@gitsync.Plain(v.Git.Upstream)
				</span>
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" disabled>Fetch</button>
				<span>{ v.Git.Fetched }</span>
			</div>
		}
		<div class="[ cluster ] [ gutter-xs ] [ text-sm color-ink-muted ]" x-data={ "syncPanel(" + strconv.Quote(v.Git.WorkspaceID) + ")" } x-show="shown" style="display: none">
			<span>vs <code x-text="baseRef"></code></span>
			@code.SyncBaseState()
			<span>vs upstream</span>
			@code.SyncSlot(strconv.Quote(v.Git.WorkspaceID), `""`)
			<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-fetch x-bind:aria-disabled="fetchDisabledAttr" x-on:click="fetch" x-text="fetchLabel"></button>
			<span x-bind:data-old="freshOldAttr" x-text="fetchedPhrase"></span>
		</div>
	</div>
}

// workingRow is the uncommitted changes: a hollow dot over the branch tip,
// joined to it by a dashed line.
templ workingRow(w *WorkingRow) {
	<a class="[ commit ]" id={ "c-" + workingID } href={ templ.SafeURL(w.Href) } data-working { currentAttrs(w.Current)... } { shell.SwapLink(detailRegion)... }>
		@graph(w.Graph)
		<span class="[ subject ]">
			<span class="[ text ]">Uncommitted changes</span>
		</span>
		<span class="[ author ]">{ w.Summary }</span>
		<span class="[ when ]">now</span>
		<span class="[ hash ]"></span>
	</a>
}

templ commitRow(r Row) {
	<a class="[ commit ]" id={ "c-" + r.Short } href={ templ.SafeURL(r.Href) } { currentAttrs(r.Current)... } { shell.SwapLink(detailRegion)... }>
		@graph(r.Graph)
		<span class="[ subject ]">
			for _, ref := range r.Refs {
				@refBadge(ref, false)
			}
			<span class="[ text ]">{ r.Subject }</span>
		</span>
		<span class="[ author ]">{ r.Author }</span>
		<span class="[ when ]">{ r.When }</span>
		<span class="[ hash ]">{ r.Short }</span>
	</a>
}

// graph is the row's slice of the commit graph; the rows' slices join.
templ graph(g Graph) {
	<svg class="[ graph ]" width={ strconv.Itoa(g.Width) } height={ strconv.Itoa(RowHeight) } viewBox={ "0 0 " + strconv.Itoa(g.Width) + " " + strconv.Itoa(RowHeight) } aria-hidden="true">
		for _, l := range g.Lines {
			<path d={ l.D() } data-lane={ strconv.Itoa(l.Lane) }></path>
		}
		<circle cx={ strconv.Itoa(g.Dot.X) } cy={ strconv.Itoa(g.Dot.Y) } r={ strconv.Itoa(g.Dot.R) } data-lane={ strconv.Itoa(g.Dot.Lane) } { mergeAttrs(g.Dot.Merge)... }></circle>
	</svg>
}

// refBadge is a branch, remote branch or tag. An agent session's branch is
// marked; with link (outside a row, which is a link itself) it opens the
// session's task.
templ refBadge(ref RefView, link bool) {
	if ref.TaskHref != "" && link {
		<a class="[ ref ]" data-kind={ ref.Kind } data-session { mineAttrs(ref.Mine)... } href={ templ.SafeURL(ref.TaskHref) } title={ ref.Name + " — an agent session's branch: open its task" }>{ ref.Name }</a>
	} else if ref.TaskHref != "" {
		<span class="[ ref ]" data-kind={ ref.Kind } data-session { mineAttrs(ref.Mine)... } title={ ref.Name + " — an agent session's branch" }>{ ref.Name }</span>
	} else {
		<span class="[ ref ]" data-kind={ ref.Kind } title={ ref.Name } { headAttrs(ref.Head)... }>{ ref.Name }</span>
	}
}

// showMore is the list's tail: the link to the next page of commits, which
// htmx swaps for those commits and the next one, after the last row shown.
templ showMore(v PageView) {
	if v.MoreHref != "" {
		<div class="[ pad-l ]" id={ moreTarget }>
			<a class="[ button ]" data-size="sm" href={ templ.SafeURL(v.MoreHref) } { shell.SwapLink(moreTarget)... } { afterAttrs(v.Rows)... }>Show more</a>
		</div>
	}
}

// nextCommits answers "Show more": the commits after those shown, then the
// next "Show more".
templ nextCommits(v PageView) {
	for _, r := range v.Rows {
		@commitRow(r)
	}
	@showMore(v)
}

// detailRegion is the id of a history page's swap region: the open commit's
// (or the uncommitted changes') detail and diff. The graph stays put.
const detailRegion = "commit-detail"

// openDetail is the open commit, or the uncommitted changes, beside the graph.
templ openDetail(v PageView) {
	if v.Open != nil {
		@commitDetail(v.Open)
	} else if v.OpenWorking != nil {
		@workingDetail(v.OpenWorking)
	}
}

// workingDetail is the uncommitted changes, open: the Changes list the Code
// tab draws (grouped, with its legend), whose files open in the Code tab's
// Working scope, and the link there. Without a code browser the server's
// plain list stands in.
templ workingDetail(w *WorkingView) {
	<article class="[ frame ]" aria-label="Uncommitted changes" { shell.SwapRegion(detailRegion)... }>
		<div class="[ flow ] [ flow-space-xs pad-l divide-bottom ]">
			<h2>Uncommitted changes</h2>
			<p class="[ text-sm color-ink-muted ]">In the session's worktree, not yet committed by the agent: staged, unstaged and new files. <a href={ templ.SafeURL(w.CodeHref) }>Open in Code ▸ Working</a></p>
		</div>
		<div class="[ flow ] [ pad-l ]" data-scroll>
			if w.Diff != nil {
				<section aria-label="Changes" x-data="codeDiff" data-seed="code-diff-seed" data-code-href={ w.CodeHref }>
					@templ.JSONScript("code-diff-seed", w.Diff.Seed)
					<p class="[ text-sm color-ink-muted ]" data-ssr>{ w.Summary }</p>
					@code.LiveSummary()
				</section>
			} else {
				<p class="[ text-sm color-ink-muted ]">{ w.Summary }</p>
				<ul class="[ files ]" role="list">
					for _, f := range w.Files {
						<li data-state={ f.State }>
							<span class="[ path ]" title={ f.Path }>{ f.Path }</span>
							<span class="[ state ]">{ f.State }</span>
							if f.Binary {
								<span></span>
							} else {
								<span><span class="[ added ]">{ f.Added }</span> <span class="[ deleted ]">{ f.Deleted }</span></span>
							}
						</li>
					}
				</ul>
			}
		</div>
	</article>
}

templ commitDetail(c *CommitView) {
	<article class="[ frame ]" aria-label="Commit" { shell.SwapRegion(detailRegion)... }>
		<div class="[ flow ] [ flow-space-xs pad-l divide-bottom ]">
			<h2>{ c.Subject }</h2>
			if len(c.Refs) > 0 {
				<div class="[ cluster ] [ gutter-xs ]">
					for _, ref := range c.Refs {
						@refBadge(ref, true)
					}
				</div>
			}
			<dl class="[ facts ]">
				<dt>Commit</dt>
				<dd class="[ code ]">{ c.Hash }</dd>
				<dt>Author</dt>
				<dd>{ c.Author } <span class="[ color-ink-faint ]">{ "<" + c.Email + ">" }</span></dd>
				<dt>Date</dt>
				<dd>{ c.Date }</dd>
				if len(c.Parents) > 0 {
					<dt>{ parentLabel(len(c.Parents)) }</dt>
					<dd class="[ cluster ] [ gutter-xs ]">
						for _, p := range c.Parents {
							<a class="[ code ]" href={ templ.SafeURL(p.Href) } { shell.SwapLink(detailRegion)... }>{ p.Short }</a>
						}
					</dd>
				}
			</dl>
		</div>
		<div class="[ flow ] [ pad-l ]" data-scroll>
			if c.Body != "" {
				<p class="[ message ]">{ c.Body }</p>
			}
			<p class="[ text-sm color-ink-muted ]">{ c.Summary }</p>
			if len(c.Files) > 0 {
				<ul class="[ files ]" role="list">
					for _, f := range c.Files {
						<li>
							<span class="[ path ]" title={ f.Path }>{ f.Path }</span>
							if f.Binary {
								<span class="[ color-ink-faint ]">binary</span>
							} else {
								<span class="[ added ]">{ f.Added }</span>
								<span class="[ deleted ]">{ f.Deleted }</span>
							}
						</li>
					}
				</ul>
			}
			if c.Diff != nil {
				@historyDiff(*c.Diff)
			}
		</div>
	</article>
}

// historyDiff is the open commit's (or the uncommitted changes') diff under
// its file list: painted here, taken over by the code module's codeDiff.
templ historyDiff(v code.View) {
	<section aria-label="Diff" x-data="codeDiff" data-seed="code-diff-seed">
		@templ.JSONScript("code-diff-seed", v.Seed)
		@code.StaticDiff(v)
		@code.LiveDiff()
	</section>
}

func parentLabel(n int) string {
	if n == 1 {
		return "Parent"
	}
	return "Parents"
}

func currentAttrs(current bool) templ.Attributes {
	if current {
		return templ.Attributes{"aria-current": "page"}
	}
	return nil
}

func mergeAttrs(merge bool) templ.Attributes {
	if merge {
		return templ.Attributes{"data-merge": true}
	}
	return nil
}

func headAttrs(head bool) templ.Attributes {
	if head {
		return templ.Attributes{"data-head": true, "title": "checked out in the repository"}
	}
	return nil
}

func mineAttrs(mine bool) templ.Attributes {
	if mine {
		return templ.Attributes{"data-mine": true}
	}
	return nil
}
