package pullrequests

// PanelAttrs put the panel on the element that holds both its parts (the
// toolbar's control and the strip below the toolbar).
func PanelAttrs(p *Panel) templ.Attributes {
	if p == nil {
		return nil
	}
	return templ.Attributes{"x-data": "pullRequestPanel", "data-seed": "pull-request-seed"}
}

func shownIf(on bool) templ.Attributes {
	if on {
		return nil
	}
	return templ.Attributes{"style": "display: none"}
}

func toneAttrs(tone string) templ.Attributes {
	if tone == "" {
		return nil
	}
	return templ.Attributes{"data-tone": tone}
}

func disabledAttrs(on bool) templ.Attributes {
	if on {
		return templ.Attributes{"aria-disabled": "true"}
	}
	return nil
}

// Control is the panel's part in the toolbar: the PR's chip, linked to the
// host, and the create button (disabled, and described by the reasons, when
// something is in the way).
templ Control(p *Panel) {
	<div class="[ actions ]" { shownIf(p.Painted())... } x-show="visible">
		@chip(p.Chip)
		<button
			type="button"
			class="[ button ]"
			data-variant="primary"
			data-size="sm"
			x-ref="create"
			aria-controls="pr-form"
			aria-describedby="pr-reasons"
			aria-expanded="false"
			{ shownIf(p.OffersCreate)... }
			{ disabledAttrs(p.Blocked())... }
			x-show="offersCreate"
			x-bind:aria-disabled="disabledAttr"
			x-bind:aria-busy="busyAttr"
			x-bind:aria-expanded="expandedAttr"
			x-on:click="openForm"
			x-text="buttonLabel"
		>Create pull request</button>
	</div>
}

templ chip(c *Chip) {
	if c != nil {
		<a class="[ pr-chip ]" href={ templ.SafeURL(c.Href) } target="_blank" rel="noopener" aria-label={ c.Describe } x-show="hasChip" x-bind:href="chipHref" x-bind:aria-label="chipDescribe">
			<span class="[ badge ]" { toneAttrs(c.Tone)... } x-bind:data-tone="chipTone" x-text="chipState">{ c.State }</span>
			<span class="[ number ]" x-text="chipLabel">{ c.Label }</span>
			<span class="[ title ]" x-text="chipTitle">{ c.Title }</span>
		</a>
	} else {
		<a class="[ pr-chip ]" target="_blank" rel="noopener" style="display: none" x-show="hasChip" x-bind:href="chipHref" x-bind:aria-label="chipDescribe">
			<span class="[ badge ]" x-bind:data-tone="chipTone" x-text="chipState"></span>
			<span class="[ number ]" x-text="chipLabel"></span>
			<span class="[ title ]" x-text="chipTitle"></span>
		</a>
	}
}

// Strip is the panel's part below the toolbar: why a create cannot go ahead,
// what happened elsewhere, and the form. It carries the seed.
templ Strip(p *Panel) {
	@templ.JSONScript("pull-request-seed", p.Seed)
	<p class="[ visually-hidden ]" role="status" aria-live="polite" x-text="announcement"></p>
	<section class="[ pr-strip ]" aria-label="Pull request" { shownIf(p.Blocked())... } x-show="showsStrip">
		<ul class="[ reasons ]" id="pr-reasons" role="list">
			for _, b := range p.Blockers {
				<li data-ssr>{ b }</li>
			}
			<template x-for="b in blockers" x-bind:key="b.code">
				<li x-text="b.text"></li>
			</template>
		</ul>
		<div class="[ banner ]" data-tone="signal" role="status" style="display: none" x-show="hasNotice">
			<div class="[ repel ] [ grow ]">
				<span x-text="notice"></span>
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissNotice">Dismiss</button>
			</div>
		</div>
		<div class="[ banner ]" data-tone="danger" role="alert" style="display: none" x-show="error">
			<span x-text="errorLine"></span>
		</div>
		@form()
	</section>
}

// form is the create form: Alpine fills it from the draft when it opens.
templ form() {
	<form id="pr-form" class="[ pr-form ]" aria-label="New pull request" novalidate style="display: none" x-show="showsForm" x-on:submit.prevent="submit">
		<p class="[ text-sm color-ink-muted ]" data-span x-text="summary"></p>
		<div class="[ banner ]" data-tone="attention" data-span x-show="hasUncommitted">
			<span x-text="uncommitted"></span>
		</div>
		<div class="[ field ]" data-span>
			<label for="pr-title">Title</label>
			<input id="pr-title" autocomplete="off" x-ref="title" x-model="form.title" x-bind:readonly="creating" x-bind:aria-invalid="titleInvalid" aria-describedby="pr-title-error"/>
			<span class="[ error ]" id="pr-title-error" x-show="titleInvalid" x-text="problems.title"></span>
		</div>
		<div class="[ field ]" data-span>
			<label for="pr-body">Description</label>
			<textarea id="pr-body" x-model="form.body" x-bind:readonly="creating"></textarea>
		</div>
		<div class="[ field ]">
			<label for="pr-base">Base branch</label>
			<input id="pr-base" class="[ font-mono text-sm ]" autocomplete="off" x-model="form.baseBranch" x-bind:readonly="creating" x-bind:aria-invalid="baseInvalid" aria-describedby="pr-base-hint pr-base-error"/>
			<span class="[ hint ]" id="pr-base-hint">The branch it merges into, on origin.</span>
			<span class="[ error ]" id="pr-base-error" x-show="baseInvalid" x-text="problems.baseBranch"></span>
		</div>
		<div class="[ field ]" data-inline>
			<input id="pr-draft" type="checkbox" x-model="form.draft" x-bind:disabled="creating"/>
			<label for="pr-draft">Open as a draft</label>
		</div>
		<div class="[ banner ]" data-tone="danger" role="alert" data-span x-show="hasRefusal">
			<div class="[ flow ] [ flow-space-2xs ]">
				<p x-text="refusalLead"></p>
				<p class="[ font-mono text-xs ]" x-show="refusalReason" x-text="refusalReason"></p>
				<span class="[ code ]" x-text="refusalCode"></span>
			</div>
		</div>
		<p class="[ text-sm color-ink-muted ]" role="status" data-span x-show="creating" x-text="progress"></p>
		<div class="[ cluster ] [ gutter-xs ]" data-span>
			<button type="submit" class="[ button ]" data-variant="primary" x-bind:aria-busy="busyAttr" x-bind:aria-disabled="busyAttr" x-text="buttonLabel">Create pull request</button>
			<button type="button" class="[ button ]" data-variant="ghost" x-bind:disabled="creating" x-on:click="cancel">Cancel</button>
		</div>
	</form>
}

// Badge is a session's PR on its row or detail header, linked to the host:
// nothing when the session has none. workspace is the Alpine expression
// naming the session's workspace id.
templ Badge(workspace string) {
	<span x-data={ "pullRequestBadge(" + workspace + ")" } x-show="has" style="display: none">
		<a class="[ badge ] [ pr-badge ]" target="_blank" rel="noopener" x-bind:href="href" x-bind:data-tone="tone" x-bind:aria-label="describe" x-bind:title="describe" x-on:click.stop="stay" x-text="label"></a>
	</span>
}
