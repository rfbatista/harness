package agents

// skillFormPage is /agents/skills/new and /agents/skills/<name>/edit: a full
// page that takes the place of the tabs while the skill form is open
// (skillEditor.js). The form is on the left, What will be written (the
// server's dry run of the save) on the right, and the footer is the save
// pipeline's (save.templ). Errors are linked to their fields with
// aria-describedby.
templ skillFormPage(v View) {
	<div
		data-scroll
		data-skill-form-page
		x-bind:hidden="!skillEditing"
		if !v.SkillForm() {
			hidden
		}
	>
		<template x-if="skillEditing">
			<div class="[ skill-form ]" data-skill-form>
				<div class="[ skill-form-body ]">
					<div class="[ skill-form-head ]">
						<a href="/agents/skills" class="[ text-sm color-ink-muted ]" data-sf-back x-bind:href="sfBackHref" x-on:click="sfBackClick" x-text="sfBackLabel">{ "← Skills" }</a>
						<div class="[ cluster ]">
							<h1 x-text="skillTitle"></h1>
							<code class="[ library-path ]" data-path x-text="sfPathChip"></code>
						</div>
						<p class="[ text-sm color-ink-muted ]" x-text="sfSubtitle"></p>
						@saveAlerts()
						<div class="[ banner ]" data-sf-rename x-bind:hidden="!sfRenameShown" hidden>
							<div class="[ grow ]" x-text="sfRenameText"></div>
						</div>
						<p class="[ text-sm color-ink-muted ]" data-loading x-bind:hidden="!sfLoading" role="status">Loading the skill…</p>
						<div class="[ banner ]" data-tone="danger" data-sf-missing x-bind:hidden="!sfMissing" hidden>
							<div class="[ grow ]">
								<strong>That skill no longer exists.</strong>
								<a href="/agents/skills" x-on:click="openBundleLink">Back to the Skills tab</a>
							</div>
						</div>
						<div class="[ banner ]" data-tone="danger" data-load-error role="alert" x-bind:hidden="!sfHasLoadError" hidden>
							<div class="[ grow ]" x-text="sfLoadError"></div>
						</div>
					</div>
					<template x-if="sfReady">
						<div class="[ skill-cols ]">
							<form class="[ skill-fields ]" x-on:submit.prevent="saveEditor" novalidate>
								<fieldset>
									<legend>What it is</legend>
									<div class="[ field ]">
										<label for="sf-name">Name</label>
										<div class="[ prefixed ]">
											<span>skills/</span>
											<input
												type="text"
												id="sf-name"
												class="[ font-mono ]"
												placeholder="e.g. figma-handoff"
												spellcheck="false"
												autocomplete="off"
												aria-describedby="sf-name-hint"
												x-model="sfDraft.name"
												x-on:input="sfNameInput"
												x-bind:aria-describedby="sfNameDescribedBy"
												x-bind:aria-invalid="sfNameInvalid"
											/>
										</div>
										<span class="[ hint ]" id="sf-name-hint">Also the folder name and the <code>name:</code> in the file. Lowercase letters, digits and dashes, up to 64.</span>
										<span class="[ error ]" id="sf-name-error" data-name-error x-bind:hidden="!sfNameInvalid" hidden>
											<span x-text="fieldErrors.name"></span>
											<span x-bind:hidden="!sfTaken" hidden>
												<a data-open-taken href="/agents/skills" x-bind:href="sfTakenHref" x-on:click="openBundleLink">Open it</a>
												<span x-bind:hidden="!sfHasSuggestion" hidden>
													or pick another name, like
													<button type="button" class="[ button ]" data-size="sm" data-use-suggestion x-on:click="sfUseSuggestion"><code x-text="sfSuggestion"></code></button>.
												</span>
											</span>
										</span>
									</div>
									<div class="[ field ]">
										<label for="sf-desc">Description <span class="[ color-ink-faint ]">(required)</span></label>
										<textarea
											id="sf-desc"
											rows="4"
											aria-describedby="sf-desc-hint sf-desc-coach"
											x-model="sfDraft.description"
											x-on:input="sfChanged"
											x-bind:aria-describedby="sfDescDescribedBy"
											x-bind:aria-invalid="sfDescInvalid"
										></textarea>
										<div class="[ meter ]">
											<span id="sf-desc-hint">Agents read this to decide when to load the skill.</span>
											<span class="[ bar ]" aria-hidden="true"><i x-bind:style="sfMeterStyle"></i></span>
											<span data-meter x-bind:data-over="sfMeterOver" x-text="sfMeterText"></span>
										</div>
										<ul class="[ coach ]" id="sf-desc-coach" data-coach aria-label="What a good description does">
											<template x-for="c in sfCoach" x-bind:key="c.id">
												<li x-bind:data-coach-item="c.id" x-bind:data-state="c.state">
													<span aria-hidden="true" x-text="c.mark"></span>
													<span class="[ visually-hidden ]" x-text="c.sr"></span>
													<span x-text="c.label"></span>
												</li>
											</template>
										</ul>
										<span class="[ error ]" id="sf-desc-error" data-desc-error x-bind:hidden="!sfDescInvalid" x-text="fieldErrors.description" hidden></span>
									</div>
								</fieldset>
								<fieldset>
									<legend>Instructions</legend>
									<div class="[ field ]">
										<div class="[ repel ]">
											<label for="sf-body">SKILL.md body</label>
											<span class="[ cluster ]" style="--gutter: var(--space-xs)">
												<label class="[ visually-hidden ]" for="sf-start">Start from</label>
												<select id="sf-start" data-start-from x-bind:value="sfStart" x-on:change="sfStartChanged">
													<option value="blank">Start from: Blank</option>
													<option value="workflow">Start from: Workflow (steps + checks)</option>
													<option value="reference">Start from: Reference (rules + examples)</option>
													<option value="copy">Start from: Copy of another skill…</option>
												</select>
												<label class="[ visually-hidden ]" for="sf-copy">Skill to copy</label>
												<select id="sf-copy" data-copy-from x-bind:hidden="!sfCopying" x-on:change="sfCopyChosen" hidden>
													<option value="">Choose a skill…</option>
													<template x-for="o in sfCopyOptions" x-bind:key="o.name">
														<option x-bind:value="o.name" x-text="o.name"></option>
													</template>
												</select>
											</span>
										</div>
										<div class="[ md-editor ]">
											<div class="[ md-bar ]" role="group" aria-label="Body view">
												<button type="button" data-body-tab="write" aria-pressed="true" x-bind:aria-pressed="sfWritePressed" x-on:click="showWrite">Write</button>
												<button type="button" data-body-tab="preview" aria-pressed="false" x-bind:aria-pressed="sfPreviewPressed" x-on:click="showPreview">Preview</button>
												<span class="[ text-xs color-ink-faint ]">Markdown · the frontmatter is written for you</span>
											</div>
											<textarea id="sf-body" aria-label="Instructions" spellcheck="false" x-model="sfDraft.body" x-on:input="sfChanged" x-bind:hidden="!sfWriteShown"></textarea>
											<div class="[ prose md-preview ]" data-body-preview x-bind:hidden="!sfPreviewShown" x-effect="paintBodyPreview($el)" hidden></div>
										</div>
										<span class="[ hint ]" role="status" data-start-note x-bind:hidden="!sfHasNote" x-text="sfNote" hidden></span>
									</div>
									<div class="[ field ]">
										<span class="[ label ]" id="sf-files-label">Extra files <span class="[ color-ink-faint ]">(optional)</span></span>
										<div class="[ file-rows ]" role="list" aria-labelledby="sf-files-label" data-files>
											<template x-for="f in sfFileRows" x-bind:key="f.key">
												<div class="[ file-row ]" role="listitem" data-file-row x-bind:data-path="f.path">
													<div class="[ repel ]">
														<span class="[ cluster ]" style="--gutter: var(--space-xs)">
															<span class="[ font-mono text-xs ]" x-text="f.path"></span>
															<span class="[ badge ]" x-bind:hidden="!f.hasBadge" x-text="f.badge"></span>
															<span class="[ text-xs color-ink-faint ]" x-text="f.size"></span>
														</span>
														<span class="[ cluster ]" style="--gutter: var(--space-2xs)">
															<button type="button" class="[ button ]" data-size="sm" data-variant="ghost" data-edit-file x-bind:data-path="f.path" x-bind:hidden="f.binary" x-bind:aria-label="f.editAria" x-bind:aria-expanded="f.editing" x-on:click="sfToggleFile" x-text="f.editLabel"></button>
															<button type="button" class="[ button ]" data-size="sm" data-variant="ghost" data-remove-file x-bind:data-path="f.path" x-bind:aria-label="f.removeAria" x-on:click="sfRemoveFile">Remove</button>
														</span>
													</div>
													<textarea class="[ file-text ]" rows="8" spellcheck="false" data-file-text x-bind:data-path="f.path" x-bind:value="f.content" x-bind:aria-label="f.editAria" x-bind:hidden="!f.editing" x-on:input="sfFileInput" hidden></textarea>
												</div>
											</template>
										</div>
										<div class="[ cluster ]" style="--gutter: var(--space-xs)" x-bind:hidden="!sfNewOpen" hidden>
											<label class="[ visually-hidden ]" for="sf-new-path">Path of the new file</label>
											<input
												type="text"
												id="sf-new-path"
												class="[ font-mono ]"
												placeholder="references/checklist.md"
												spellcheck="false"
												autocomplete="off"
												aria-describedby="sf-newfile-error"
												x-model="sfNewPath"
												x-on:keydown.enter.prevent="sfNewFileAdd"
												x-on:keydown.escape.prevent="sfNewFileCancel"
											/>
											<button type="button" class="[ button ]" data-size="sm" data-add-new-file x-on:click="sfNewFileAdd">Add file</button>
											<button type="button" class="[ button ]" data-size="sm" data-variant="ghost" x-on:click="sfNewFileCancel">Cancel</button>
										</div>
										<span class="[ error ]" id="sf-newfile-error" data-newfile-error x-bind:hidden="!sfNewProblemShown" x-text="sfNewProblem" hidden></span>
										<div class="[ cluster ]" style="--gutter: var(--space-xs)">
											<button type="button" class="[ button ]" data-size="sm" data-new-file x-on:click="sfNewFileOpen">New file…</button>
											<button type="button" class="[ button ]" data-size="sm" data-upload-files x-on:click="sfChooseFiles">Upload files…</button>
											<button type="button" class="[ button ]" data-size="sm" data-upload-folder x-on:click="sfChooseFolder">Upload a folder…</button>
											<input type="file" id="sf-upload-files" multiple hidden tabindex="-1" x-on:change="sfUpload"/>
											<input type="file" id="sf-upload-folder" webkitdirectory hidden tabindex="-1" x-on:change="sfUpload"/>
										</div>
										<span class="[ hint ]" id="sf-files-hint">References, scripts and templates the instructions point to. They are copied next to <code>SKILL.md</code>.</span>
										<span class="[ hint ]" role="status" data-upload-note x-bind:hidden="!sfUploadNoteShown" x-text="sfUploadNote" hidden></span>
										<span class="[ error ]" id="sf-files-error" data-files-error x-bind:hidden="!sfFilesInvalid" x-text="fieldErrors.files" hidden></span>
									</div>
								</fieldset>
								<fieldset>
									<legend>Who gets it</legend>
									<fieldset class="[ field ]">
										<legend>Add to bundles</legend>
										<div class="[ pick-list ]" data-sf-bundle-list>
											<template x-for="r in sfBundleRows" x-bind:key="r.name">
												<label class="[ pick-row ]" data-sf-bundle-row x-bind:data-name="r.name">
													<input type="checkbox" x-bind:checked="r.checked" x-bind:data-name="r.name" x-on:change="sfToggleBundle"/>
													<span class="[ font-mono text-sm ]" x-text="r.label"></span>
													<span class="[ desc ]" x-text="r.hint"></span>
												</label>
											</template>
											<span class="[ text-sm color-ink-muted ]" x-bind:hidden="!sfNoBundles" hidden>There are no bundles yet.</span>
										</div>
									</fieldset>
									<fieldset class="[ field ]">
										<legend>Add to agents directly</legend>
										<div class="[ pick-list ]" data-sf-agent-list>
											<template x-for="r in sfAgentRows" x-bind:key="r.name">
												<label class="[ pick-row ]" data-sf-agent-row x-bind:data-name="r.name">
													<input type="checkbox" x-bind:checked="r.checked" x-bind:data-name="r.name" x-on:change="sfToggleAgent"/>
													<span class="[ font-mono text-sm ]" x-text="r.label"></span>
												</label>
											</template>
											<span class="[ text-sm color-ink-muted ]" x-bind:hidden="!sfNoAgents" hidden>There are no agents yet.</span>
										</div>
									</fieldset>
									<p class="[ summary-line ]" data-sf-reach role="status" x-text="sfReachText"></p>
								</fieldset>
								@reviewPanel()
							</form>
							<aside class="[ skill-preview ]" data-preview aria-label="What will be written" x-bind:aria-busy="sfPreviewBusy">
								<div class="[ repel ]">
									<h2>What will be written</h2>
									<span class="[ text-xs color-ink-faint ]" data-preview-count x-text="sfPreviewCount"></span>
								</div>
								<p class="[ text-xs color-ink-muted ]" data-preview-hint role="status" x-bind:hidden="sfHasPreview" x-text="sfPreviewHint"></p>
								<div class="[ flow ] [ flow-space-s ]" data-preview-files x-bind:data-stale="sfPreviewStale">
									<template x-for="f in sfPreviewFiles" x-bind:key="f.key">
										<div class="[ preview-file ]" data-preview-file x-bind:data-path="f.path">
											<div class="[ repel ] [ preview-file-head ]">
												<code class="[ font-mono text-xs ]" x-text="f.path"></code>
												<span class="[ badge ]" x-bind:data-badge="f.badge" x-text="f.badge"></span>
											</div>
											<pre class="[ preview-text ]" data-preview-text x-bind:hidden="!f.isText" x-text="f.text" hidden></pre>
											<div class="[ diff ]" tabindex="0" role="group" aria-label="Changed lines" x-bind:hidden="!f.isDiff" hidden>
												<template x-for="l in f.lines" x-bind:key="l.key">
													<div data-diff-line x-bind:data-kind="l.kind"><span class="[ mark ]" x-text="l.mark"></span><span x-text="l.text"></span></div>
												</template>
											</div>
										</div>
									</template>
								</div>
							</aside>
						</div>
					</template>
				</div>
				@saveFooter()
			</div>
		</template>
	</div>
}
