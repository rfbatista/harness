package agents

// deleteDialog is the delete confirmation (deleteUi.js): what the item
// reaches, the name to type, what Undo can and cannot do, and the conflict
// banner when a file changed on disk since the page read it. An alertdialog
// in a div, not a native modal <dialog>: deleteUi.js keeps the focus inside
// it, and Escape closes it.
templ deleteDialog() {
	<template x-if="del">
		<div class="[ confirm-scrim ]" data-delete-scrim x-on:keydown="deleteKey" x-on:mousedown="deleteScrimDown">
			<div class="[ confirm-dialog ]" role="alertdialog" aria-modal="true" aria-labelledby="delete-title" aria-describedby="delete-intro delete-note" data-delete-dialog x-init="focusDelete($el)">
				<div class="[ confirm-body ]">
					<h2 id="delete-title" x-text="del.title"></h2>
					<div class="[ flow ] [ flow-space-xs ]">
						<p class="[ text-sm ]" id="delete-intro" x-text="del.intro"></p>
						<code class="[ library-path ]" data-delete-path x-text="del.path"></code>
					</div>
					<template x-for="g in del.groups" x-bind:key="g.key">
						<div class="[ confirm-group ]" data-delete-group x-bind:data-group="g.key">
							<strong class="[ text-sm ]" x-text="g.label"></strong>
							<ul class="[ confirm-items ]" role="list">
								<template x-for="i in g.items" x-bind:key="i.name">
									<li class="[ chip ] [ font-mono ]" data-delete-item x-text="i.name"></li>
								</template>
							</ul>
						</div>
					</template>
					<p class="[ text-sm ]" data-delete-total x-bind:hidden="!delHasTotal" x-text="del.total"></p>
					<p class="[ text-sm color-ink-muted ]" data-delete-nothing x-bind:hidden="!delNothing" x-text="del.nothing"></p>
					<div class="[ field ]">
						<label for="delete-name">Type <code x-text="del.typed"></code> to confirm</label>
						<input type="text" id="delete-name" class="[ font-mono ]" data-delete-name autocomplete="off" autocapitalize="off" spellcheck="false" x-model="delTyped" x-on:keydown.enter="confirmDelete"/>
					</div>
					<p class="[ text-xs color-ink-muted ]" id="delete-note" data-delete-note x-text="del.note"></p>
					<div class="[ flow ] [ flow-space-s ]" role="alert" data-delete-alerts>
						<template x-if="delView.conflict">
							<div class="[ banner ]" data-tone="attention" data-delete-conflict>
								<div class="[ flow ] [ flow-space-xs grow ]">
									<strong x-text="delConflictTitle"></strong>
									<span>Nothing was deleted. What changed on disk:</span>
									@diffFiles("delConflictFiles")
									<span class="[ text-sm ]" x-text="delConflictNote"></span>
									<div class="[ cluster ]">
										<button type="button" class="[ button ]" data-size="sm" data-delete-reload x-on:click="delReload">Reload</button>
										<button type="button" class="[ button ]" data-size="sm" data-variant="danger" data-delete-overwrite x-bind:disabled="isBroken" x-on:click="delOverwrite">Delete anyway</button>
									</div>
								</div>
							</div>
						</template>
						<template x-if="isBroken">
							<div class="[ banner ]" data-tone="danger" data-delete-blocked>
								<span x-text="delBlockedNote"></span>
							</div>
						</template>
						<template x-if="delHasError">
							<div class="[ banner ]" data-tone="danger" data-delete-error>
								<div class="[ flow ] [ flow-space-3xs grow ]">
									<span x-text="delErrorText"></span>
									<span class="[ code ]"><span x-text="delErrorCode"></span> · <span x-text="delErrorNext"></span></span>
								</div>
							</div>
						</template>
					</div>
				</div>
				<div class="[ confirm-foot ]">
					<button type="button" class="[ button ]" data-variant="ghost" data-delete-cancel x-on:click="cancelDelete">Cancel</button>
					<button type="button" class="[ button ]" data-variant="danger" data-delete-confirm x-bind:disabled="delNotReady" x-bind:aria-busy="delBusy" x-on:click="confirmDelete" x-text="delButtonLabel"></button>
				</div>
			</div>
		</div>
	</template>
}
