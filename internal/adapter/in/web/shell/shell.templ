package shell

// Document is the HTML page: head, styles, the client bundle, then the body.
templ Document(f Frame) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ f.DocumentTitle() }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:wght@400;500;700&family=Atkinson+Hyperlegible+Next:wght@400;500;700&display=swap"/>
			<link rel="stylesheet" href={ f.CSS }/>
			if f.ClientCSS != "" {
				<link rel="stylesheet" href={ f.ClientCSS }/>
			}
			<script type="module" src={ f.JS }></script>
			if f.ClientJS != "" {
				<script type="module" src={ f.ClientJS }></script>
			}
		</head>
		<body>
			if !f.Built {
				<div class="[ banner ] [ pad-m ]" data-tone="attention" role="alert">
					<span>The web client is not built, so this page has no styles or interactivity. Run <code>make web</code> and reload.</span>
				</div>
			}
			{ children... }
		</body>
	</html>
}

// AppShell is the app layout: the top bar, the task rail, the page's main
// region, and the stream bar.
templ AppShell(f Frame) {
	switch ModeOf(ctx) {
		case ModeFragment:
			@pageFragment(f) {
				{ children... }
			}
		case ModeShell:
			<title>{ f.PageTitle() }</title>
			@shellBody(f) {
				{ children... }
			}
		default:
			@Document(f) {
				@shellBody(f) {
					{ children... }
				}
			}
	}
}

// pageFragment is the answer to a click between two pages of one frame: the
// page's <main> and the out-of-band items that the frame shows for this page
// (ADR 0064). The title carries no unread count: the browser adds it.
templ pageFragment(f Frame) {
	<title>{ f.PageTitle() }</title>
	@frameState(f, true)
	{ children... }
	@streamBar(f.Live, f.Hints, true)
}

// frameState carries what the frame shows for the current page and that the
// browser applies to the rail: the open project page and the open task.
templ frameState(f Frame, oob bool) {
	<div id="frame-state" hidden data-page={ f.Rail.Page } data-task={ f.Rail.Current } { reportsFeedAttrs(f.Rail.ReportsFeed)... } { oobAttrs(oob)... }></div>
}

// shellBody is the app layout: the top bar, the task rail, the page's main
// region, and the stream bar. It is the one element that a click to another
// frame swaps.
templ shellBody(f Frame) {
	<div id="app-shell" class="[ app-shell ]" { boostAttrs()... } { noRailAttrs(f.NoRail)... }>
		<a class="[ skip-link ] [ button ]" data-size="sm" href="#main">Skip to content</a>
		@topBar(f)
		if !f.NoRail {
			@taskRail(f)
		}
		{ children... }
		@ownerPanelMount(f)
		@frameState(f, false)
		@streamBar(f.Live, f.Hints, false)
	</div>
}

// ownerPanelMount is where the product owner's docked panel opens, beside
// <main> (ADR 0115). The browser draws it (a client-rendered island, so there is
// nothing for the server to render) and keeps it across a click within the
// project, since only <main> swaps. It is left out where there is no project, or
// where the islands are not built.
templ ownerPanelMount(f Frame) {
	if f.Island != nil && f.Top.Current != "" {
		<div data-island="owner-panel" data-island-rendered="false"></div>
		@propsScript("owner-panel", f.OwnerPanelProps())
	}
}

// topBar is the header: the Tasks button, then the React top bar island, which
// the server rendered (the brand, the project picker, the pages, the bell). The
// Tasks button stays here: below 48rem it opens the rail as a drawer (a link to
// the board without JavaScript).
templ topBar(f Frame) {
	<header class="[ topbar ]">
		if f.Rail.Seed != nil && !f.NoRail && f.RailIsland != nil {
			@tasksToggle(f)
		}
		if f.Island != nil {
			<div data-island="top-bar" { islandRenderedAttrs(f.Island.Failed)... }>
				@templ.Raw(f.Island.HTML)
			</div>
			@propsScript("top-bar", f.Island.Props)
		}
	</header>
}

// NotificationLiveRow is one notification as the browser renders it, in an
// x-for over `rows` (the inbox page): its fields are
// web/src/modules/notifications/presentation/view.js's Row. The inbox page
// passes actions: a sessions_interrupted item's Resume all interrupted button
// lives there only.
templ NotificationLiveRow(actions bool) {
	<article class="[ notification ]" data-layout="ledger" data-compact?={ !actions } x-bind:data-kind="row.kind" x-bind:data-level="row.level" x-bind:data-state="row.state">
		<span class="[ marker ]" aria-hidden="true"></span>
		<div class="[ who ]">
			<span class="[ avatar ]" aria-hidden="true" x-bind:data-who="row.whoKind" x-bind:data-agent="row.whoSlot" x-text="row.whoInitial"></span>
			<span class="[ name ]" x-text="row.whoName"></span>
			<span class="[ mode ]" x-show="row.hasWhoMode" x-text="row.whoMode"></span>
		</div>
		<div class="[ what ]">
			<a class="[ title ]" data-item x-bind:href="row.href" x-bind:data-id="row.id" x-bind:aria-label="row.label" x-on:click="openItem">
				<span class="[ icon ]" aria-hidden="true"></span>
				<span class="[ text ]">
					<template x-if="row.hasVerb">
						<span><span class="[ verb ]" x-text="row.verb"></span> <span class="[ object ]" x-show="row.hasObject" x-bind:data-code="row.objectIsCode" x-text="row.objectText"></span></span>
					</template>
					<template x-if="!row.hasVerb">
						<span class="[ verb ]" x-text="row.title"></span>
					</template>
				</span>
			</a>
			<p class="[ where ]">
				<span class="[ project ]" x-text="row.project"></span>
				<template x-if="row.hasTask">
					<span class="[ task ]" x-text="row.task"></span>
				</template>
				<template x-if="row.hasRepository">
					<span class="[ repo ]" x-text="row.repository"></span>
				</template>
			</p>
		</div>
		<div class="[ notes ]">
			<p class="[ body ]" x-show="row.showBody" x-text="row.body"></p>
			<ul role="list" class="[ interrupted-sessions ]" x-show="row.hasListed">
				<template x-for="s in row.listed" x-bind:key="s.key">
					<li x-bind:data-state="s.state">
						<a x-bind:href="s.href" x-text="s.label"></a>
						<span class="[ state ]" x-text="s.stateWord"></span>
					</li>
				</template>
			</ul>
			<ul role="list" class="[ interrupted-sessions ]" x-show="row.hasSessions">
				<template x-for="s in row.sessions" x-bind:key="s.key">
					<li x-bind:data-state="s.state">
						<a x-bind:href="s.href" x-text="s.label"></a>
						<span class="[ state ]" x-text="s.state"></span>
						<span class="[ reason ]" x-show="s.hasReason" x-text="s.reason"></span>
					</li>
				</template>
			</ul>
			if actions {
				<button type="button" class="[ button ] [ acknowledge ]" data-size="sm" x-show="row.canAcknowledge" x-bind:data-id="row.id" x-bind:aria-label="row.ackLabel" x-on:click="acknowledge">Acknowledge</button>
				<button type="button" class="[ button ] [ resume-all ]" data-size="sm" x-show="row.canResumeAll" x-bind:data-id="row.id" x-bind:disabled="resuming" x-bind:aria-busy="resuming" x-on:click="resumeAll">Resume all interrupted</button>
			}
		</div>
		<div class="[ when ]">
			<time x-bind:datetime="row.at" x-bind:title="row.fullDate"><span x-text="row.clock"></span><span class="[ age ]" x-text="row.age"></span></time>
			<span class="[ standing ]" x-show="row.hasStatus" x-bind:data-tone="row.statusTone" x-text="row.statusText"></span>
		</div>
		<button type="button" class="[ button ] [ mark ]" data-variant="ghost" data-size="sm" x-show="row.unread" x-bind:data-id="row.id" x-bind:aria-label="row.markLabel" x-on:click="markOne">Mark read</button>
	</article>
}

// NotificationStack is a folded stack of settled repeats (ADR 0097): a
// native details element whose summary is the ledger row of the whole run
// (who, "asked to push 6 times", the outcomes counted), and whose body lists
// the notifications themselves. It lives in a notificationsPage x-for over
// `stack`, with `head` (the summary row) and `rows` (the members).
templ NotificationStack() {
	<details class="[ stack ]">
		<template x-for="row in stack.head" x-bind:key="row.key">
			<summary x-bind:aria-label="row.label">
				<article class="[ notification ]" data-layout="ledger" x-bind:data-kind="row.kind" data-level="action" data-state="settled">
					<span class="[ marker ]" aria-hidden="true"></span>
					<div class="[ who ]">
						<span class="[ avatar ]" aria-hidden="true" x-bind:data-who="row.whoKind" x-bind:data-agent="row.whoSlot" x-text="row.whoInitial"></span>
						<span class="[ name ]" x-text="row.whoName"></span>
						<span class="[ mode ]" x-show="row.hasWhoMode" x-text="row.whoMode"></span>
					</div>
					<div class="[ what ]">
						<span class="[ title ]">
							<span class="[ icon ]" aria-hidden="true"></span>
							<span class="[ text ]"><span class="[ count ]" x-text="row.count"></span> <span class="[ verb ]" x-text="row.verb"></span> <span class="[ object ]" x-show="row.hasObject" x-bind:data-code="row.objectIsCode" x-text="row.objectText"></span></span>
						</span>
						<p class="[ where ]">
							<span class="[ project ]" x-text="row.project"></span>
							<template x-if="row.hasTask">
								<span class="[ task ]" x-text="row.task"></span>
							</template>
							<template x-if="row.hasRepository">
								<span class="[ repo ]" x-text="row.repository"></span>
							</template>
						</p>
					</div>
					<div class="[ notes ]"></div>
					<div class="[ when ]">
						<time x-bind:datetime="row.at" x-bind:title="row.fullDate"><span x-text="row.clock"></span><span class="[ age ]" x-text="row.age"></span></time>
						<span class="[ standing ]" data-tone="quiet" x-text="row.statusText"></span>
					</div>
					<span class="[ chev ]" aria-hidden="true"></span>
				</article>
			</summary>
		</template>
		<ul role="list" class="[ notification-list ]">
			<template x-for="row in stack.rows" x-bind:key="row.id">
				<li>
					@NotificationLiveRow(true)
				</li>
			</template>
		</ul>
	</details>
}

// tasksToggle is the phone's way to the rail: the Tasks button, with how many
// tasks need the person. A React island that shares its state with the rail's
// (the mount is the link itself, a link to the board without JavaScript).
templ tasksToggle(f Frame) {
	{{ isl := f.RailIsland(f) }}
	<a
		class="[ button ] [ tasks-toggle ]"
		data-variant="ghost"
		href={ templ.SafeURL(f.Rail.BoardHref) }
		aria-controls="rail"
		aria-haspopup="dialog"
		aria-expanded="false"
		data-island="tasks-toggle"
		{ islandRenderedAttrs(isl.ToggleFailed)... }
	>
		@templ.Raw(isl.ToggleHTML)
	</a>
	@propsScript("tasks-toggle", isl.ToggleProps)
}

// taskRail is the column beside the page: the skip link, New task, the
// project's pages and its tasks in status groups. The server renders the
// groups inside [data-ssr], folded as the rail_collapsed cookie says;
// tasksRail renders the same groups live from its store (with the filter
// and Needs you) and removes the server copy, so a task an agent creates or
// moves regroups the rail as it happens. Below 48rem it is a drawer.
templ taskRail(f Frame) {
	{{ r := f.Rail }}
	if r.Seed != nil && f.RailIsland != nil {
		{{ isl := f.RailIsland(f) }}
		<div class="[ rail ]" id="rail" data-island="rail" data-current-task={ r.Current } { islandRenderedAttrs(isl.Failed)... }>
			@templ.Raw(isl.HTML)
		</div>
		@railPropsScript(isl.Props)
		<div id="rail-feed" hidden { railFeedAttrs(r)... }></div>
		<div class="[ scrim ]"></div>
	} else {
		<div class="[ rail ]" id="rail">
			if len(f.Top.Projects) > 0 {
				<p class="[ note ]">Choose a project in the picker above to see its tasks.</p>
			}
		</div>
	}
}

// streamBar shows whether the page is live. The page's feed reports its
// status as a `feed-status` window event; streamStatus listens for it.
templ streamBar(live bool, hints []Hint, oob bool) {
	<footer id="stream-bar" class="[ stream-bar ]" aria-live="polite" { oobAttrs(oob)... }>
		if live {
			<span class="[ status ]" data-state="reconnecting" x-data="streamStatus" x-on:feed-status.window="update" x-bind:data-state="state" x-text="label">connecting</span>
		}
		<span class="[ visually-hidden ]" x-data="streamAnnouncer" x-on:rail-announce.window="say" x-text="text"></span>
		<span class="[ keys ]" x-data="streamHints" x-on:stream-hints.window="set">
			if hints == nil {
				<span x-show="!overridden"><kbd>J</kbd><kbd>K</kbd> move</span>
			}
			for _, h := range hints {
				<span x-show="!overridden">
					for _, k := range h.Keys {
						<kbd>{ k }</kbd>
					}
					{ h.Label }
				</span>
			}
			<template x-for="h in hints" x-bind:key="h.key">
				<span>
					<template x-for="k in h.keys" x-bind:key="k">
						<kbd x-text="k"></kbd>
					</template>
					<span x-text="h.label"></span>
				</span>
			</template>
		</span>
		<span class="[ cluster ] [ gutter-2xs ]" x-data="themeToggle">
			<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-pressed="isLight" x-on:click="light">Light</button>
			<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-pressed="isDark" x-on:click="dark">Dark</button>
			<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-pressed="isSystem" x-on:click="system">System</button>
		</span>
	</footer>
}
