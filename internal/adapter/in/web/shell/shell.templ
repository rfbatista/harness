package shell

import "strconv"

// Document is the HTML page: head, styles, the client bundle, then the body.
templ Document(f Frame) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ f.DocumentTitle() }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:wght@400;500;700&family=Atkinson+Hyperlegible+Next:wght@400;500;700&display=swap"/>
			<link rel="stylesheet" href={ f.CSS }/>
			if f.ClientCSS != "" {
				<link rel="stylesheet" href={ f.ClientCSS }/>
			}
			<script type="module" src={ f.JS }></script>
			if f.ClientJS != "" {
				<script type="module" src={ f.ClientJS }></script>
			}
		</head>
		<body>
			if !f.Built {
				<div class="[ banner ] [ pad-m ]" data-tone="attention" role="alert">
					<span>The web client is not built, so this page has no styles or interactivity. Run <code>make web</code> and reload.</span>
				</div>
			}
			{ children... }
		</body>
	</html>
}

// AppShell is the app layout: the top bar, the task rail, the page's main
// region, and the stream bar.
templ AppShell(f Frame) {
	switch ModeOf(ctx) {
		case ModeFragment:
			@pageFragment(f) {
				{ children... }
			}
		case ModeShell:
			<title>{ f.PageTitle() }</title>
			@shellBody(f) {
				{ children... }
			}
		default:
			@Document(f) {
				@shellBody(f) {
					{ children... }
				}
			}
	}
}

// pageFragment is the answer to a click between two pages of one frame: the
// page's <main> and the out-of-band items that the frame shows for this page
// (ADR 0064). The title carries no unread count: the browser adds it.
templ pageFragment(f Frame) {
	<title>{ f.PageTitle() }</title>
	@frameState(f, true)
	{ children... }
	@streamBar(f.Live, f.Hints, true)
}

// frameState carries what the frame shows for the current page and that the
// browser applies to the rail: the open project page and the open task.
templ frameState(f Frame, oob bool) {
	<div id="frame-state" hidden data-page={ f.Rail.Page } data-task={ f.Rail.Current } { reportsFeedAttrs(f.Rail.ReportsFeed)... } { oobAttrs(oob)... }></div>
}

// shellBody is the app layout: the top bar, the task rail, the page's main
// region, and the stream bar. It is the one element that a click to another
// frame swaps.
templ shellBody(f Frame) {
	<div id="app-shell" class="[ app-shell ]" { boostAttrs()... } { noRailAttrs(f.NoRail)... }>
		<a class="[ skip-link ] [ button ]" data-size="sm" href="#main">Skip to content</a>
		@topBar(f)
		if !f.NoRail {
			@taskRail(f)
		}
		{ children... }
		@ownerPanelMount(f)
		@frameState(f, false)
		@streamBar(f.Live, f.Hints, false)
	</div>
}

// ownerPanelMount is where the product owner's docked panel opens, beside
// <main> (ADR 0115). The browser draws it (a client-rendered island, so there is
// nothing for the server to render) and keeps it across a click within the
// project, since only <main> swaps. It is left out where there is no project, or
// where the islands are not built.
templ ownerPanelMount(f Frame) {
	if f.Island != nil && f.Top.Current != "" {
		<div data-island="owner-panel" data-island-rendered="false"></div>
		@propsScript("owner-panel", f.OwnerPanelProps())
	}
}

// topBar is the header: the Tasks button, then the React top bar island, which
// the server rendered (the brand, the project picker, the pages, the bell). The
// Tasks button stays here: below 48rem it opens the rail as a drawer (a link to
// the board without JavaScript).
templ topBar(f Frame) {
	<header class="[ topbar ]">
		if f.Rail.Seed != nil && !f.NoRail {
			@tasksToggle(f.Rail)
		}
		if f.Island != nil {
			<div data-island="top-bar" { islandRenderedAttrs(f.Island.Failed)... }>
				@templ.Raw(f.Island.HTML)
			</div>
			@propsScript("top-bar", f.Island.Props)
		}
	</header>
}

// NotificationLiveRow is one notification as the browser renders it, in an
// x-for over `rows` (the inbox page): its fields are
// web/src/modules/notifications/presentation/view.js's Row. The inbox page
// passes actions: a sessions_interrupted item's Resume all interrupted button
// lives there only.
templ NotificationLiveRow(actions bool) {
	<article class="[ notification ]" data-layout="ledger" data-compact?={ !actions } x-bind:data-kind="row.kind" x-bind:data-level="row.level" x-bind:data-state="row.state">
		<span class="[ marker ]" aria-hidden="true"></span>
		<div class="[ who ]">
			<span class="[ avatar ]" aria-hidden="true" x-bind:data-who="row.whoKind" x-bind:data-agent="row.whoSlot" x-text="row.whoInitial"></span>
			<span class="[ name ]" x-text="row.whoName"></span>
			<span class="[ mode ]" x-show="row.hasWhoMode" x-text="row.whoMode"></span>
		</div>
		<div class="[ what ]">
			<a class="[ title ]" data-item x-bind:href="row.href" x-bind:data-id="row.id" x-bind:aria-label="row.label" x-on:click="openItem">
				<span class="[ icon ]" aria-hidden="true"></span>
				<span class="[ text ]">
					<template x-if="row.hasVerb">
						<span><span class="[ verb ]" x-text="row.verb"></span> <span class="[ object ]" x-show="row.hasObject" x-bind:data-code="row.objectIsCode" x-text="row.objectText"></span></span>
					</template>
					<template x-if="!row.hasVerb">
						<span class="[ verb ]" x-text="row.title"></span>
					</template>
				</span>
			</a>
			<p class="[ where ]">
				<span class="[ project ]" x-text="row.project"></span>
				<template x-if="row.hasTask">
					<span class="[ task ]" x-text="row.task"></span>
				</template>
				<template x-if="row.hasRepository">
					<span class="[ repo ]" x-text="row.repository"></span>
				</template>
			</p>
		</div>
		<div class="[ notes ]">
			<p class="[ body ]" x-show="row.showBody" x-text="row.body"></p>
			<ul role="list" class="[ interrupted-sessions ]" x-show="row.hasListed">
				<template x-for="s in row.listed" x-bind:key="s.key">
					<li x-bind:data-state="s.state">
						<a x-bind:href="s.href" x-text="s.label"></a>
						<span class="[ state ]" x-text="s.stateWord"></span>
					</li>
				</template>
			</ul>
			<ul role="list" class="[ interrupted-sessions ]" x-show="row.hasSessions">
				<template x-for="s in row.sessions" x-bind:key="s.key">
					<li x-bind:data-state="s.state">
						<a x-bind:href="s.href" x-text="s.label"></a>
						<span class="[ state ]" x-text="s.state"></span>
						<span class="[ reason ]" x-show="s.hasReason" x-text="s.reason"></span>
					</li>
				</template>
			</ul>
			if actions {
				<button type="button" class="[ button ] [ acknowledge ]" data-size="sm" x-show="row.canAcknowledge" x-bind:data-id="row.id" x-bind:aria-label="row.ackLabel" x-on:click="acknowledge">Acknowledge</button>
				<button type="button" class="[ button ] [ resume-all ]" data-size="sm" x-show="row.canResumeAll" x-bind:data-id="row.id" x-bind:disabled="resuming" x-bind:aria-busy="resuming" x-on:click="resumeAll">Resume all interrupted</button>
			}
		</div>
		<div class="[ when ]">
			<time x-bind:datetime="row.at" x-bind:title="row.fullDate"><span x-text="row.clock"></span><span class="[ age ]" x-text="row.age"></span></time>
			<span class="[ standing ]" x-show="row.hasStatus" x-bind:data-tone="row.statusTone" x-text="row.statusText"></span>
		</div>
		<button type="button" class="[ button ] [ mark ]" data-variant="ghost" data-size="sm" x-show="row.unread" x-bind:data-id="row.id" x-bind:aria-label="row.markLabel" x-on:click="markOne">Mark read</button>
	</article>
}

// NotificationStack is a folded stack of settled repeats (ADR 0097): a
// native details element whose summary is the ledger row of the whole run
// (who, "asked to push 6 times", the outcomes counted), and whose body lists
// the notifications themselves. It lives in a notificationsPage x-for over
// `stack`, with `head` (the summary row) and `rows` (the members).
templ NotificationStack() {
	<details class="[ stack ]">
		<template x-for="row in stack.head" x-bind:key="row.key">
			<summary x-bind:aria-label="row.label">
				<article class="[ notification ]" data-layout="ledger" x-bind:data-kind="row.kind" data-level="action" data-state="settled">
					<span class="[ marker ]" aria-hidden="true"></span>
					<div class="[ who ]">
						<span class="[ avatar ]" aria-hidden="true" x-bind:data-who="row.whoKind" x-bind:data-agent="row.whoSlot" x-text="row.whoInitial"></span>
						<span class="[ name ]" x-text="row.whoName"></span>
						<span class="[ mode ]" x-show="row.hasWhoMode" x-text="row.whoMode"></span>
					</div>
					<div class="[ what ]">
						<span class="[ title ]">
							<span class="[ icon ]" aria-hidden="true"></span>
							<span class="[ text ]"><span class="[ count ]" x-text="row.count"></span> <span class="[ verb ]" x-text="row.verb"></span> <span class="[ object ]" x-show="row.hasObject" x-bind:data-code="row.objectIsCode" x-text="row.objectText"></span></span>
						</span>
						<p class="[ where ]">
							<span class="[ project ]" x-text="row.project"></span>
							<template x-if="row.hasTask">
								<span class="[ task ]" x-text="row.task"></span>
							</template>
							<template x-if="row.hasRepository">
								<span class="[ repo ]" x-text="row.repository"></span>
							</template>
						</p>
					</div>
					<div class="[ notes ]"></div>
					<div class="[ when ]">
						<time x-bind:datetime="row.at" x-bind:title="row.fullDate"><span x-text="row.clock"></span><span class="[ age ]" x-text="row.age"></span></time>
						<span class="[ standing ]" data-tone="quiet" x-text="row.statusText"></span>
					</div>
					<span class="[ chev ]" aria-hidden="true"></span>
				</article>
			</summary>
		</template>
		<ul role="list" class="[ notification-list ]">
			<template x-for="row in stack.rows" x-bind:key="row.id">
				<li>
					@NotificationLiveRow(true)
				</li>
			</template>
		</ul>
	</details>
}

// tasksToggle is the phone's way to the rail: the Tasks button, with how many
// tasks need the person.
templ tasksToggle(r Rail) {
	<a
		class="[ button ] [ tasks-toggle ]"
		data-variant="ghost"
		href={ templ.SafeURL(r.BoardHref) }
		aria-controls="rail"
		aria-haspopup="dialog"
		aria-expanded="false"
		x-data="tasksRailToggle"
		x-bind:aria-expanded="expanded"
		x-on:click="open"
	>
		@icon("rail")
		Tasks
		<span class="[ badge ]" data-tone="attention" x-show="hasNeedsYou" { shownIf(r.NeedsYou() > 0)... }>
			<span x-text="needsYouCount">{ strconv.Itoa(r.NeedsYou()) }</span><span class="[ visually-hidden ]">{ " need you" }</span>
		</span>
	</a>
}

// taskRail is the column beside the page: the skip link, New task, the
// project's pages and its tasks in status groups. The server renders the
// groups inside [data-ssr], folded as the rail_collapsed cookie says;
// tasksRail renders the same groups live from its store (with the filter
// and Needs you) and removes the server copy, so a task an agent creates or
// moves regroups the rail as it happens. Below 48rem it is a drawer.
templ taskRail(f Frame) {
	{{ r := f.Rail }}
	if r.Seed != nil {
		@templ.JSONScript("rail-seed", r.Seed)
	}
	<div class="[ rail ]" id="rail" { railAttrs(r)... }>
		if r.Seed != nil {
			<div class="[ drawer-head ]">
				<span class="[ truncate ]">{ f.ProjectName() }</span>
				<button type="button" class="[ button ]" data-variant="ghost" data-icon aria-label="Close" x-on:click="closeDrawer">
					@icon("close")
				</button>
			</div>
		}
		if r.NewTaskHref != "" {
			<a class="[ button ]" data-size="sm" href={ templ.SafeURL(r.NewTaskHref) }>
				@icon("plus")
				New task
			</a>
			@projectNav(r)
		} else if len(f.Top.Projects) > 0 {
			<p class="[ note ]">Choose a project in the picker above to see its tasks.</p>
		}
		if r.Seed != nil {
			<nav class="[ nav ]" aria-label="Tasks">
				<div x-ignore data-ssr class="[ contents ]">
					@railServerCopy(r)
				</div>
				<template x-if="live">
					@railLiveCopy()
				</template>
			</nav>
		}
	</div>
	if r.Seed != nil {
		<div class="[ scrim ]" x-data="tasksRailToggle" x-bind:data-open="openAttr" x-on:click="close"></div>
	}
}

// projectNav is the project's pages; the open one is aria-current.
templ projectNav(r Rail) {
	<nav class="[ nav ]" aria-label="Project">
		<ul role="list">
			if r.BoardHref != "" {
				<li data-page="board">
					<a href={ templ.SafeURL(r.BoardHref) } { currentAttrs(r.Page == PageBoard)... }>
						@icon("board")
						<span class="[ label ]">Board</span>
					</a>
				</li>
			}
			if r.CodeHref != "" {
				<li data-page="code">
					<a href={ templ.SafeURL(r.CodeHref) } { currentAttrs(r.Page == PageCode)... }>
						@icon("code")
						<span class="[ label ]">Code</span>
					</a>
				</li>
			}
			if r.Services.Href != "" {
				<li data-page="services" x-data="servicesNavCount" data-project-id={ r.Services.ProjectID } data-running-services={ strconv.Itoa(r.Services.Running) }>
					<a href={ templ.SafeURL(r.Services.Href) } { currentAttrs(r.Page == PageServices)... }>
						@icon("services")
						<span class="[ label ]">Services</span>
						<span class="[ badge ]" data-tone="signal" data-nav-running role="status" x-show="badgeShown" { shownIf(r.Services.Running > 0)... }>
							<span x-text="badgeText">{ r.Services.Badge() }</span><span class="[ visually-hidden ]">{ " running" }</span>
						</span>
					</a>
				</li>
			}
			if r.ReviewsHref != "" {
				<li data-page="reviews">
					<a href={ templ.SafeURL(r.ReviewsHref) } { currentAttrs(r.Page == PageReviews)... }>
						@icon("review")
						<span class="[ label ]">Review requests</span>
						<span class="[ badge ]" data-tone="attention" x-show="hasReviews" { shownIf(r.Reviews > 0)... }>
							<span x-text="reviewsCount">{ strconv.Itoa(r.Reviews) }</span><span class="[ visually-hidden ]">{ " waiting on you" }</span>
						</span>
					</a>
				</li>
			}
			if r.DocumentsHref != "" {
				<li data-page="documents">
					<a href={ templ.SafeURL(r.DocumentsHref) } { currentAttrs(r.Page == PageDocuments)... }>
						@icon("document")
						<span class="[ label ]">Documents</span>
					</a>
				</li>
			}
			if r.DesignHref != "" {
				<li data-page="design">
					<a href={ templ.SafeURL(r.DesignHref) } { currentAttrs(r.Page == PageDesign)... }>
						@icon("design")
						<span class="[ label ]">Design assets</span>
					</a>
				</li>
			}
			if r.DesignSystemHref != "" {
				<li data-page="design-system">
					<a href={ templ.SafeURL(r.DesignSystemHref) } { currentAttrs(r.Page == PageDesignSystem)... }>
						@icon("design-system")
						<span class="[ label ]">Design systems</span>
						<span class="[ badge ]" data-tone="attention" data-nav-proposals title="Proposals waiting on you" aria-label="Proposals waiting on you" { shownIf(r.DesignSystemProposals > 0)... }>{ strconv.Itoa(r.DesignSystemProposals) }</span>
					</a>
				</li>
			}
			if r.UsageHref != "" {
				<li data-page="usage">
					<a href={ templ.SafeURL(r.UsageHref) } { currentAttrs(r.Page == PageUsage)... }>
						@icon("usage")
						<span class="[ label ]">Usage</span>
					</a>
				</li>
			}
			if r.ProductOwnerHref != "" {
				<li data-page="product-owner">
					<a href={ templ.SafeURL(r.ProductOwnerHref) } { currentAttrs(r.Page == PageProductOwner)... }>
						@icon("owner")
						<span class="[ label ]">Product owner</span>
					</a>
				</li>
			}
		</ul>
	</nav>
}

// railServerCopy is the Tasks nav's first paint: the heading, the filter's
// place, and the groups with bare h3 headings.
templ railServerCopy(r Rail) {
	if r.Empty != "" {
		@emptyProjectNotice()
	} else {
		<div class="[ head ]">
			<h2 class="[ title ]">Tasks <span class="[ count ]">{ strconv.Itoa(r.TaskCount()) }</span></h2>
		</div>
		<div class="[ filter-placeholder ]"></div>
		<div class="[ groups ]">
			for _, g := range r.Groups {
				<section class="[ group ]" aria-labelledby={ g.HeadingID() } data-key={ g.Key } { groupAttrs(g)... }>
					<h3 id={ g.HeadingID() }>
						if !g.IsEmpty() {
							@icon("chevron")
						}
						<span class="[ name ]">{ g.Label }</span>
						<span class="[ count ]">{ strconv.Itoa(g.Total) }<span class="[ visually-hidden ]">{ g.CountWords() }</span></span>
					</h3>
					if !g.IsEmpty() {
						<ul role="list" id={ g.ListID() }>
							for _, l := range g.Links {
								@railItem(l)
							}
							if len(g.More) > 0 {
								<li class="[ more ]">
									<details>
										<summary><span class="[ closed ]">{ g.MoreText() }<span class="[ visually-hidden ]">{ " done tasks" }</span></span><span class="[ opened ]">Show fewer</span></summary>
										<ul role="list">
											for _, l := range g.More {
												@railItem(l)
											}
										</ul>
									</details>
								</li>
							}
						</ul>
					}
				</section>
			}
		</div>
	}
}

templ emptyProjectNotice() {
	<p class="[ notice ]"><span><b>No tasks yet.</b> A task is what agents work on: create one, then start a session on it.</span></p>
}

// railItem is a rail list item, server-rendered: a plain task's link, or a
// feature task's row with a twisty and its children nested under it, folded.
templ railItem(l Link) {
	if l.IsFeature() {
		<li data-feature>
			<div class="[ frow ]">
				@railLink(l)
				<button type="button" class="[ twisty ]" aria-expanded="false" aria-controls={ l.KidsID() } aria-label={ l.TwistyLabel() }>
					{ strconv.Itoa(len(l.Kids)) }
					@icon("chevron")
				</button>
			</div>
			<ul class="[ kids ]" role="list" id={ l.KidsID() }>
				for _, k := range l.Kids {
					<li>
						@railLink(k)
					</li>
				}
			</ul>
		</li>
	} else {
		<li>
			@railLink(l)
		</li>
	}
}

// railLink is one task, server-rendered with its activity: the dot, the
// title, and one meta item.
templ railLink(l Link) {
	<a href={ templ.SafeURL(l.Href) } data-task-id={ l.TaskID } { currentAttrs(l.Current)... } { attentionAttrs(l.Attention)... }>
		if l.StatusKey != "" {
			<span class="[ tdot ]" data-st={ l.StatusKey } aria-hidden="true"></span>
		} else if l.LiveState() != "" {
			<span class="[ status ]" data-state={ l.LiveState() } data-dot-only></span>
		}
		<span class="[ label ]">{ l.Label }</span>
		<span class="[ visually-hidden ]">{ l.MetaLead() }</span>
		if l.Reviews > 0 {
			<span class="[ badge ]" data-tone="attention">{ l.ReviewsText() }</span>
		} else if l.Waiting() {
			<span class="[ meta ]" data-tone="attention">waiting</span>
		} else if l.Running() {
			<span class="[ meta ]">{ strconv.Itoa(l.Live) } live</span>
		} else if l.Merging() {
			<span class="[ meta ]" data-merge-state={ l.Merge }>
				@mergeGlyphs()
				{ l.MergeText }
			</span>
		} else if l.ShowsStatus() {
			<span class="[ meta ]">{ l.StatusWord }</span>
		}
		<span class="[ visually-hidden ]">{ l.MetaTail() }</span>
	</a>
}

// railLiveCopy is the Tasks nav as tasksRail renders it from its store.
templ railLiveCopy() {
	<div class="[ contents ]">
		<template x-if="isEmpty">
			@emptyProjectNotice()
		</template>
		<div class="[ head ]" x-show="hasTasks">
			<h2 class="[ title ]">Tasks <span class="[ count ]" x-text="total"></span></h2>
			<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-show="showsNeedsYou" x-bind:aria-pressed="needsYouOnly" x-on:click="toggleNeedsYou">
				Needs you <span class="[ badge ]" data-tone="attention" x-text="needsYouCount"></span>
			</button>
		</div>
		<div class="[ filter ]" x-show="hasTasks">
			<input type="search" placeholder="Filter tasks" aria-label="Filter tasks" aria-describedby="rail-filter-result" autocomplete="off" x-ref="filter" x-model="query" x-on:input="filtered" x-on:keydown="filterKey"/>
			<kbd aria-hidden="true">/</kbd>
		</div>
		<p id="rail-filter-result" class="[ visually-hidden ]" aria-live="polite" x-text="filterResult"></p>
		<template x-if="hasNoMatch">
			<div class="[ notice ]">
				<span x-text="noMatchText"></span>
				<button type="button" class="[ button ]" data-size="sm" x-on:click="clearFilter">Clear</button>
			</div>
		</template>
		<template x-if="nothingNeedsYou">
			<p class="[ notice ]">Nothing needs you right now.</p>
		</template>
		<div class="[ groups ]" x-show="hasTasks" x-on:keydown="navKey" x-on:focusin="noteFocus" x-on:focusout="forgetFocus">
			<template x-for="group in groups" x-bind:key="group.key">
				<section class="[ group ]" x-bind:aria-labelledby="group.headingId" x-bind:data-key="group.key" x-bind:data-collapsed="group.collapsed" x-bind:data-empty="group.empty">
					<h3 x-bind:id="group.headingId">
						<template x-if="group.foldable">
							<button type="button" x-bind:aria-expanded="group.expanded" x-bind:aria-controls="group.listId" x-bind:data-key="group.key" x-bind:data-turns="turned" x-on:click="toggleGroup">
								@icon("chevron")
								<span class="[ name ]" x-text="group.label"></span>
								<span class="[ count ]"><span x-text="group.countText"></span><span class="[ visually-hidden ]" x-text="group.countWords"></span></span>
							</button>
						</template>
						<template x-if="!group.foldable">
							<span class="[ contents ]">
								<span class="[ name ]" x-text="group.label"></span>
								<span class="[ count ]"><span x-text="group.countText"></span><span class="[ visually-hidden ]" x-text="group.countWords"></span></span>
							</span>
						</template>
					</h3>
					<ul role="list" x-bind:id="group.listId" x-show="group.hasRows">
						<template x-for="row in group.rows" x-bind:key="row.id">
							@railLiveItem()
						</template>
						<li class="[ more ]" x-show="group.hasMore">
							<details>
								<summary><span class="[ closed ]"><span x-text="group.moreText"></span><span class="[ visually-hidden ]">{ " done tasks" }</span></span><span class="[ opened ]">Show fewer</span></summary>
								<ul role="list">
									<template x-for="row in group.more" x-bind:key="row.id">
										@railLiveItem()
									</template>
								</ul>
							</details>
						</li>
					</ul>
				</section>
			</template>
		</div>
	</div>
}

// railLiveItem is the live copy of railItem, bound to a row of railView.js:
// a plain task's link, or a feature task's row with its twisty and its
// children nested under it.
templ railLiveItem() {
	<li x-bind:data-feature="row.isFeature ? '' : null" x-bind:data-open="row.open ? '' : null">
		<template x-if="row.isFeature">
			<div class="[ frow ]">
				@railLiveLink()
				<button type="button" class="[ twisty ]" x-bind:data-feature-id="row.id" x-bind:aria-expanded="row.openText" x-bind:aria-controls="row.kidsId" x-bind:aria-label="row.twistyLabel" x-on:click="toggleFeature">
					<span x-text="row.kidsCount"></span>
					@icon("chevron")
				</button>
			</div>
		</template>
		<template x-if="!row.isFeature">
			@railLiveLink()
		</template>
		<template x-if="row.isFeature">
			<ul class="[ kids ]" role="list" x-bind:id="row.kidsId">
				<template x-for="kid in row.kids" x-bind:key="kid.id">
					<li>
						@railLiveKidLink()
					</li>
				</template>
			</ul>
		</template>
	</li>
}

// railLiveKidLink is a child's row: its status dot, its title, and a signal
// or its status word.
templ railLiveKidLink() {
	<a x-bind:href="kid.href" x-bind:aria-current="kid.current" x-bind:data-task-id="kid.id" x-bind:data-attention="kid.attention" x-bind:data-fresh="kid.fresh" x-on:mouseenter="tip">
		<span class="[ tdot ]" x-bind:data-st="kid.statusKey" aria-hidden="true"></span>
		<span class="[ label ]"><span x-text="kid.before"></span><mark x-show="kid.hasMatch" x-text="kid.match"></mark><span x-text="kid.after"></span></span>
		<span class="[ visually-hidden ]" x-text="kid.lead"></span>
		<span class="[ badge ]" data-tone="attention" x-show="kid.hasReviews" x-text="kid.reviewsText"></span>
		<span class="[ meta ]" data-tone="attention" x-show="kid.isWaiting">waiting</span>
		<span class="[ meta ]" x-show="kid.isLive" x-text="kid.liveText"></span>
		<span class="[ meta ]" x-show="kid.hasStatusWord" x-text="kid.statusWord"></span>
		<span class="[ visually-hidden ]" x-text="kid.tail"></span>
	</a>
}

// railLiveLink is the live copy of railLink, bound to a row of railView.js.
templ railLiveLink() {
	<a x-bind:href="row.href" x-bind:aria-current="row.current" x-bind:data-task-id="row.id" x-bind:data-attention="row.attention" x-bind:data-fresh="row.fresh" x-bind:data-peek="row.peek" x-on:mouseenter="tip">
		<span class="[ status ]" data-dot-only x-show="row.hasDot" x-bind:data-state="row.state" x-bind:data-signal="row.signal"></span>
		<span class="[ label ]"><span x-text="row.before"></span><mark x-show="row.hasMatch" x-text="row.match"></mark><span x-text="row.after"></span></span>
		<span class="[ visually-hidden ]" x-text="row.lead"></span>
		<span class="[ badge ]" data-tone="attention" x-show="row.hasReviews" x-text="row.reviewsText"></span>
		<span class="[ meta ]" data-tone="attention" x-show="row.isWaiting">waiting</span>
		<span class="[ meta ]" x-show="row.isLive" x-text="row.liveText"></span>
		<span class="[ meta ]" x-show="row.hasMerge" x-bind:data-merge-state="row.mergeState">
			@mergeGlyphs()
			<span x-text="row.mergeText"></span>
		</span>
		<span class="[ visually-hidden ]" x-text="row.tail"></span>
	</a>
}

// streamBar shows whether the page is live. The page's feed reports its
// status as a `feed-status` window event; streamStatus listens for it.
templ streamBar(live bool, hints []Hint, oob bool) {
	<footer id="stream-bar" class="[ stream-bar ]" aria-live="polite" { oobAttrs(oob)... }>
		if live {
			<span class="[ status ]" data-state="reconnecting" x-data="streamStatus" x-on:feed-status.window="update" x-bind:data-state="state" x-text="label">connecting</span>
		}
		<span class="[ visually-hidden ]" x-data="streamAnnouncer" x-on:rail-announce.window="say" x-text="text"></span>
		<span class="[ keys ]" x-data="streamHints" x-on:stream-hints.window="set">
			if hints == nil {
				<span x-show="!overridden"><kbd>J</kbd><kbd>K</kbd> move</span>
			}
			for _, h := range hints {
				<span x-show="!overridden">
					for _, k := range h.Keys {
						<kbd>{ k }</kbd>
					}
					{ h.Label }
				</span>
			}
			<template x-for="h in hints" x-bind:key="h.key">
				<span>
					<template x-for="k in h.keys" x-bind:key="k">
						<kbd x-text="k"></kbd>
					</template>
					<span x-text="h.label"></span>
				</span>
			</template>
		</span>
		<span class="[ cluster ] [ gutter-2xs ]" x-data="themeToggle">
			<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-pressed="isLight" x-on:click="light">Light</button>
			<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-pressed="isDark" x-on:click="dark">Dark</button>
			<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-pressed="isSystem" x-on:click="system">System</button>
		</span>
	</footer>
}
