package shell

import "strconv"

// Document is the HTML page: head, styles, the client bundle, then the body.
templ Document(f Frame) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ f.DocumentTitle() }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:wght@400;500;700&family=Atkinson+Hyperlegible+Next:wght@400;500;700&display=swap"/>
			<link rel="stylesheet" href={ f.CSS }/>
			<script type="module" src={ f.JS }></script>
		</head>
		<body>
			if !f.Built {
				<div class="[ banner ] [ pad-m ]" data-tone="attention" role="alert">
					<span>The web client is not built, so this page has no styles or interactivity. Run <code>make web</code> and reload.</span>
				</div>
			}
			{ children... }
		</body>
	</html>
}

// AppShell is the app layout: the top bar, the task rail, the page's main
// region, and the stream bar.
templ AppShell(f Frame) {
	@Document(f) {
		<div class="[ app-shell ]">
			<a class="[ skip-link ] [ button ]" data-size="sm" href="#main">Skip to content</a>
			@topBar(f)
			@taskRail(f)
			{ children... }
			@streamBar(f.Live, f.Hints)
		</div>
	}
}

// topBar holds the project picker and the way to every project: the
// projects list, where New project lives, or New project itself where the
// list is not served. The picker is
// a GET form, so it works without JavaScript; projectPicker submits it as
// soon as the choice changes. Below 48rem it starts with the Tasks button
// that opens the rail as a drawer (a link to the board without JavaScript).
templ topBar(f Frame) {
	<header class="[ topbar ]">
		if f.Rail.Seed != nil {
			@tasksToggle(f.Rail)
		}
		<a class="[ brand ]" href="/">harness</a>
		if len(f.Top.Projects) > 0 {
			<form class="[ cluster ] [ gutter-xs ]" method="get" action="/switch-project" x-data="projectPicker">
				<label class="[ visually-hidden ]" for="project-picker">Project</label>
				<select id="project-picker" name="project" data-size="sm" data-fit x-on:change="go">
					if f.Top.Current == "" {
						<option value="" selected disabled>Choose a project…</option>
					}
					for _, p := range f.Top.Projects {
						<option value={ p.ID } { selectedAttrs(p.ID == f.Top.Current)... }>{ p.Name }</option>
					}
				</select>
				<noscript><button type="submit" class="[ button ]" data-size="sm">Open</button></noscript>
			</form>
		}
		if f.Top.ProjectsHref != "" {
			<a class="[ button ]" data-variant="ghost" data-size="sm" href={ templ.SafeURL(f.Top.ProjectsHref) } { currentAttrs(f.Top.OnProjects)... }>Projects</a>
		} else {
			<a class="[ button ]" data-variant="ghost" data-size="sm" href="/projects/new">New project</a>
		}
		if f.Notifications != nil {
			@notificationsBell(f.Notifications)
		}
	</header>
}

// notificationsBell is the unread count on every page and the panel with
// the latest notifications across projects (notificationsBell in web/src).
// Without JavaScript it is a link to the inbox; the count and its badge are
// painted here, so they are right before any script runs.
templ notificationsBell(b *Bell) {
	if b.Seed != nil {
		@templ.JSONScript("notifications-seed", b.Seed)
	}
	<div class="[ notifications ]" x-data="notificationsBell" x-on:focusout="focusLeft">
		<a
			class="[ button ] [ bell ]"
			data-variant="ghost"
			data-icon
			href={ templ.SafeURL(b.Href) }
			aria-label={ b.Label() }
			x-bind:aria-label="label"
			aria-controls="notifications-panel"
			x-bind:aria-expanded="expanded"
			x-ref="trigger"
			x-on:click="toggle"
		>
			@icon("bell")
			<span class="[ badge ]" data-tone="attention" aria-hidden="true" x-show="hasUnread" x-text="badge" { shownIf(b.Unread() > 0)... }>{ b.BadgeText() }</span>
		</a>
		<section id="notifications-panel" class="[ popup ] [ notifications-panel ]" aria-labelledby="notifications-heading" x-ref="panel" x-on:keydown="panelKey">
			<div class="[ head ]">
				<h2 id="notifications-heading" tabindex="-1">Notifications</h2>
				<div class="[ cluster ] [ gutter-2xs ]" role="group" aria-label="Show">
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-pressed="showsAll" x-on:click="showAll">All</button>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-pressed="showsUnread" x-on:click="showUnread">Unread</button>
				</div>
			</div>
			<template x-if="error">
				<div class="[ message ]" data-tone="danger" role="alert">
					<span x-text="error.message"></span>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
				</div>
			</template>
			<div class="[ list ]" x-bind:aria-busy="loading">
				<ul role="list" class="[ notification-list ]">
					<template x-for="row in rows" x-bind:key="row.id">
						<li>
							@NotificationLiveRow()
						</li>
					</template>
				</ul>
				<p class="[ message ]" x-show="isEmpty" x-text="emptyText"></p>
			</div>
			<footer class="[ foot ]">
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:disabled="!canMarkAll" x-on:click="markAll">Mark all read</button>
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-pressed="alertsPressed" x-bind:disabled="alertsUnavailable" aria-describedby="notifications-alerts-note" x-on:click="toggleAlerts">Desktop alerts</button>
				<span id="notifications-alerts-note" class="[ note ]" x-text="alertsNote"></span>
				<a class="[ all ]" href={ templ.SafeURL(b.Href) }>See all notifications</a>
			</footer>
		</section>
	</div>
}

// NotificationLiveRow is one notification as the browser renders it, in an
// x-for over `rows` (the bell's panel, the inbox page): its fields are
// web/src/modules/notifications/presentation/view.js's Row.
templ NotificationLiveRow() {
	<article class="[ notification ]" x-bind:data-level="row.level" x-bind:data-state="row.state">
		<span class="[ marker ]" aria-hidden="true"></span>
		<div class="[ text ]">
			<a class="[ title ]" data-item x-bind:href="row.href" x-bind:data-id="row.id" x-bind:aria-label="row.label" x-on:click="openItem" x-text="row.title"></a>
			<p class="[ meta ]">
				<span x-text="row.project"></span>
				<template x-if="row.hasTask">
					<span class="[ task ]" x-text="row.task"></span>
				</template>
				<span class="[ level ]" x-show="row.levelLabel" x-text="row.levelLabel"></span>
				<time x-bind:datetime="row.at" x-text="row.age"></time>
			</p>
			<p class="[ body ]" x-show="row.body" x-text="row.body"></p>
		</div>
		<button type="button" class="[ button ] [ mark ]" data-variant="ghost" data-size="sm" x-show="row.unread" x-bind:data-id="row.id" x-bind:aria-label="row.markLabel" x-on:click="markOne">Mark read</button>
	</article>
}

// tasksToggle is the phone's way to the rail: the Tasks button, with how many
// tasks need the person.
templ tasksToggle(r Rail) {
	<a
		class="[ button ] [ tasks-toggle ]"
		data-variant="ghost"
		href={ templ.SafeURL(r.BoardHref) }
		aria-controls="rail"
		aria-haspopup="dialog"
		aria-expanded="false"
		x-data="tasksRailToggle"
		x-bind:aria-expanded="expanded"
		x-on:click="open"
	>
		@icon("rail")
		Tasks
		<span class="[ badge ]" data-tone="attention" x-show="hasNeedsYou" { shownIf(r.NeedsYou() > 0)... }>
			<span x-text="needsYouCount">{ strconv.Itoa(r.NeedsYou()) }</span><span class="[ visually-hidden ]">{ " need you" }</span>
		</span>
	</a>
}

// taskRail is the column beside the page: the skip link, New task, the
// project's pages and its tasks in status groups. The server renders the
// groups inside [data-ssr], folded as the rail_collapsed cookie says;
// tasksRail renders the same groups live from its store (with the filter
// and Needs you) and removes the server copy, so a task an agent creates or
// moves regroups the rail as it happens. Below 48rem it is a drawer.
templ taskRail(f Frame) {
	{{ r := f.Rail }}
	if r.Seed != nil {
		@templ.JSONScript("rail-seed", r.Seed)
	}
	<div class="[ rail ]" id="rail" { railAttrs(r)... }>
		if r.Seed != nil {
			<div class="[ drawer-head ]">
				<span class="[ truncate ]">{ f.ProjectName() }</span>
				<button type="button" class="[ button ]" data-variant="ghost" data-icon aria-label="Close" x-on:click="closeDrawer">
					@icon("close")
				</button>
			</div>
		}
		if r.NewTaskHref != "" {
			<a class="[ button ]" data-size="sm" href={ templ.SafeURL(r.NewTaskHref) }>
				@icon("plus")
				New task
			</a>
			@projectNav(r)
		} else if len(f.Top.Projects) > 0 {
			<p class="[ note ]">Choose a project in the picker above to see its tasks.</p>
		}
		if r.Seed != nil {
			<nav class="[ nav ]" aria-label="Tasks">
				<div x-ignore data-ssr class="[ contents ]">
					@railServerCopy(r)
				</div>
				<template x-if="live">
					@railLiveCopy()
				</template>
			</nav>
		}
	</div>
	if r.Seed != nil {
		<div class="[ scrim ]" x-data="tasksRailToggle" x-bind:data-open="openAttr" x-on:click="close"></div>
	}
}

// projectNav is the project's pages; the open one is aria-current.
templ projectNav(r Rail) {
	<nav class="[ nav ]" aria-label="Project">
		<ul role="list">
			if r.BoardHref != "" {
				<li>
					<a href={ templ.SafeURL(r.BoardHref) } { currentAttrs(r.Page == PageBoard)... }>
						@icon("board")
						<span class="[ label ]">Board</span>
					</a>
				</li>
			}
			if r.ReviewsHref != "" {
				<li>
					<a href={ templ.SafeURL(r.ReviewsHref) } { currentAttrs(r.Page == PageReviews)... }>
						@icon("review")
						<span class="[ label ]">Review requests</span>
						<span class="[ badge ]" data-tone="attention" x-show="hasReviews" { shownIf(r.Reviews > 0)... }>
							<span x-text="reviewsCount">{ strconv.Itoa(r.Reviews) }</span><span class="[ visually-hidden ]">{ " waiting on you" }</span>
						</span>
					</a>
				</li>
			}
			if r.DocumentsHref != "" {
				<li>
					<a href={ templ.SafeURL(r.DocumentsHref) } { currentAttrs(r.Page == PageDocuments)... }>
						@icon("document")
						<span class="[ label ]">Documents</span>
					</a>
				</li>
			}
			if r.DesignHref != "" {
				<li>
					<a href={ templ.SafeURL(r.DesignHref) } { currentAttrs(r.Page == PageDesign)... }>
						@icon("design")
						<span class="[ label ]">Design assets</span>
					</a>
				</li>
			}
		</ul>
	</nav>
}

// railServerCopy is the Tasks nav's first paint: the heading, the filter's
// place, and the groups with bare h3 headings.
templ railServerCopy(r Rail) {
	if r.Empty != "" {
		@emptyProjectNotice()
	} else {
		<div class="[ head ]">
			<h2 class="[ title ]">Tasks <span class="[ count ]">{ strconv.Itoa(len(r.Seed.Tasks)) }</span></h2>
		</div>
		<div class="[ filter-placeholder ]"></div>
		<div class="[ groups ]">
			for _, g := range r.Groups {
				<section class="[ group ]" aria-labelledby={ g.HeadingID() } data-key={ g.Key } { groupAttrs(g)... }>
					<h3 id={ g.HeadingID() }>
						if !g.IsEmpty() {
							@icon("chevron")
						}
						<span class="[ name ]">{ g.Label }</span>
						<span class="[ count ]">{ strconv.Itoa(g.Total) }<span class="[ visually-hidden ]">{ g.CountWords() }</span></span>
					</h3>
					if !g.IsEmpty() {
						<ul role="list" id={ g.ListID() }>
							for _, l := range g.Links {
								<li>
									@railLink(l)
								</li>
							}
							if len(g.More) > 0 {
								<li class="[ more ]">
									<details>
										<summary><span class="[ closed ]">{ g.MoreText() }<span class="[ visually-hidden ]">{ " done tasks" }</span></span><span class="[ opened ]">Show fewer</span></summary>
										<ul role="list">
											for _, l := range g.More {
												<li>
													@railLink(l)
												</li>
											}
										</ul>
									</details>
								</li>
							}
						</ul>
					}
				</section>
			}
		</div>
	}
}

templ emptyProjectNotice() {
	<p class="[ notice ]"><span><b>No tasks yet.</b> A task is what agents work on: create one, then start a session on it.</span></p>
}

// railLink is one task, server-rendered with its activity: the dot, the
// title, and one meta item.
templ railLink(l Link) {
	<a href={ templ.SafeURL(l.Href) } data-task-id={ l.TaskID } { currentAttrs(l.Current)... } { attentionAttrs(l.Attention)... }>
		if l.LiveState() != "" {
			<span class="[ status ]" data-state={ l.LiveState() } data-dot-only></span>
		}
		<span class="[ label ]">{ l.Label }</span>
		<span class="[ visually-hidden ]">{ l.MetaLead() }</span>
		if l.Reviews > 0 {
			<span class="[ badge ]" data-tone="attention">{ l.ReviewsText() }</span>
		} else if l.Waiting() {
			<span class="[ meta ]" data-tone="attention">waiting</span>
		} else if l.Running() {
			<span class="[ meta ]">{ strconv.Itoa(l.Live) } live</span>
		}
		<span class="[ visually-hidden ]">{ l.MetaTail() }</span>
	</a>
}

// railLiveCopy is the Tasks nav as tasksRail renders it from its store.
templ railLiveCopy() {
	<div class="[ contents ]">
		<template x-if="isEmpty">
			@emptyProjectNotice()
		</template>
		<div class="[ head ]" x-show="hasTasks">
			<h2 class="[ title ]">Tasks <span class="[ count ]" x-text="total"></span></h2>
			<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-show="showsNeedsYou" x-bind:aria-pressed="needsYouOnly" x-on:click="toggleNeedsYou">
				Needs you <span class="[ badge ]" data-tone="attention" x-text="needsYouCount"></span>
			</button>
		</div>
		<div class="[ filter ]" x-show="hasTasks">
			<input type="search" placeholder="Filter tasks" aria-label="Filter tasks" aria-describedby="rail-filter-result" autocomplete="off" x-ref="filter" x-model="query" x-on:input="filtered" x-on:keydown="filterKey"/>
			<kbd aria-hidden="true">/</kbd>
		</div>
		<p id="rail-filter-result" class="[ visually-hidden ]" aria-live="polite" x-text="filterResult"></p>
		<template x-if="hasNoMatch">
			<div class="[ notice ]">
				<span x-text="noMatchText"></span>
				<button type="button" class="[ button ]" data-size="sm" x-on:click="clearFilter">Clear</button>
			</div>
		</template>
		<template x-if="nothingNeedsYou">
			<p class="[ notice ]">Nothing needs you right now.</p>
		</template>
		<div class="[ groups ]" x-show="hasTasks" x-on:keydown="navKey" x-on:focusin="noteFocus" x-on:focusout="forgetFocus">
			<template x-for="group in groups" x-bind:key="group.key">
				<section class="[ group ]" x-bind:aria-labelledby="group.headingId" x-bind:data-key="group.key" x-bind:data-collapsed="group.collapsed" x-bind:data-empty="group.empty">
					<h3 x-bind:id="group.headingId">
						<template x-if="group.foldable">
							<button type="button" x-bind:aria-expanded="group.expanded" x-bind:aria-controls="group.listId" x-bind:data-key="group.key" x-bind:data-turns="turned" x-on:click="toggleGroup">
								@icon("chevron")
								<span class="[ name ]" x-text="group.label"></span>
								<span class="[ count ]"><span x-text="group.countText"></span><span class="[ visually-hidden ]" x-text="group.countWords"></span></span>
							</button>
						</template>
						<template x-if="!group.foldable">
							<span class="[ contents ]">
								<span class="[ name ]" x-text="group.label"></span>
								<span class="[ count ]"><span x-text="group.countText"></span><span class="[ visually-hidden ]" x-text="group.countWords"></span></span>
							</span>
						</template>
					</h3>
					<ul role="list" x-bind:id="group.listId" x-show="group.hasRows">
						<template x-for="row in group.rows" x-bind:key="row.id">
							<li>
								@railLiveLink()
							</li>
						</template>
						<li class="[ more ]" x-show="group.hasMore">
							<details>
								<summary><span class="[ closed ]"><span x-text="group.moreText"></span><span class="[ visually-hidden ]">{ " done tasks" }</span></span><span class="[ opened ]">Show fewer</span></summary>
								<ul role="list">
									<template x-for="row in group.more" x-bind:key="row.id">
										<li>
											@railLiveLink()
										</li>
									</template>
								</ul>
							</details>
						</li>
					</ul>
				</section>
			</template>
		</div>
	</div>
}

// railLiveLink is the live copy of railLink, bound to a row of railView.js.
templ railLiveLink() {
	<a x-bind:href="row.href" x-bind:aria-current="row.current" x-bind:data-task-id="row.id" x-bind:data-attention="row.attention" x-bind:data-fresh="row.fresh" x-bind:data-peek="row.peek" x-on:mouseenter="tip">
		<span class="[ status ]" data-dot-only x-show="row.hasDot" x-bind:data-state="row.state" x-bind:data-signal="row.signal"></span>
		<span class="[ label ]"><span x-text="row.before"></span><mark x-show="row.hasMatch" x-text="row.match"></mark><span x-text="row.after"></span></span>
		<span class="[ visually-hidden ]" x-text="row.lead"></span>
		<span class="[ badge ]" data-tone="attention" x-show="row.hasReviews" x-text="row.reviewsText"></span>
		<span class="[ meta ]" data-tone="attention" x-show="row.isWaiting">waiting</span>
		<span class="[ meta ]" x-show="row.isLive" x-text="row.liveText"></span>
		<span class="[ visually-hidden ]" x-text="row.tail"></span>
	</a>
}

// streamBar shows whether the page is live. The page's feed reports its
// status as a `feed-status` window event; streamStatus listens for it.
templ streamBar(live bool, hints []Hint) {
	<footer class="[ stream-bar ]" aria-live="polite">
		if live {
			<span class="[ status ]" data-state="reconnecting" x-data="streamStatus" x-on:feed-status.window="update" x-bind:data-state="state" x-text="label">connecting</span>
		}
		<span class="[ visually-hidden ]" x-data="streamAnnouncer" x-on:rail-announce.window="say" x-text="text"></span>
		<span class="[ keys ]">
			if hints == nil {
				<span><kbd>J</kbd><kbd>K</kbd> move</span>
			}
			for _, h := range hints {
				<span>
					for _, k := range h.Keys {
						<kbd>{ k }</kbd>
					}
					{ h.Label }
				</span>
			}
		</span>
		<span class="[ cluster ] [ gutter-2xs ]" x-data="themeToggle">
			<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-pressed="isLight" x-on:click="light">Light</button>
			<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-pressed="isDark" x-on:click="dark">Dark</button>
			<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-pressed="isSystem" x-on:click="system">System</button>
		</span>
	</footer>
}
