package shell

// icon is a 16px line icon (the chevron is 12px), decorative: the words
// beside it carry the meaning.
templ icon(name string) {
	switch name {
		case "board":
			<svg aria-hidden="true" viewBox="0 0 16 16"><path d="M2 2.75h12v10.5H2z M6 2.75v10.5 M10 2.75v10.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
		case "code":
			<svg aria-hidden="true" viewBox="0 0 16 16"><path d="M5.5 4.5 2 8l3.5 3.5 M10.5 4.5 14 8l-3.5 3.5 M9 3 7 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"></path></svg>
		case "document":
			<svg aria-hidden="true" viewBox="0 0 16 16"><path d="M3.75 1.75h5.5L12.25 4.75v9.5h-8.5z M9 1.75V5h3.25 M6 8.25h4 M6 11h4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
		case "design":
			<svg aria-hidden="true" viewBox="0 0 16 16"><path d="M2 2.25h5v5H2z M11.5 2.1a2.6 2.6 0 1 1 0 5.2 2.6 2.6 0 0 1 0-5.2z M4.5 9.25 7.25 13.75h-5.5z M9.25 9.25h4.75v4.5H9.25z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
		case "review":
			<svg aria-hidden="true" viewBox="0 0 16 16"><path d="M2 3h12v7.75H8.5L5 13.5v-2.75H2z M5.5 6.9l1.75 1.6L10.5 5.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"></path></svg>
		case "usage":
			<svg aria-hidden="true" viewBox="0 0 16 16"><path d="M2 13.75h12 M4 11.5V8 M7 11.5V4 M10 11.5V6.5 M13 11.5V2.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
		case "plus":
			<svg aria-hidden="true" viewBox="0 0 16 16"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
		case "chevron":
			<svg aria-hidden="true" viewBox="0 0 12 12"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
		case "close":
			<svg aria-hidden="true" viewBox="0 0 16 16"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
		case "key":
			<svg aria-hidden="true" viewBox="0 0 16 16"><path d="M5.5 6.75a3.25 3.25 0 1 1 3.1 3.25L7.25 11.5H5.75V13H4.25v1.25h-2.5v-2.5l3.9-3.9A3.2 3.2 0 0 1 5.5 6.75z M10.5 5.1a.6.6 0 1 1 0 1.2.6.6 0 0 1 0-1.2z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"></path></svg>
		case "bell":
			<svg aria-hidden="true" viewBox="0 0 16 16"><path d="M4 11.25V7a4 4 0 0 1 8 0v4.25l1.25 1.25H2.75z M6.5 13.75a1.6 1.6 0 0 0 3 0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"></path></svg>
		case "saver":
			<svg aria-hidden="true" viewBox="0 0 16 16"><path d="M9 1.75 3.5 9h4L7 14.25 12.5 7h-4z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
		case "rail":
			<svg aria-hidden="true" viewBox="0 0 16 16"><path d="M2 2.75h12v10.5H2z M6 2.75v10.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
	}
}

// mergeGlyphs is every merge glyph of a rail row's meta; its data-merge-state
// shows the one that applies (rail.css). The markup is the board's cardGlyph
// (internal/adapter/in/web/tasks/project.templ), decorative: the word beside
// it carries the meaning.
templ mergeGlyphs() {
	<svg class="[ glyph ]" data-glyph="merged" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6.25"></circle><path d="M5.3 8.2l1.8 1.8 3.6-3.8"></path></svg>
	<svg class="[ glyph ]" data-glyph="partial" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6.25"></circle><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor" stroke="none"></path></svg>
	<svg class="[ glyph ]" data-glyph="not_merged" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6.25"></circle></svg>
	<svg class="[ glyph ]" data-glyph="unknown" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6.25" stroke-dasharray="2.4 2.2"></circle><path d="M6.4 6.3a1.7 1.7 0 1 1 2.3 1.6c-.5.2-.7.6-.7 1.1v.3"></path><circle cx="8" cy="11.3" r=".55" fill="currentColor" stroke="none"></circle></svg>
}
