package agentisolation

// attributionSection is #attribution. The server paints the saved preview in
// [data-ssr]; agentAttribution
// (web/src/modules/attribution/presentation/components/agentAttribution.js)
// takes over from the seed, builds the preview from the controls with the
// rule the launch uses, and saves on request.
templ attributionSection(v AttributionView) {
	<section id="attribution" class="[ pane ]" aria-labelledby="attribution-title" x-data="agentAttribution" data-seed="attribution-seed">
		@templ.JSONScript("attribution-seed", v.Seed())
		<header>
			<h2 id="attribution-title">Agent attribution</h2>
		</header>
		<div class="[ flow ] [ flow-space-m ]" style="padding: var(--space-l)">
			<p class="[ visually-hidden ]" role="status" aria-live="polite" x-text="announcement"></p>
			<p class="[ color-ink-muted ]">The credit line claude adds to what an agent writes: the <span class="[ font-mono ]">Co-Authored-By</span> trailer on a commit, and the "Generated with Claude Code" line on a pull request description. Applies to agent sessions started or resumed after you save; running sessions keep what they started with.</p>
			<template x-if="error">
				<div id="attribution-error" class="[ banner ]" data-tone="danger" role="alert">
					<div class="[ flow ] [ flow-space-3xs grow ]">
						<span x-text="error.message"></span>
						<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
					</div>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
				</div>
			</template>
			<div class="[ flow ] [ flow-space-s ]" style="display: none" x-show="ready">
				<div class="[ cluster ] [ gutter-xs ]" style="align-items: center">
					<label for="attribution-commit-mode" class="[ grow ]">Commits</label>
					<select id="attribution-commit-mode" data-size="sm" data-fit x-model="commit.mode">
						<option value="default">Claude default</option>
						<option value="none">None</option>
						<option value="custom">Custom text</option>
					</select>
				</div>
				<div style="display: none" x-show="commitCustom">
					<label for="attribution-commit-text" class="[ visually-hidden ]">Commit attribution text</label>
					<input id="attribution-commit-text" class="[ font-mono text-sm ]" autocomplete="off" spellcheck="false" placeholder="Co-Authored-By: Name &lt;name@example.com&gt;" x-model="commit.text"/>
				</div>
				<div class="[ cluster ] [ gutter-xs ]" style="align-items: center">
					<label for="attribution-pr-mode" class="[ grow ]">Pull requests</label>
					<select id="attribution-pr-mode" data-size="sm" data-fit x-model="pr.mode">
						<option value="default">Claude default</option>
						<option value="none">None</option>
						<option value="custom">Custom text</option>
					</select>
				</div>
				<div style="display: none" x-show="prCustom">
					<label for="attribution-pr-text" class="[ visually-hidden ]">Pull request attribution text</label>
					<input id="attribution-pr-text" class="[ font-mono text-sm ]" autocomplete="off" spellcheck="false" placeholder="Made with care" x-model="pr.text"/>
				</div>
			</div>
			<div class="[ flow ] [ flow-space-3xs ]">
				<span id="attribution-preview-label" class="[ hint ]">What agents get in their claude settings</span>
				<pre id="attribution-preview" class="[ code font-mono text-sm ]" aria-labelledby="attribution-preview-label" x-text="preview"><span data-ssr>{ v.Preview() }</span></pre>
			</div>
			<div class="[ cluster ] [ gutter-xs ]">
				<button type="button" class="[ button ]" data-variant="primary" data-size="sm" x-bind:disabled="cannotSave" x-on:click="save">Save</button>
			</div>
		</div>
	</section>
}
