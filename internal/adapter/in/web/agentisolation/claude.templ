package agentisolation

// claudeSection is #claude. The managed claude ticket fills it: extend
// ClaudeView and put its markup and Alpine component here.
templ claudeSection(v ClaudeView) {
	<section id="claude" class="[ pane ]" aria-labelledby="claude-title">
		<header><h2 id="claude-title">Managed claude</h2></header>
		<div class="[ flow ]" style="padding: var(--space-l)">
			<p class="[ color-ink-muted ]">The claude agents run is not set up here yet.</p>
		</div>
	</section>
}
