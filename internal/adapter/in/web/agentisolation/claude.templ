package agentisolation

// claudeSection is #claude. The server paints the chip, the banners and the
// installed versions in [data-ssr]; managedClaude
// (web/src/modules/claude/presentation/components/managedClaude.js) takes
// over from the seed and polls while an install runs. Installing never
// switches: Use this is its own action on an installed row.
templ claudeSection(v ClaudeView) {
	<section id="claude" class="[ pane ]" aria-labelledby="claude-title" x-data="managedClaude" data-seed="claude-seed">
		@templ.JSONScript("claude-seed", v.Seed())
		<header>
			<h2 id="claude-title">Managed claude</h2>
			<span class="[ badge ]" data-tone={ v.ChipTone() } x-bind:data-tone="chipTone" x-text="chipText">{ v.ChipText() }</span>
		</header>
		<div class="[ flow ] [ flow-space-m ]" style="padding: var(--space-l)">
			<p class="[ visually-hidden ]" role="status" aria-live="polite" x-text="announcement"></p>
			<p class="[ hint ]" role="status" aria-live="polite" data-switch-line style="display: none" x-show="hasSwitchLine" x-text="switchLine"></p>
			<p class="[ color-ink-muted ]">The claude CLI every agent runs. It sits in the harness data directory with its auto-updater off, so a new release reaches agents only when you pick it. Your own <span class="[ font-mono ]">claude</span> is never used or changed.</p>
			<div class="[ banner ]" data-tone="attention" role="status" { shownIf(v.Overridden)... } x-show="overridden">
				<span><strong>Overridden by <span class="[ font-mono ]">-claude.bin</span>.</strong> <span x-text="overrideText">Agents run { v.Bin }. The version you choose below is saved but not used.</span></span>
			</div>
			<div class="[ banner ]" data-tone="danger" role="alert" { shownIf(v.Missing())... } x-show="isMissing">
				<span class="[ grow ]"><strong>No managed claude. Agents cannot start.</strong> Install a version to continue.</span>
				<button type="button" class="[ button ]" data-variant="primary" data-size="sm" x-bind:disabled="cannotInstall" x-on:click="installLatest">Install latest</button>
			</div>
			<div class="[ banner ]" data-tone="danger" role="alert" { shownIf(v.Failed() && !v.Installing())... } x-show="hasFailed">
				<div class="[ flow ] [ flow-space-3xs grow ]">
					<strong x-text="failedTitle">{ v.FailedTitle() }</strong>
					<span class="[ code ]" x-text="failedMessage">{ v.FailedMessage() }</span>
				</div>
				<button type="button" class="[ button ]" data-size="sm" x-bind:disabled="cannotInstall" x-on:click="retry">Retry</button>
			</div>
			<template x-if="error">
				<div class="[ banner ]" data-tone="danger" role="alert">
					<div class="[ flow ] [ flow-space-3xs grow ]">
						<span x-text="error.message"></span>
						<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
					</div>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
				</div>
			</template>
			<div x-ignore data-ssr class="[ flow ] [ flow-space-s ]">
				if v.None() && !v.Installing() {
					<p class="[ color-ink-muted ]">Nothing installed yet.</p>
				} else {
					<ul role="list" class="[ list ]" aria-label="Installed versions">
						for _, r := range v.Rows() {
							<li class="[ row ] [ claude-version ]" data-version={ r.Version }>
								<span class="[ font-mono ]">{ r.Version }</span>
								if r.Active {
									<span class="[ badge ]" data-tone="signal">agents use this</span>
								}
								<span class="[ hint ]">{ r.Date }</span>
							</li>
						}
						if v.Installing() {
							<li class="[ row ] [ claude-installing ]">
								<span class="[ font-mono ]">{ v.InstallingVersion() } <span class="[ hint ]">installing…</span></span>
							</li>
						}
					</ul>
				}
			</div>
			<p class="[ color-ink-muted ]" style="display: none" x-show="showEmpty">Nothing installed yet.</p>
			<ul role="list" class="[ list ]" aria-label="Installed versions" style="display: none" x-show="showList">
				<template x-for="r in rows" x-bind:key="r.version">
					<li class="[ row ] [ claude-version ]" x-bind:data-version="r.version">
						<span class="[ font-mono ]" x-text="r.version"></span>
						<span class="[ badge ]" data-tone="signal" x-show="r.active">agents use this</span>
						<span class="[ hint ]" x-text="r.date"></span>
						<button type="button" class="[ button ]" data-size="sm" x-show="r.canUse" x-bind:aria-label="r.useLabel" x-bind:disabled="busy" x-on:click="use">Use this</button>
						<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-show="r.canRemove" x-bind:aria-label="r.removeLabel" x-bind:disabled="busy" x-on:click="remove">Remove</button>
					</li>
				</template>
				<li class="[ row ] [ claude-installing ]" role="status" style="display: none" x-show="isInstalling">
					<span class="[ font-mono ]" x-text="installingLabel"></span>
					<progress style="display: none" x-show="progressKnown" x-bind:value="progressValue" x-bind:max="progressMax" aria-label="Install progress"></progress>
					<span class="[ hint ]" x-text="progressText"></span>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-label="cancelLabel" x-bind:disabled="busy" x-on:click="cancel">Cancel</button>
				</li>
			</ul>
			<div class="[ cluster ] [ gutter-xs ]" style="display: none; align-items: center" x-show="hasVersions">
				<label class="[ hint ]" for="claude-version">Install another version</label>
				<select id="claude-version" class="[ font-mono ]" data-size="sm" data-fit x-ref="version" x-show="picker" x-bind:aria-busy="loadingReleases">
					<template x-for="o in options" x-bind:key="o.version">
						<option x-bind:value="o.version" x-bind:disabled="o.taken" x-text="o.label"></option>
					</template>
				</select>
				<span class="[ hint ]" style="display: none" x-show="loadingReleases">Loading versions…</span>
				<span class="[ error ]" style="display: none" role="status" x-show="releasesFailed">Could not load versions. Try again.</span>
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" style="display: none" x-show="releasesFailed" x-on:click="loadReleases">Retry</button>
				<input class="[ font-mono text-sm ]" style="display: none" x-show="releasesFailed" x-ref="typed" aria-label="Version" placeholder="2.1.52" autocomplete="off" autocapitalize="off" spellcheck="false"/>
				<button type="button" class="[ button ]" x-bind:disabled="cannotInstall" x-on:click="installPicked">Install</button>
				<span class="[ hint ]">Installing does not switch. New sessions use the version marked above.</span>
			</div>
		</div>
	</section>
}
