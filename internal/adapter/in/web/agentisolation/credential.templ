package agentisolation

// credentialSection is #credential. The agent credential ticket fills it:
// extend CredentialView and put its markup and Alpine component here.
templ credentialSection(v CredentialView) {
	<section id="credential" class="[ pane ]" aria-labelledby="credential-title">
		<header><h2 id="credential-title">Agent credential</h2></header>
		<div class="[ flow ]" style="padding: var(--space-l)">
			<p class="[ color-ink-muted ]">What agents sign in with is not set up here yet.</p>
		</div>
	</section>
}
