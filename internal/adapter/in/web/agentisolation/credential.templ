package agentisolation

// credentialSection is #credential. The server paints the status in
// [data-ssr]; agentCredential
// (web/src/modules/agentcredential/presentation/components/agentCredential.js)
// takes over from the seed. The value is typed into an uncontrolled password
// input and is never rendered, seeded or kept.
templ credentialSection(v CredentialView) {
	<section id="credential" class="[ pane ]" aria-labelledby="credential-title" x-data="agentCredential" data-seed="credential-seed" x-on:pagehide.window="pagehide">
		@templ.JSONScript("credential-seed", v.Seed())
		<header>
			<h2 id="credential-title">Agent credential</h2>
			<span id="credential-chip" class="[ badge ]" data-tone={ v.ChipTone() } x-bind:data-tone="chipTone" x-text="chipText">{ v.ChipText() }</span>
		</header>
		<div class="[ flow ] [ flow-space-m ]" style="padding: var(--space-l)">
			<p class="[ visually-hidden ]" role="status" aria-live="polite" x-text="announcement"></p>
			<p class="[ color-ink-muted ]">What agents sign in with. An OAuth token uses your Claude subscription; an API key is billed to your Anthropic API account. Stored encrypted and never shown again.</p>
			<div x-ignore data-ssr class="[ flow ] [ flow-space-m ]">
				if v.NotSet() {
					@noCredential()
				} else {
					@credentialFacts(v.KindName(), v.SavedDate())
				}
			</div>
			<div class="[ banner ]" data-tone="danger" role="alert" style="display: none" x-show="notSet">
				<span><strong>No credential. Agents cannot start.</strong> Paste a token or key.</span>
			</div>
			<div class="[ flow ] [ flow-space-3xs ]" style="display: none" x-show="isSet">
				<p><span class="[ color-ink-muted ]">Kind</span> <strong x-text="kindName"></strong></p>
				<p><span class="[ color-ink-muted ]">Saved</span> <span x-text="savedDate"></span></p>
			</div>
			<template x-if="error">
				<div class="[ banner ]" data-tone="danger" role="alert">
					<div class="[ flow ] [ flow-space-3xs grow ]">
						<span x-text="error.message"></span>
						<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
					</div>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
				</div>
			</template>
			<div class="[ cluster ] [ gutter-xs ]">
				<button type="button" class="[ button ]" data-variant={ v.PasteTone() } x-bind:data-variant="pasteTone" x-ref="paste" x-text="pasteLabel" x-bind:disabled="busy" x-on:click="startPaste">{ v.PasteLabel() }</button>
				<button type="button" class="[ button ]" data-variant="ghost" x-ref="remove" style="display: none" x-show="isSet" x-bind:disabled="busy" x-on:click="askRemove">Remove</button>
			</div>
			<div class="[ banner ]" data-tone="attention" role="alertdialog" aria-labelledby="credential-remove-title" aria-describedby="credential-remove-text" style="display: none" x-show="confirming" x-on:keydown.escape="keep">
				<div class="[ flow ] [ flow-space-xs grow ]">
					<h3 id="credential-remove-title">Remove the agent credential?</h3>
					<p id="credential-remove-text">Running sessions keep working until they end. New agents cannot start until you add another.</p>
					<div class="[ cluster ] [ gutter-xs ]">
						<button type="button" class="[ button ]" data-variant="danger" data-size="sm" x-on:click="remove">Remove credential</button>
						<button type="button" class="[ button ]" data-size="sm" x-ref="keep" x-on:click="keep">Keep it</button>
					</div>
				</div>
			</div>
			<form class="[ flow ] [ flow-space-s ]" style="display: none" novalidate autocomplete="off" x-show="pasting" x-on:submit.prevent="save">
				<fieldset class="[ flow ] [ flow-space-3xs ]">
					<legend>Kind</legend>
					<label>
						<input type="radio" name="credential-kind" value="oauth" checked x-bind:checked="oauthChosen" x-on:change="chooseKind"/>
						OAuth token <span class="[ hint ]">from <span class="[ font-mono ]">claude setup-token</span>, starts with sk-ant-oat</span>
					</label>
					<label>
						<input type="radio" name="credential-kind" value="api_key" x-bind:checked="apiKeyChosen" x-on:change="chooseKind"/>
						Anthropic API key <span class="[ hint ]">starts with sk-ant-api</span>
					</label>
				</fieldset>
				<div class="[ field ]">
					<label for="credential-value">Token or key</label>
					<input id="credential-value" type="password" class="[ font-mono text-sm ]" autocomplete="off" autocapitalize="off" spellcheck="false" x-ref="value" x-on:input="detectKind"/>
				</div>
				<div class="[ cluster ] [ gutter-xs ]">
					<button type="submit" class="[ button ]" data-variant="primary" x-bind:disabled="busy">Save credential</button>
					<button type="button" class="[ button ]" data-variant="ghost" x-on:click="cancelPaste">Cancel</button>
				</div>
			</form>
			<!-- Slot: the Sign in with Claude panel (the OAuth flow, ticket 06) goes here, above the paste form. -->
		</div>
	</section>
}

templ noCredential() {
	<div class="[ banner ]" data-tone="danger" role="alert">
		<span><strong>No credential. Agents cannot start.</strong> Paste a token or key.</span>
	</div>
}

templ credentialFacts(kind, saved string) {
	<div class="[ flow ] [ flow-space-3xs ]">
		<p><span class="[ color-ink-muted ]">Kind</span> <strong>{ kind }</strong></p>
		<p><span class="[ color-ink-muted ]">Saved</span> <span>{ saved }</span></p>
	</div>
}
