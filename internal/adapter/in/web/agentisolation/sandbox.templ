package agentisolation

// sandboxSection is #sandbox. The server paints the switch, the banners and
// the extra paths in [data-ssr]; sandboxSettings
// (web/src/modules/sandbox/presentation/components/sandboxSettings.js)
// takes over from the seed. Turning the sandbox off asks first, inline.
templ sandboxSection(v SandboxView) {
	<section id="sandbox" class="[ pane ]" aria-labelledby="sandbox-title" x-data="sandboxSettings" data-seed="sandbox-seed">
		@templ.JSONScript("sandbox-seed", v.Seed())
		<header>
			<h2 id="sandbox-title">Sandbox</h2>
			<span class="[ badge ]" data-tone={ v.ChipTone() } x-bind:data-tone="chipTone" x-text="chipText">{ v.ChipText() }</span>
		</header>
		<div class="[ flow ] [ flow-space-m ]" style="padding: var(--space-l)">
			<p class="[ visually-hidden ]" role="status" aria-live="polite" x-text="announcement"></p>
			<p class="[ color-ink-muted ]">Every agent process, and everything it starts, runs inside an OS sandbox (<span class="[ font-mono ]">{ v.DriverLabel() }</span>). Inside your home directory it can read and write only the paths below. System folders stay readable and the network stays open. Your App runs and the harness server are not sandboxed.</p>
			if v.NoDriver() {
				<div class="[ banner ]" data-tone="danger" role="alert">
					<span><strong>No sandbox driver on this platform.</strong> With the sandbox on, agents refuse to start rather than run unconfined. { v.InstallHint() }</span>
				</div>
			}
			<div class="[ banner ]" data-tone="attention" role="status" { shownIf(v.Off())... } x-show="isOff">
				<span><strong>Sandbox is off.</strong> New agents can read and write anything you can, including your home directory. Running sessions keep the setting they started with.</span>
			</div>
			<template x-if="error">
				<div class="[ banner ]" data-tone="danger" role="alert">
					<div class="[ flow ] [ flow-space-3xs grow ]">
						<span x-text="error.message"></span>
						<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
					</div>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
				</div>
			</template>
			<div>
				<button type="button" class="[ switch ]" role="switch" aria-checked={ v.EnabledAttr() } x-bind:aria-checked="enabled" x-ref="switch" x-on:click="toggle">
					<span class="[ track ]" aria-hidden="true"></span>
					<span>Run agents in the sandbox</span>
				</button>
			</div>
			<div class="[ banner ]" data-tone="attention" role="alertdialog" aria-labelledby="sandbox-off-title" aria-describedby="sandbox-off-text" style="display: none" x-show="confirming" x-on:keydown.escape="keepOn">
				<div class="[ flow ] [ flow-space-xs grow ]">
					<h3 id="sandbox-off-title">Turn the sandbox off?</h3>
					<p id="sandbox-off-text">New agents will be able to read and write anything you can, including SSH keys and other repositories. Running sessions are not affected.</p>
					<div class="[ cluster ] [ gutter-xs ]">
						<button type="button" class="[ button ]" data-variant="danger" data-size="sm" x-on:click="turnOff">Turn sandbox off</button>
						<button type="button" class="[ button ]" data-size="sm" x-ref="keep" x-on:click="keepOn">Keep it on</button>
					</div>
				</div>
			</div>
			<div class="[ flow ] [ flow-space-s ]">
				<h3 id="sandbox-paths-title">Extra paths</h3>
				<p class="[ hint ]">Agents may also use these folders. Applies to sessions started after you save.</p>
				<div x-ignore data-ssr class="[ flow ] [ flow-space-s ]">
					if len(v.Paths) == 0 {
						@noPaths()
					} else {
						<ul role="list" class="[ list ]" aria-labelledby="sandbox-paths-title">
							for _, r := range v.Rows() {
								<li class="[ row ] [ sandbox-path ]" data-path={ r.Path }>
									<span class="[ path font-mono text-sm ]">{ r.Path }</span>
									<select data-size="sm" data-fit aria-label={ r.AccessLabel }>
										<option value="read" selected?={ r.Access == "read" }>Read-only</option>
										<option value="write" selected?={ r.Access == "write" }>Read and write</option>
									</select>
									<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" aria-label={ r.RemoveLabel }>Remove</button>
									if r.Missing != "" {
										<span class="[ hint ] [ path-warning ]" data-warning="missing" data-tone="attention">{ r.Missing }</span>
									}
									if r.Credentials != "" {
										<span class="[ hint ] [ path-warning ]" data-warning="credentials" data-tone="attention">{ r.Credentials }</span>
									}
								</li>
							}
						</ul>
					}
				</div>
				<template x-if="isEmpty">
					@noPaths()
				</template>
				<ul role="list" class="[ list ]" aria-labelledby="sandbox-paths-title" x-show="hasPaths">
					<template x-for="r in rows" x-bind:key="r.path">
						<li class="[ row ] [ sandbox-path ]" x-bind:data-path="r.path">
							<span class="[ path font-mono text-sm ]" x-text="r.path"></span>
							<select data-size="sm" data-fit x-bind:aria-label="r.accessLabel" x-bind:value="r.access" x-on:change="setAccess">
								<option value="read">Read-only</option>
								<option value="write">Read and write</option>
							</select>
							<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-label="r.removeLabel" x-on:click="remove">Remove</button>
							<span class="[ hint ] [ path-warning ]" data-warning="missing" data-tone="attention" style="display: none" x-show="r.missingWarning" x-text="r.missingWarning"></span>
							<span class="[ hint ] [ path-warning ]" data-warning="credentials" data-tone="attention" style="display: none" x-show="r.credentialsWarning" x-text="r.credentialsWarning"></span>
						</li>
					</template>
				</ul>
				<p class="[ hint ]" data-prefilled data-tone="attention" role="status" { shownIf(v.AllowPath != "")... } x-show="prefilled">This path came from a session's Sandbox tab. Choose its access and press Add path to allow it. Nothing is saved until you do.</p>
				<form class="[ cluster ] [ gutter-xs ]" style="align-items: flex-start" novalidate autocomplete="off" x-on:submit.prevent="add">
					<div class="[ field ]" style="flex: 1 1 14rem">
						<label for="sandbox-new-path" class="[ visually-hidden ]">Path</label>
						<input id="sandbox-new-path" class="[ font-mono text-sm ]" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="~/.cache/pnpm" value={ v.AllowPath } x-ref="path" aria-describedby="sandbox-path-error" x-model="newPath" x-on:input="editPath" x-bind:aria-invalid="pathInvalid"/>
						<span class="[ error ]" id="sandbox-path-error" role="alert" style="display: none" x-show="pathInvalid" x-text="pathError"></span>
					</div>
					<select id="sandbox-new-access" data-size="sm" data-fit aria-label="Access" x-model="newAccess">
						<option value="read">Read-only</option>
						<option value="write">Read and write</option>
					</select>
					<button type="submit" class="[ button ]" x-bind:disabled="busy">Add path</button>
				</form>
			</div>
			<details id="sandbox-builtin" class="[ flow ] [ flow-space-s ]">
				<summary>{ v.BuiltinSummary() }</summary>
				<p class="[ hint ]">Every agent session may touch these besides its own worktree and the extra paths. The paths a session gets from its own environment (its PATH shims and git credential files) are made per session and not listed.</p>
				for _, g := range v.Builtin {
					<h4>{ g.Title }</h4>
					<ul role="list" class="[ list ]" aria-label={ g.Title }>
						for _, e := range g.Entries {
							<li class="[ row ] [ builtin-path ]">
								if e.Path != "" {
									<span class="[ path font-mono text-sm ]">{ e.Path }</span>
								}
								if e.Label != "" {
									<span class="[ hint ]">{ e.Label }</span>
								}
								<span class="[ hint ]">{ AccessWord(e.Write) }</span>
							</li>
						}
					</ul>
				}
			</details>
		</div>
	</section>
}

templ noPaths() {
	<p class="[ color-ink-muted ]">No extra paths. Agents get the built-in allowlist only. Add a folder if a build tool needs its cache.</p>
}

// shownIf hides an element the server knows is hidden until Alpine shows it.
func shownIf(shown bool) templ.Attributes {
	if shown {
		return templ.Attributes{}
	}
	return templ.Attributes{"style": "display: none"}
}
