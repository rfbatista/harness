package tasks

import (
	"strconv"

	"operators-mcp/internal/adapter/in/web/components"
	"operators-mcp/internal/adapter/in/web/projects"
	"operators-mcp/internal/adapter/in/web/shell"
)

// ProjectPage is the project root: its tasks as a kanban board. The server
// renders the first paint inside [data-ssr]; tasksBoard renders the same
// columns live from the rail's store and removes the server copy.
templ ProjectPage(f shell.Frame, projectID, projectName string, b Board) {
	@shell.AppShell(f) {
		<main id="main" class="[ frame ]" x-data="tasksBoard" data-project-id={ projectID } data-archived-count={ strconv.Itoa(b.ArchivedCount) } x-on:task-changed.window="taskChanged">
			<header class="[ toolbar ]">
				<h1>{ projectName }</h1>
				<a class="[ archived-link ]" href={ templ.SafeURL(ArchivedHref(projectID)) }>
					@cardGlyph("archive")
					<span x-text="archivedLink">{ "Archived (" + strconv.Itoa(b.ArchivedCount) + ")" }</span>
				</a>
				<div class="[ actions ]">
					<a class="[ button ]" data-variant="ghost" data-size="sm" href={ templ.SafeURL(projects.RepositoriesHref(projectID)) }>Repositories</a>
					<a class="[ button ]" data-variant="ghost" data-size="sm" href={ templ.SafeURL(projects.SettingsHref(projectID)) }>Settings</a>
					<a class="[ button ]" data-variant="primary" data-size="sm" href={ templ.SafeURL(NewTaskHref(projectID)) }>New task</a>
				</div>
			</header>
			<template x-if="error">
				<div class="[ banner ] [ pad-s ]" data-tone="danger" role="alert">
					<div class="[ flow ] [ flow-space-3xs grow ]">
						<span x-text="error.message"></span>
						<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
					</div>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
				</div>
			</template>
			<p class="[ visually-hidden ]" role="status" aria-live="polite" x-text="announcement"></p>
			<div data-scroll>
				<div x-ignore data-ssr>
					if b.Empty() {
						@noTasks(projectID)
					} else {
						@ssrBoard(b)
					}
				</div>
				<template x-if="isEmpty">
					@noTasks(projectID)
				</template>
				<template x-if="hasTasks">
					@liveBoard()
				</template>
			</div>
		</main>
	}
}

// noTasks is the empty state: what a task is, and the way to make one.
templ noTasks(projectID string) {
	@components.Empty("No tasks in this project yet", "A task is a piece of work agents take on, in one or more sessions.") {
		<div class="[ actions ]">
			<a class="[ button ]" data-variant="primary" href={ templ.SafeURL(NewTaskHref(projectID)) }>Create a task</a>
		</div>
	}
}

// ssrBoard is the first paint: complete without JavaScript, ignored by Alpine.
templ ssrBoard(b Board) {
	<div class="[ board ]" data-board aria-label="Tasks by status">
		for _, c := range b.Columns {
			<section class="[ column ]" data-column={ c.Status } aria-label={ c.Label } { waitingAttrs(c.Waiting())... }>
				<header>
					<h2>{ c.Label }</h2>
					<span class="[ count ]">{ strconv.Itoa(len(c.Cards)) }</span>
					if c.Status == "done" && len(c.Cards) > 0 {
						<div class="[ actions ]"><button type="button" class="[ button ]" data-size="sm" data-archive-all>Archive all</button></div>
					}
					if c.Waiting() {
						<p class="[ sub ]">Waiting for your check</p>
					}
				</header>
				<div class="[ cards ]">
					for _, card := range c.Cards {
						@ssrCard(card, c.Status)
					}
					if len(c.Cards) == 0 {
						<p class="[ column-empty ]">{ c.EmptyText() }</p>
					}
				</div>
			</section>
		}
	</div>
}

// ssrCard is one card of the first paint.
templ ssrCard(c Card, column string) {
	<article class="[ card ]" data-task-id={ c.TaskID } data-status={ c.Status }>
		<div class="[ top ]">
			<a class="[ title ]" href={ templ.SafeURL(c.Href) }>{ c.Label }</a>
			<button type="button" class="[ button move-to ]" data-variant="ghost" data-size="sm" aria-haspopup="menu" aria-expanded="false">Move to…<span class="[ chevron ]" aria-hidden="true"></span></button>
		</div>
		if c.HasSignals() {
			<div class="[ signals ]">
				if c.LiveState != "" {
					<span class="[ status ]" data-state={ c.LiveState }>{ c.LiveWord }</span>
				}
				if c.Reviews > 0 {
					<span class="[ badge reviews ]">
						@cardGlyph("review")
						{ reviewsWord(c.Reviews) }
					</span>
				}
				if c.Merge != nil {
					<span class="[ badge merge ]" data-merge-state={ c.Merge.State }>
						@mergeGlyphs()
						{ c.Merge.Word }
					</span>
				}
			</div>
		}
		<p class="[ last-move ]" data-last-move>
			<span>
				{ c.Lead + " " }<span class="[ who ]">{ c.Who }</span>
				if c.At != "" {
					<span class="[ at ]">{ " · " + c.At }</span>
				}
			</span>
			if c.Age != "" {
				<span class="[ age ]" data-age title={ "In this column since " + c.At } { staleAttrs(c.Stale)... }>{ c.Age }</span>
			}
		</p>
		if c.Reason != "" {
			<p class="[ reason ]">{ c.Reason }</p>
		}
	</article>
}

// liveBoard is the same markup bound to tasksBoard's columns.
templ liveBoard() {
	<div class="[ board ]" data-board aria-label="Tasks by status" x-bind:data-dragging="dragging">
		<template x-for="column in columns" x-bind:key="column.status">
			<section class="[ column ]" x-bind:data-column="column.status" x-bind:aria-label="column.label" x-bind:data-waiting="column.waiting" x-bind:data-archiving="column.archiving" x-bind:data-drag-origin="column.dragOrigin" x-bind:data-drop="column.dropOver ? 'over' : null" x-bind:data-drop-self="column.dropSelf" x-on:dragover="dragOver" x-on:dragleave="dragLeave" x-on:drop="drop">
				<header>
					<h2 x-text="column.label"></h2>
					<span class="[ count ]" x-bind:aria-label="column.count" x-text="column.countText"></span>
					<div class="[ actions ]" x-show="column.isDone">
						<button type="button" class="[ button ]" data-size="sm" data-archive-all x-show="archiveAll.shows" x-on:click="askArchiveAll">Archive all</button>
					</div>
					<p class="[ sub ]" x-show="column.waiting" x-text="column.sub"></p>
				</header>
				<template x-if="column.isDone">
					@archiveAllStrip()
				</template>
				<div class="[ cards ]">
					<p class="[ drop-slot ]" aria-hidden="true">
						@cardGlyph("drop")
						<span x-text="column.dropText"></span>
					</p>
					<p class="[ drop-self ]" aria-hidden="true" x-text="column.selfText"></p>
					<template x-for="card in column.cards" x-bind:key="card.id">
						<article class="[ card ]" x-bind:data-task-id="card.id" x-bind:data-status="card.status" x-bind:data-fresh="card.fresh" x-bind:data-pending="card.pending" x-bind:data-failed="card.failed" x-bind:data-ghost="card.ghost" x-bind:draggable="card.draggable ? 'true' : null" x-on:pointerdown="pointerDown" x-on:dragstart="dragStart" x-on:dragend="dragEnd">
							<span class="[ grip ]" aria-hidden="true"></span>
							<div class="[ top ]">
								<a class="[ title ]" draggable="false" x-bind:href="card.href" x-text="card.title"></a>
								@moveMenu()
							</div>
							<div class="[ signals ]" x-show="card.hasSignals">
								<span class="[ status ]" x-show="card.hasLive" x-bind:data-state="card.liveState" x-text="card.liveWord"></span>
								<template x-if="card.hasReviews">
									<span class="[ badge reviews ]">
										@cardGlyph("review")
										<span x-text="card.reviews"></span>
									</span>
								</template>
								<template x-if="card.hasMerge">
									<span class="[ badge merge ]" x-bind:data-merge-state="card.mergeState">
										@mergeGlyphs()
										<span x-text="card.mergeWord"></span>
									</span>
								</template>
							</div>
							<p class="[ last-move ]" data-last-move>
								<span>
									<span x-text="card.lead"></span> <span class="[ who ]" x-text="card.who"></span><span class="[ at ]" x-text="card.at"></span>
								</span>
								<span class="[ age ]" data-age x-show="card.age" x-bind:title="card.ageTitle" x-bind:data-stale="card.stale" x-text="card.age"></span>
							</p>
							<p class="[ reason ]" x-show="card.hasReason" x-text="card.reason"></p>
							<p class="[ note ]" role="status" x-show="card.note" x-text="card.note"></p>
						</article>
					</template>
					<p class="[ column-empty ]" x-show="column.showsEmpty" x-text="column.emptyText"></p>
					<p class="[ column-empty ]" data-archived-receipt x-show="column.receipt">
						@cardGlyph("archive")
						<span><span x-text="column.receipt"></span> <a x-bind:href="archivedHref">View Archived</a></span>
					</p>
				</div>
			</section>
		</template>
	</div>
}

// archiveAllStrip is the Done column's in-page confirmation of "Archive
// all" (never window.confirm): it names the count, then says it is archiving,
// or that it failed with the error and Try again.
templ archiveAllStrip() {
	<div class="[ confirm-strip ]" data-confirm="archive-all" role="group" aria-labelledby="archive-all-title" x-show="archiveAll.open" x-bind:data-tone="archiveAll.tone" x-on:keydown.escape="cancelArchiveAll">
		<h3 id="archive-all-title" x-text="archiveAll.title"></h3>
		<p x-show="archiveAll.body" x-text="archiveAll.body"></p>
		<template x-if="archiveAllError">
			<p class="[ code ]"><span x-text="archiveAllError.message"></span> · <span x-text="archiveAllError.code"></span> · <span x-text="archiveAllError.next"></span></p>
		</template>
		<div class="[ actions ]" x-show="archiveAll.asking">
			<button type="button" class="[ button ]" data-variant="primary" data-size="sm" x-bind:aria-busy="archiveAll.busy" x-on:click="confirmArchiveAll" x-text="archiveAll.confirm"></button>
			<button type="button" class="[ button ]" data-size="sm" x-bind:disabled="archiveAll.busy" x-on:click="cancelArchiveAll">Cancel</button>
		</div>
		<div class="[ actions ]" x-show="archiveAll.failed">
			<button type="button" class="[ button ]" data-variant="primary" data-size="sm" x-on:click="confirmArchiveAll">Try again</button>
			<button type="button" class="[ button ]" data-size="sm" x-on:click="dismissArchiveAll">Dismiss</button>
		</div>
	</div>
}

// moveMenu is a live card's "Move to…" menu (the design system's menu
// button): the statuses as radio items with their keys, the current one
// checked and left out of the arrows, then "Open task". tasksBoard's
// menuSelect moves the card.
templ moveMenu() {
	<div class="[ menu ]" x-data="menu" data-align="end" x-on:menu-select="menuSelect">
		<button type="button" class="[ button move-to ]" data-variant="ghost" data-size="sm" x-bind:aria-disabled="card.pending ? 'true' : null">Move to…<span class="[ chevron ]" aria-hidden="true"></span></button>
		<div class="[ popup ]" role="menu">
			<div class="[ group ]" aria-hidden="true">Move to</div>
			<template x-for="choice in card.choices" x-bind:key="choice.status">
				<button type="button" role="menuitemradio" data-action="move" x-bind:data-value="choice.status" x-bind:data-key="choice.key" x-bind:aria-checked="choice.current" x-bind:aria-disabled="choice.current" x-bind:data-skip="choice.current" x-bind:data-initial="choice.initial"><span x-text="choice.label"></span><kbd x-text="choice.key"></kbd></button>
			</template>
			<hr role="separator"/>
			<template x-if="card.canArchive">
				<button type="button" role="menuitem" data-action="archive" data-key="a">Archive<kbd>A</kbd></button>
			</template>
			<a role="menuitem" x-bind:href="card.href">Open task</a>
		</div>
	</div>
}

// mergeGlyphs is every merge badge glyph; the badge's data-merge-state shows
// the one that applies (board.css), so the server and the live board share
// the markup.
templ mergeGlyphs() {
	@cardGlyph("merged")
	@cardGlyph("partial")
	@cardGlyph("not_merged")
	@cardGlyph("unknown")
}

// cardGlyph is a 16px line glyph of the board, decorative: the word beside it
// carries the meaning.
templ cardGlyph(name string) {
	<svg class="[ glyph ]" data-glyph={ name } aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
		switch name {
			case "merged":
				<circle cx="8" cy="8" r="6.25"></circle><path d="M5.3 8.2l1.8 1.8 3.6-3.8"></path>
			case "partial":
				<circle cx="8" cy="8" r="6.25"></circle><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor" stroke="none"></path>
			case "not_merged":
				<circle cx="8" cy="8" r="6.25"></circle>
			case "unknown":
				<circle cx="8" cy="8" r="6.25" stroke-dasharray="2.4 2.2"></circle><path d="M6.4 6.3a1.7 1.7 0 1 1 2.3 1.6c-.5.2-.7.6-.7 1.1v.3"></path><circle cx="8" cy="11.3" r=".55" fill="currentColor" stroke="none"></circle>
			case "review":
				<path d="M2 4.5h12M2 8h7M2 11.5h5"></path><path d="M10.5 11l1.5 1.5 2.5-3"></path>
			case "drop":
				<path d="M8 2.5v8M4.5 7L8 10.5 11.5 7M3 13.5h10"></path>
			case "archive":
				<rect x="1.75" y="2.75" width="12.5" height="3" rx="1"></rect><path d="M3 5.75v6.5a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-6.5M6.5 8.5h3"></path>
			case "restore":
				<path d="M3 8a5 5 0 1 0 1.5-3.6"></path><path d="M3 2.5v2.5h2.5"></path>
		}
	</svg>
}

// NewTaskPage creates a task in the project.
templ NewTaskPage(f shell.Frame, projectID, projectName string) {
	@shell.AppShell(f) {
		<main id="main" class="[ frame ]">
			<header class="[ toolbar ]">
				<a class="[ crumb ]" href={ templ.SafeURL("/projects/" + projectID) }>{ projectName } /</a>
				<h1>New task</h1>
			</header>
			<div data-scroll>
				<form class="[ wrapper flow ] [ region ]" style="--wrapper-max: 44rem" x-data="tasksNewTask" data-project-id={ projectID } x-on:submit.prevent="submit">
					<div class="[ field ]">
						<label for="task-title">Title</label>
						<input id="task-title" autocomplete="off" required autofocus x-model="title" placeholder="Add the SSE feed to orchestration"/>
					</div>
					<div class="[ field ]">
						<label for="task-description">Description <span class="[ color-ink-faint weight-regular ]">(optional)</span></label>
						<textarea id="task-description" x-model="description" placeholder="What done looks like. Agents get this as their brief."></textarea>
					</div>
					<div class="[ field ]">
						<label for="task-status">Status</label>
						<select id="task-status" x-model="status">
							for _, st := range Statuses {
								<option value={ st.Value }>{ st.Label }</option>
							}
						</select>
					</div>
					<template x-if="error">
						<div class="[ banner ]" data-tone="danger" role="alert">
							<div class="[ flow ] [ flow-space-3xs ]">
								<span x-text="error.message"></span>
								<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
							</div>
						</div>
					</template>
					<div class="[ cluster ]">
						<button type="submit" class="[ button ]" data-variant="primary" disabled x-bind:disabled="cannotSubmit" x-bind:aria-busy="submitting">Create task</button>
						<a class="[ button ]" data-variant="ghost" href={ templ.SafeURL("/projects/" + projectID) }>Cancel</a>
					</div>
				</form>
			</div>
		</main>
	}
}
