package tasks

import (
	"strconv"

	"operators-mcp/internal/adapter/in/web/components"
	"operators-mcp/internal/adapter/in/web/projects"
	"operators-mcp/internal/adapter/in/web/shell"
)

// ProjectPage is the project root: its tasks as a kanban board. The server
// renders the first paint inside [data-ssr]; tasksBoard renders the same
// columns live from the rail's store and removes the server copy.
templ ProjectPage(f shell.Frame, projectID, projectName string, b Board) {
	@shell.AppShell(f) {
		<main id="main" class="[ frame ]" x-data="tasksBoard" data-project-id={ projectID } x-on:task-changed.window="taskChanged">
			<header class="[ toolbar ]">
				<h1>{ projectName }</h1>
				<div class="[ actions ]">
					<a class="[ button ]" data-variant="ghost" data-size="sm" href={ templ.SafeURL(projects.RepositoriesHref(projectID)) }>Repositories</a>
					<a class="[ button ]" data-variant="ghost" data-size="sm" href={ templ.SafeURL(projects.SettingsHref(projectID)) }>Settings</a>
					<a class="[ button ]" data-variant="primary" data-size="sm" href={ templ.SafeURL(NewTaskHref(projectID)) }>New task</a>
				</div>
			</header>
			<template x-if="error">
				<div class="[ banner ] [ pad-s ]" data-tone="danger" role="alert">
					<div class="[ flow ] [ flow-space-3xs grow ]">
						<span x-text="error.message"></span>
						<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
					</div>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
				</div>
			</template>
			<p class="[ visually-hidden ]" role="status" aria-live="polite" x-text="announcement"></p>
			<div data-scroll>
				<div x-ignore data-ssr>
					if b.Empty() {
						@noTasks(projectID)
					} else {
						@ssrBoard(b)
					}
				</div>
				<template x-if="isEmpty">
					@noTasks(projectID)
				</template>
				<template x-if="hasTasks">
					@liveBoard()
				</template>
			</div>
		</main>
	}
}

// noTasks is the empty state: what a task is, and the way to make one.
templ noTasks(projectID string) {
	@components.Empty("No tasks in this project yet", "A task is a piece of work agents take on, in one or more sessions.") {
		<div class="[ actions ]">
			<a class="[ button ]" data-variant="primary" href={ templ.SafeURL(NewTaskHref(projectID)) }>Create a task</a>
		</div>
	}
}

// ssrBoard is the first paint: complete without JavaScript, ignored by Alpine.
templ ssrBoard(b Board) {
	<div class="[ board ]" data-board aria-label="Tasks by status">
		for _, c := range b.Columns {
			<section class="[ column ]" data-column={ c.Status } aria-label={ c.Label } { waitingAttrs(c.Waiting())... }>
				<header>
					<h2>{ c.Label }</h2>
					<span class="[ count ]">{ strconv.Itoa(len(c.Cards)) }</span>
					if c.Waiting() {
						<p class="[ sub ]">Waiting for your check</p>
					}
				</header>
				<div class="[ cards ]">
					for _, card := range c.Cards {
						@ssrCard(card, c.Status)
					}
					if len(c.Cards) == 0 {
						<p class="[ column-empty ]">{ c.EmptyText() }</p>
					}
				</div>
			</section>
		}
	</div>
}

// ssrCard is one card of the first paint.
templ ssrCard(c Card, column string) {
	<article class="[ card ]" data-task-id={ c.TaskID } data-status={ c.Status }>
		<div class="[ top ]">
			<a class="[ title ]" href={ templ.SafeURL(c.Href) }>{ c.Label }</a>
			<select data-size="sm" data-fit data-variant="ghost" data-task-id={ c.TaskID } aria-label={ "Move " + c.Label + " to" } x-on:change="moveTo">
				for _, st := range Statuses {
					<option value={ st.Value } { selectedIf(st.Value == column)... }>{ st.Label }</option>
				}
			</select>
		</div>
		if c.HasSignals() {
			<div class="[ signals ]">
				if c.LiveState != "" {
					<span class="[ status ]" data-state={ c.LiveState }>{ c.LiveWord }</span>
				}
				if c.Reviews > 0 {
					<span class="[ badge reviews ]">
						@cardGlyph("review")
						{ reviewsWord(c.Reviews) }
					</span>
				}
				if c.Merge != nil {
					<span class="[ badge merge ]" data-merge-state={ c.Merge.State }>
						@mergeGlyphs()
						{ c.Merge.Word }
					</span>
				}
			</div>
		}
		<p class="[ last-move ]" data-last-move>
			<span>
				{ c.Lead + " " }<span class="[ who ]">{ c.Who }</span>
				if c.At != "" {
					<span class="[ at ]">{ " · " + c.At }</span>
				}
			</span>
			if c.Age != "" {
				<span class="[ age ]" data-age title={ "In this column since " + c.At } { staleAttrs(c.Stale)... }>{ c.Age }</span>
			}
		</p>
		if c.Reason != "" {
			<p class="[ reason ]">{ c.Reason }</p>
		}
	</article>
}

// liveBoard is the same markup bound to tasksBoard's columns.
templ liveBoard() {
	<div class="[ board ]" data-board aria-label="Tasks by status">
		<template x-for="column in columns" x-bind:key="column.status">
			<section class="[ column ]" x-bind:data-column="column.status" x-bind:aria-label="column.label" x-bind:data-waiting="column.waiting">
				<header>
					<h2 x-text="column.label"></h2>
					<span class="[ count ]" x-text="column.count"></span>
					<p class="[ sub ]" x-show="column.waiting" x-text="column.sub"></p>
				</header>
				<div class="[ cards ]">
					<template x-for="card in column.cards" x-bind:key="card.id">
						<article class="[ card ]" x-bind:data-task-id="card.id" x-bind:data-status="card.status" x-bind:data-fresh="card.fresh">
							<div class="[ top ]">
								<a class="[ title ]" x-bind:href="card.href" x-text="card.title"></a>
								<select data-size="sm" data-fit data-variant="ghost" x-bind:data-task-id="card.id" x-bind:aria-label="card.moveLabel" x-bind:value="card.status" x-on:change="moveTo">
									for _, st := range Statuses {
										<option value={ st.Value }>{ st.Label }</option>
									}
								</select>
							</div>
							<div class="[ signals ]" x-show="card.hasSignals">
								<span class="[ status ]" x-show="card.hasLive" x-bind:data-state="card.liveState" x-text="card.liveWord"></span>
								<template x-if="card.hasReviews">
									<span class="[ badge reviews ]">
										@cardGlyph("review")
										<span x-text="card.reviews"></span>
									</span>
								</template>
								<template x-if="card.hasMerge">
									<span class="[ badge merge ]" x-bind:data-merge-state="card.mergeState">
										@mergeGlyphs()
										<span x-text="card.mergeWord"></span>
									</span>
								</template>
							</div>
							<p class="[ last-move ]" data-last-move>
								<span>
									<span x-text="card.lead"></span> <span class="[ who ]" x-text="card.who"></span><span class="[ at ]" x-text="card.at"></span>
								</span>
								<span class="[ age ]" data-age x-show="card.age" x-bind:title="card.ageTitle" x-bind:data-stale="card.stale" x-text="card.age"></span>
							</p>
							<p class="[ reason ]" x-show="card.hasReason" x-text="card.reason"></p>
						</article>
					</template>
					<p class="[ column-empty ]" x-show="column.isEmpty" x-text="column.emptyText"></p>
				</div>
			</section>
		</template>
	</div>
}

// mergeGlyphs is every merge badge glyph; the badge's data-merge-state shows
// the one that applies (board.css), so the server and the live board share
// the markup.
templ mergeGlyphs() {
	@cardGlyph("merged")
	@cardGlyph("partial")
	@cardGlyph("not_merged")
	@cardGlyph("unknown")
}

// cardGlyph is a 16px line glyph of the board, decorative: the word beside it
// carries the meaning.
templ cardGlyph(name string) {
	<svg class="[ glyph ]" data-glyph={ name } aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
		switch name {
			case "merged":
				<circle cx="8" cy="8" r="6.25"></circle><path d="M5.3 8.2l1.8 1.8 3.6-3.8"></path>
			case "partial":
				<circle cx="8" cy="8" r="6.25"></circle><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor" stroke="none"></path>
			case "not_merged":
				<circle cx="8" cy="8" r="6.25"></circle>
			case "unknown":
				<circle cx="8" cy="8" r="6.25" stroke-dasharray="2.4 2.2"></circle><path d="M6.4 6.3a1.7 1.7 0 1 1 2.3 1.6c-.5.2-.7.6-.7 1.1v.3"></path><circle cx="8" cy="11.3" r=".55" fill="currentColor" stroke="none"></circle>
			case "review":
				<path d="M2 4.5h12M2 8h7M2 11.5h5"></path><path d="M10.5 11l1.5 1.5 2.5-3"></path>
		}
	</svg>
}

// NewTaskPage creates a task in the project.
templ NewTaskPage(f shell.Frame, projectID, projectName string) {
	@shell.AppShell(f) {
		<main id="main" class="[ frame ]">
			<header class="[ toolbar ]">
				<a class="[ crumb ]" href={ templ.SafeURL("/projects/" + projectID) }>{ projectName } /</a>
				<h1>New task</h1>
			</header>
			<div data-scroll>
				<form class="[ wrapper flow ] [ region ]" style="--wrapper-max: 44rem" x-data="tasksNewTask" data-project-id={ projectID } x-on:submit.prevent="submit">
					<div class="[ field ]">
						<label for="task-title">Title</label>
						<input id="task-title" autocomplete="off" required autofocus x-model="title" placeholder="Add the SSE feed to orchestration"/>
					</div>
					<div class="[ field ]">
						<label for="task-description">Description <span class="[ color-ink-faint weight-regular ]">(optional)</span></label>
						<textarea id="task-description" x-model="description" placeholder="What done looks like. Agents get this as their brief."></textarea>
					</div>
					<div class="[ field ]">
						<label for="task-status">Status</label>
						<select id="task-status" x-model="status">
							for _, st := range Statuses {
								<option value={ st.Value }>{ st.Label }</option>
							}
						</select>
					</div>
					<template x-if="error">
						<div class="[ banner ]" data-tone="danger" role="alert">
							<div class="[ flow ] [ flow-space-3xs ]">
								<span x-text="error.message"></span>
								<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
							</div>
						</div>
					</template>
					<div class="[ cluster ]">
						<button type="submit" class="[ button ]" data-variant="primary" disabled x-bind:disabled="cannotSubmit" x-bind:aria-busy="submitting">Create task</button>
						<a class="[ button ]" data-variant="ghost" href={ templ.SafeURL("/projects/" + projectID) }>Cancel</a>
					</div>
				</form>
			</div>
		</main>
	}
}
