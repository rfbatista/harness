package tasks

import (
	"operators-mcp/internal/adapter/in/web/components"
	"operators-mcp/internal/adapter/in/web/sessions"
	"operators-mcp/internal/adapter/in/web/shell"
)

// TaskDesignPage is a task's design assets: what its sessions made, then the
// project assets attached to it from other tasks, as two groups of one
// listbox (J/K walk both), beside the selected one rendered as on a session's
// Design tab (sessions.ArtifactPreview). The bar detaches an attached asset,
// or moves one the task made to the project or back (asking first when that
// detaches it elsewhere). Attach a project asset… picks one from the
// project's library (sessions.PickerDialog). What others change arrives over
// the project feed and is read out by the polite live region.
templ TaskDesignPage(v TaskDesignView) {
	@shell.AppShell(v.Frame) {
		<main class="[ frame ]" x-data="sessionsTaskDesign" data-seed="task-design-seed">
			@templ.JSONScript("task-design-seed", v.Seed)
			<header class="[ toolbar ]">
				<a class="[ crumb ]" href={ templ.SafeURL("/projects/" + v.ProjectID) }>{ v.ProjectName } /</a>
				<a class="[ crumb ]" href={ templ.SafeURL(v.TaskHref) }>{ v.TaskTitle } /</a>
				<h1>Design assets</h1>
				<span class="[ color-ink-faint text-sm ]" x-text="countWord"></span>
				<div class="[ actions ]">
					<button type="button" class="[ button ]" data-size="sm" x-bind:aria-busy="loadingLibrary" x-on:click="openAssetPicker">Attach a project asset…</button>
					<a class="[ button ]" data-variant="ghost" data-size="sm" href={ templ.SafeURL(v.LibraryHref) }>Project design assets</a>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="reload">Reload</button>
				</div>
			</header>
			<p class="[ visually-hidden ]" role="status" aria-live="polite" x-text="announcement"></p>
			<template x-if="error">
				<div class="[ pad-inline-l pad-block-s ]">
					<div class="[ banner ]" data-tone="danger" role="alert">
						<div class="[ flow ] [ flow-space-3xs grow ]">
							<span x-text="error.message"></span>
							<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
						</div>
						<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
					</div>
				</div>
			</template>
			<template x-if="confirmingMoveBack">
				<div class="[ pad-inline-l pad-block-s ]">
					<div class="[ banner ]" data-tone="danger" role="alertdialog" x-bind:aria-label="moveBackQuestion">
						<strong class="[ grow ]" x-text="moveBackQuestion"></strong>
						<div class="[ cluster ] [ gutter-xs ]">
							<button type="button" class="[ button ]" data-variant="danger" data-size="sm" x-bind:aria-busy="currentPending" x-on:click="confirmMoveBack">Move back</button>
							<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="cancelMoveBack">Keep it</button>
						</div>
					</div>
				</div>
			</template>
			<template x-if="isEmpty">
				<div data-scroll>
					@components.Empty("Nothing designed or attached yet", "What this task's sessions publish to their Design tab shows here. Attach a project asset brings in a logo, a palette or a component another task made.")
				</div>
			</template>
			<div class="[ with-sidebar ] [ grow ]" style="--sidebar-target: 16rem" data-scroll x-show="hasCurrent">
				<div
					class="[ list ] [ divide-end ]"
					role="listbox"
					aria-label="Design assets of this task"
					tabindex="0"
					x-on:keydown.j.prevent="next"
					x-on:keydown.down.prevent="next"
					x-on:keydown.k.prevent="previous"
					x-on:keydown.up.prevent="previous"
				>
					<template x-if="hasMade">
						<div role="group" aria-labelledby="design-made" data-group="made">
							<h2 class="[ pad-inline-l pad-block-xs text-sm color-ink-faint ]" id="design-made">Made in this task</h2>
							<template x-for="card in madeCards" x-bind:key="card.id">
								@sessions.ArtifactCard()
							</template>
						</div>
					</template>
					<template x-if="hasAttached">
						<div role="group" aria-labelledby="design-attached" data-group="attached">
							<h2 class="[ pad-inline-l pad-block-xs text-sm color-ink-faint ]" id="design-attached">Attached from the project</h2>
							<template x-for="card in attachedCards" x-bind:key="card.id">
								@sessions.ArtifactCard() {
									<span class="[ meta ]" data-task>
										<span class="[ badge ]" data-tone="signal" x-text="card.attachedMark"></span>
										from <span x-text="card.fromTitle"></span>
									</span>
								}
							</template>
						</div>
					</template>
				</div>
				@sessions.ArtifactPreview() {
					<template x-if="hasCurrentFromHref">
						<span>From <a x-bind:href="currentFromHref" x-text="currentFromTitle"></a></span>
					</template>
					<template x-if="currentIsAttached">
						<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-busy="currentPending" x-bind:aria-label="detachAriaLabel" x-on:click="detachCurrent">Detach from this task</button>
					</template>
					<template x-if="canMoveCurrent">
						<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-busy="currentPending" x-bind:aria-label="currentMoveAriaLabel" x-text="currentMoveLabel" x-on:click="move">Move to project</button>
					</template>
				}
			</div>
			@sessions.PickerDialog("Filter project assets…")
		</main>
	}
}
