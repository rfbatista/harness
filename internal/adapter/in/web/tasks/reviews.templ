package tasks

import (
	"operators-mcp/internal/adapter/in/web/components"
	"operators-mcp/internal/adapter/in/web/shell"
)

// ReviewsPage is the project's review inbox: every request its tasks'
// architects raised that waits on the person, grouped by task, answered in
// place (reviewsInbox, scoped to the project). The list is read from the API
// once the page loads; the server paints how many wait.
templ ReviewsPage(frame shell.Frame, projectID, projectName string, seed *components.ReviewsSeed, pending int) {
	@shell.AppShell(frame) {
		@templ.JSONScript("reviews-seed", seed)
		<main class="[ frame ]" x-data="reviewsInbox" data-seed="reviews-seed">
			<header class="[ toolbar ]">
				<a class="[ crumb ]" href={ templ.SafeURL("/projects/" + projectID) }>{ projectName } /</a>
				<h1>Reviews</h1>
				<span class="[ color-ink-faint text-sm ]" x-text="headline">{ reviewsWaiting(pending) }</span>
			</header>
			<p class="[ visually-hidden ]" role="status" aria-live="polite" x-text="announcement"></p>
			<div class="[ reviews-inbox ]" data-scroll>
				@components.ReviewsError()
				if pending > 0 {
					<div class="[ flow ] [ flow-space-s pad-l ]" x-show="notLoaded" aria-hidden="true">
						<span class="[ skeleton ]" style="--skeleton-width: 40%"></span>
						<span class="[ skeleton ]" style="--skeleton-width: 75%"></span>
						<span class="[ skeleton ]" style="--skeleton-width: 60%"></span>
					</div>
				}
				<template x-for="group in groups" x-bind:key="group.taskId">
					<section class="[ reviews ]" data-attention x-bind:aria-label="group.title">
						<h2 class="[ reviews-head ]" tabindex="-1" data-reviews-heading>
							<template x-if="group.href">
								<a x-bind:href="group.href" x-text="group.title"></a>
							</template>
							<template x-if="!group.href">
								<span x-text="group.title"></span>
							</template>
						</h2>
						<template x-for="card in group.cards" x-bind:key="card.id">
							@components.ReviewCard()
						</template>
					</section>
				</template>
				<template x-if="isEmpty">
					@components.Empty("Nothing waits on you", "When a task's architect asks you to look at something, the request shows here and on the task's page. Answer it here or there; the architect gets your answer either way.")
				</template>
			</div>
		</main>
	}
}
