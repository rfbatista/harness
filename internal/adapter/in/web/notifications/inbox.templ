package notifications

import (
	"strconv"

	"operators-mcp/internal/adapter/in/web/shell"
)

// InboxPage is /notifications. The filters are a GET form (a native select
// and a radio pair), so the page works and the URL shares without
// JavaScript; the server paints the first page in [data-ssr], and
// notificationsPage takes over from the seed, live.
templ InboxPage(frame shell.Frame, v View) {
	@shell.AppShell(frame) {
		if v.Seed != nil {
			@templ.JSONScript("notifications-page-seed", v.Seed)
		}
		<main
			id="main"
			class="[ frame ]"
			x-data="notificationsPage"
			data-seed="notifications-page-seed"
			data-project-id={ v.Filter.ProjectID }
			data-project-name={ v.ProjectName }
			data-tab={ v.Filter.Tab }
		>
			<header class="[ toolbar ]">
				<h1>Notifications</h1>
				<span class="[ sum ]" x-text="summary">{ v.Summary() }</span>
				<button type="button" class="[ button ]" data-size="sm" style="display: none" x-show="live" x-bind:disabled="cannotMarkAll" x-bind:aria-busy="marking" x-on:click="markAll">{ v.MarkAllLabel() }</button>
			</header>
			<div class="[ inbox ]" data-scroll>
				<form class="[ inbox-filters ] [ cluster ] [ gutter-s ]" method="get" action={ templ.SafeURL(Href) } x-data="projectPicker">
					<label class="[ visually-hidden ]" for="inbox-project">Project</label>
					<select id="inbox-project" name="project" data-size="sm" data-fit x-on:change="go">
						<option value="" { selected(v.Filter.ProjectID == "")... }>All projects</option>
						for _, p := range v.Projects {
							<option value={ p.ID } { selected(p.ID == v.Filter.ProjectID)... }>{ p.Name }</option>
						}
					</select>
					<fieldset class="[ inbox-tabs ]">
						<legend class="[ visually-hidden ]">Show</legend>
						<label><input type="radio" name="tab" value="needs" { checked(v.Filter.Tab == "needs")... } x-on:change="go"/> Needs you <span class="[ n ]" x-text="needsCount">{ strconv.Itoa(v.OpenCount()) }</span></label>
						<label><input type="radio" name="tab" value="unread" { checked(v.Filter.Tab == "unread")... } x-on:change="go"/> Unread <span class="[ n ]" x-text="unreadCount">{ strconv.Itoa(v.UnreadCount()) }</span></label>
						<label><input type="radio" name="tab" value="all" { checked(v.Filter.Tab == "all")... } x-on:change="go"/> All <span class="[ n ]" x-text="allCount"></span></label>
					</fieldset>
					<noscript><button type="submit" class="[ button ]" data-size="sm">Apply</button></noscript>
				</form>
				<template x-if="error">
					<div class="[ banner ]" data-tone="danger" role="alert">
						<span class="[ grow ]" x-text="error.message"></span>
						<button type="button" class="[ button ]" data-size="sm" x-on:click="retry">Reload</button>
						<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
					</div>
				</template>
				<div class="[ banner ]" data-tone="attention" role="status" x-show="hasStreamNotice">
					<span class="[ grow ]" x-text="streamNotice"></span>
					<button type="button" class="[ button ]" data-size="sm" x-on:click="retry">Reload</button>
				</div>
				<div x-ignore data-ssr>
					if groups := v.Groups(); len(groups) > 0 {
						for _, g := range groups {
							<section class="[ group ]">
								<h2 class="[ ghead ]" data-tone={ g.Tone }>{ g.Title } <span class="[ n ]">{ strconv.Itoa(g.Count()) }</span></h2>
								<ul role="list" class="[ notification-list ]">
									for _, row := range g.Rows {
										<li>
											@serverRow(row)
										</li>
									}
								</ul>
							</section>
						}
						if v.Seed.NextBefore != "" {
							<a class="[ button ] [ more ]" data-size="sm" href={ templ.SafeURL(moreHref(v.Filter, v.Seed.NextBefore)) }>Older notifications</a>
						}
					} else if v.Seed != nil {
						<p class="[ empty-line ]">{ v.EmptyText() }</p>
					}
				</div>
				<template x-if="live">
					<div>
						<template x-for="group in groups" x-bind:key="group.key">
							<section class="[ group ]">
								<h2 class="[ ghead ]" x-bind:data-tone="group.tone"><span x-text="group.title"></span> <span class="[ n ]" x-text="group.count"></span></h2>
								<ul role="list" class="[ notification-list ]">
									<template x-for="entry in group.entries" x-bind:key="entry.key">
										<li>
											<template x-for="row in entry.plain" x-bind:key="row.id">
												@shell.NotificationLiveRow(true)
											</template>
											<template x-for="stack in entry.stacks" x-bind:key="stack.key">
												@shell.NotificationStack()
											</template>
										</li>
									</template>
								</ul>
							</section>
						</template>
						<p class="[ empty-line ]" x-show="isEmpty" x-text="emptyText"></p>
						<button type="button" class="[ button ] [ more ]" data-size="sm" x-show="hasMore" x-bind:aria-busy="loadingMore" x-on:click="loadMore">Load more</button>
					</div>
				</template>
			</div>
		</main>
	}
}

// serverRow is a notification as the server paints it: a plain link, no
// actions (they need JavaScript). It is the ledger row on what the server
// holds today: no actor, so the harness is the who, and the title is the what.
templ serverRow(row Row) {
	<article class="[ notification ]" data-layout="ledger" data-kind="agent" data-level={ row.Level } data-state={ row.State }>
		<span class="[ marker ]" aria-hidden="true"></span>
		<div class="[ who ]">
			<span class="[ avatar ]" aria-hidden="true" data-who="system">h</span>
			<span class="[ name ]">harness</span>
		</div>
		<div class="[ what ]">
			<a class="[ title ]" href={ templ.SafeURL(row.Href) }><span class="[ icon ]" aria-hidden="true"></span><span class="[ text ]"><span class="[ verb ]">{ row.Title }</span></span></a>
			<p class="[ where ]">
				<span class="[ project ]">{ row.Project }</span>
				if row.Task != "" {
					<span class="[ task ]">{ row.Task }</span>
				}
			</p>
		</div>
		<div class="[ more ]">
			if len(row.Sessions) > 0 {
				<ul role="list" class="[ interrupted-sessions ]">
					for _, s := range row.Sessions {
						<li data-state={ s.State }>
							<a href={ templ.SafeURL(s.Href) }>{ s.Label }</a>
							<span class="[ state ]">{ s.State }</span>
							if s.Reason != "" {
								<span class="[ reason ]">{ s.Reason }</span>
							}
						</li>
					}
				</ul>
			} else if row.Body != "" {
				<p class="[ body ]">{ row.Body }</p>
			}
		</div>
		<div class="[ when ]">
			<time datetime={ row.At }><span class="[ age ]">{ row.Age }</span></time>
			if row.LevelLabel != "" {
				<span class="[ standing ]" data-tone={ serverTone(row) }>{ row.LevelLabel }</span>
			}
		</div>
	</article>
}
