package tokensavers

import (
	"operators-mcp/internal/adapter/in/web/components"
	"operators-mcp/internal/adapter/in/web/shell"
)

// Page is /token-savers. The server paints the list in [data-ssr];
// tokenSaversPage
// (web/src/modules/tokensavers/presentation/components/tokenSaversPage.js)
// takes over from the seed and follows a running install.
templ Page(frame shell.Frame, v View) {
	@shell.AppShell(frame) {
		if v.Seed != nil {
			@templ.JSONScript("token-savers-seed", v.Seed)
		}
		<main id="main" class="[ frame ]" x-data="tokenSaversPage" data-seed="token-savers-seed">
			<header class="[ toolbar ]">
				<h1>Token savers</h1>
			</header>
			<div data-scroll>
				<div class="[ wrapper flow ] [ region ]" style="--wrapper-max: 52rem">
					<p class="[ color-ink-muted ]">Third-party tools that cut the tokens agent sessions spend. Each installs from the release the harness pins, verified against its checksum, under the server's data directory. Installing one turns it on nowhere; nothing is written to your own Claude configuration.</p>
					<p class="[ visually-hidden ]" role="status" aria-live="polite" x-text="announcement"></p>
					if v.Unsupported() != "" {
						<div class="[ banner ]" data-tone="attention" role="status" data-ssr>
							<span>{ v.Unsupported() }</span>
						</div>
					}
					<template x-if="!supported">
						<div class="[ banner ]" data-tone="attention" role="status">
							<span x-text="unsupported"></span>
						</div>
					</template>
					<template x-if="error">
						<div class="[ banner ]" data-tone="danger" role="alert">
							<div class="[ flow ] [ flow-space-3xs grow ]">
								<span x-text="error.message"></span>
								<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
							</div>
							<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
						</div>
					</template>
					<section class="[ pane ]" aria-labelledby="token-savers-title">
						<header><h2 id="token-savers-title">Installations</h2></header>
						<ul role="list" class="[ token-savers ]" x-ignore data-ssr>
							for _, r := range v.Rows() {
								@ssrRow(r)
							}
						</ul>
						<ul role="list" class="[ token-savers ]">
							<template x-for="s in rows" x-bind:key="s.saver">
								@liveRow()
							</template>
						</ul>
					</section>
				</div>
			</div>
		</main>
	}
}

templ ssrRow(r Row) {
	<li class="[ row ] [ token-saver ]" style="--row-columns: minmax(0, 1fr) auto" data-saver={ r.Saver } data-state={ string(r.State) }>
		<span class="[ flow ] [ flow-space-3xs pad-block-xs ]" style="min-inline-size: 0">
			<span class="[ cluster ] [ gutter-xs ]">
				<span class="[ title ] [ weight-medium font-mono ]">{ r.Saver }</span>
				@components.Badge(r.StateLabel, r.Tone)
			</span>
			<span class="[ text-sm color-ink-muted ]">{ r.Summary }</span>
			<span class="[ font-mono text-xs color-ink-faint ]">{ r.Versions }</span>
		</span>
	</li>
}

// liveRow is one saver once the browser has taken over: its state, versions,
// an install's progress or failure, and what can be done with it.
templ liveRow() {
	<li class="[ row ] [ token-saver ]" style="--row-columns: minmax(0, 1fr) auto" x-bind:data-saver="s.saver" x-bind:data-state="s.state">
		<span class="[ flow ] [ flow-space-3xs pad-block-xs ]" style="min-inline-size: 0">
			<span class="[ cluster ] [ gutter-xs ]">
				<span class="[ title ] [ weight-medium font-mono ]" x-text="s.saver"></span>
				<span class="[ badge ]" x-bind:data-tone="s.tone || null" x-text="s.stateLabel"></span>
			</span>
			<span class="[ text-sm color-ink-muted ]" x-text="s.summary"></span>
			<span class="[ font-mono text-xs color-ink-faint ]" x-text="s.versions"></span>
			<template x-if="s.progress">
				<span class="[ text-sm ]" role="status" x-text="s.progress"></span>
			</template>
			<template x-if="s.error">
				<div class="[ banner ]" data-tone="danger" role="alert">
					<div class="[ flow ] [ flow-space-3xs grow ]">
						<span x-text="s.error.message"></span>
						<span class="[ code ]"><span x-text="s.error.code"></span> · <span x-text="s.error.next"></span></span>
					</div>
				</div>
			</template>
		</span>
		<span class="[ cluster ] [ gutter-xs ]">
			<template x-if="s.installLabel">
				<button type="button" class="[ button ]" data-size="sm" data-variant="primary" x-on:click="install(s.saver)" x-text="s.installLabel"></button>
			</template>
			<template x-if="s.state === 'installing'">
				<button type="button" class="[ button ]" data-size="sm" disabled aria-busy="true">Installing…</button>
			</template>
			<template x-if="s.canRemove">
				<button type="button" class="[ button ]" data-size="sm" data-variant="ghost" x-bind:disabled="s.removing" x-bind:aria-busy="s.removing" x-on:click="remove(s.saver)">Remove</button>
			</template>
		</span>
	</li>
}
