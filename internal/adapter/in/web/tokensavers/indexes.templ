package tokensavers

// indexesSection is the Repository indexes section. The server paints the
// list in [data-ssr]; repositoryIndexes
// (web/src/modules/tokensavers/presentation/components/repositoryIndexes.js)
// takes over from the seed and follows a build.
templ indexesSection(v IndexesView) {
	if v.Seed != nil {
		@templ.JSONScript("repository-indexes-seed", v.Seed)
	}
	<section class="[ pane ]" aria-labelledby="repository-indexes-title" x-data="repositoryIndexes" data-seed="repository-indexes-seed">
		<header><h2 id="repository-indexes-title">Repository indexes</h2></header>
		<p class="[ text-sm color-ink-muted ]">codegraph's index of each repository where it is on, built in the repository's own checkout (<span class="[ font-mono ]">.codegraph/</span>, kept out of git). Every new worktree starts from a copy. When a session on the repository ends and its index is more than a day old, the harness rebuilds it.</p>
		<p class="[ visually-hidden ]" role="status" aria-live="polite" x-text="announcement"></p>
		<template x-if="error">
			<div class="[ banner ]" data-tone="danger" role="alert">
				<div class="[ flow ] [ flow-space-3xs grow ]">
					<span x-text="error.message"></span>
					<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
				</div>
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
			</div>
		</template>
		<ul role="list" class="[ list ]" x-ignore data-ssr>
			for _, r := range v.Rows() {
				@ssrIndexRow(r)
			}
		</ul>
		<ul role="list" class="[ list ]">
			<template x-for="i in rows" x-bind:key="i.repositoryId">
				@liveIndexRow()
			</template>
		</ul>
		<template x-if="loaded && rows.length === 0">
			<p class="[ text-sm color-ink-muted ]">No repository has codegraph on yet. Turn it on for a project, repository or task to build its index.</p>
		</template>
	</section>
}

templ ssrIndexRow(r IndexRow) {
	<li class="[ row ]" style="--row-columns: minmax(0, 1fr) auto" data-repository-index={ r.RepositoryID }>
		<span class="[ flow ] [ flow-space-3xs pad-block-xs ]" style="min-inline-size: 0">
			<span class="[ title ] [ weight-medium ]">{ r.Name }</span>
			<span class="[ font-mono text-xs color-ink-faint ]">{ r.Checkout }</span>
			<span class="[ text-sm ]" data-age>{ r.State }</span>
		</span>
	</li>
}

// liveIndexRow is one repository index once the browser has taken over: its
// age, a build running or failed, and Rebuild index.
templ liveIndexRow() {
	<li class="[ row ]" style="--row-columns: minmax(0, 1fr) auto" x-bind:data-repository-index="i.repositoryId" x-bind:data-state="i.state">
		<span class="[ flow ] [ flow-space-3xs pad-block-xs ]" style="min-inline-size: 0">
			<span class="[ title ] [ weight-medium ]" x-text="i.name"></span>
			<span class="[ font-mono text-xs color-ink-faint ]" x-text="i.checkout"></span>
			<span class="[ text-sm ]" data-age x-text="i.stateText"></span>
			<template x-if="i.error">
				<div class="[ banner ]" data-tone="danger" role="alert">
					<span x-text="i.error"></span>
				</div>
			</template>
		</span>
		<span class="[ cluster ] [ gutter-xs ]">
			<button type="button" class="[ button ]" data-size="sm" x-bind:disabled="i.building" x-bind:aria-busy="i.building" x-on:click="rebuild(i.repositoryId)">Rebuild index</button>
		</span>
	</li>
}
