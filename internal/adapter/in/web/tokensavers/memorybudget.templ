package tokensavers

import "strconv"

// MemoryBudget is the memory budget override of a repository's settings page
// and a task's Edit form (memoryBudgetOverride, web/src/modules/settings):
// the owner's own orçamento de memória in GB, empty to inherit, saved at once.
templ MemoryBudget(seed MemoryBudgetSeed) {
	<section class="[ flow ] [ flow-space-s ]" aria-labelledby="memory-budget-title" x-data="memoryBudgetOverride" data-level={ string(seed.Level) } data-owner-id={ seed.OwnerID } data-bytes={ strconv.FormatInt(seed.Bytes, 10) } data-effective={ strconv.FormatInt(seed.EffectiveBytes, 10) }>
		<h2 id="memory-budget-title">Memory budget</h2>
		<p class="[ text-sm color-ink-muted ]">{ seed.Lead() }</p>
		<template x-if="error">
			<div class="[ banner ]" data-tone="danger" role="alert">
				<div class="[ flow ] [ flow-space-3xs grow ]">
					<span x-text="error.message"></span>
					<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
				</div>
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
			</div>
		</template>
		<div class="[ pane ]">
			<div class="[ row ]" style="--row-columns: 7rem auto minmax(0, 1fr)">
				<label class="[ title ]" for={ "memory-budget-" + seed.OwnerID }>GB</label>
				<input id={ "memory-budget-" + seed.OwnerID } type="number" min="0.5" step="0.5" data-size="sm" data-fit data-memory-budget-override placeholder="inherit" value={ seed.Value() } x-bind:disabled="saving" x-bind:aria-busy="saving" x-on:change="choose" x-on:keydown.enter.prevent="choose"/>
				<span class="[ text-sm color-ink-muted ]" data-resolved x-text="summary">{ seed.Summary() }</span>
			</div>
		</div>
	</section>
}
