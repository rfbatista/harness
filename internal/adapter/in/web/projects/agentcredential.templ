package projects

// agentCredentialSection is a project's own Agent credential
// (projectAgentCredential, web/src/modules/agentcredential/presentation/components/projectAgentCredential.js):
// what its sessions sign in with instead of the global one on the Agent
// isolation page. The server paints the status in [data-ssr] and embeds the
// seed; the component takes over. The value is typed into an uncontrolled
// password input and is never rendered, seeded or kept.
templ agentCredentialSection(v AgentCredentialView) {
	<section id="project-credential" class="[ flow ] [ flow-space-s ]" aria-labelledby="project-credential-title" x-data="projectAgentCredential" data-seed="project-credential-seed" x-on:pagehide.window="pagehide">
		@templ.JSONScript("project-credential-seed", v.Seed)
		<div class="[ repel ]">
			<h2 id="project-credential-title">Agent credential</h2>
			<span id="project-credential-chip" class="[ badge ]" data-tone={ v.ChipTone() } x-bind:data-tone="chipTone" x-text="chipText">{ v.ChipText() }</span>
		</div>
		<div class="[ pane ]">
			<div class="[ flow ] [ flow-space-m ]" style="padding: var(--space-l)">
				<p class="[ visually-hidden ]" role="status" aria-live="polite" x-text="announcement"></p>
				<p class="[ text-sm color-ink-muted ]">
					What agents in <b>{ v.ProjectName }</b> sign in with, instead of the global
					<a href="/agent-isolation#credential">Agent credential</a>. An OAuth token uses your Claude subscription; an API key is billed to your Anthropic API account. Stored encrypted and never shown again.
				</p>
				<div x-ignore data-ssr class="[ flow ] [ flow-space-3xs ]">
					if v.SignedIn() {
						<p><span class="[ color-ink-muted ]">Signed in as</span> <strong>{ v.Seed.Account }</strong></p>
						<p><span class="[ color-ink-muted ]">Subscription</span> <span>{ v.Seed.Subscription }</span></p>
					} else if v.Seed.Set {
						<p><span class="[ color-ink-muted ]">Kind</span> <strong>{ v.KindName() }</strong></p>
						<p><span class="[ color-ink-muted ]">Saved</span> <span>{ v.SavedDate() }</span></p>
					} else {
						<p class="[ color-ink-muted ]">{ v.FallbackLine() }</p>
					}
				</div>
				<div class="[ flow ] [ flow-space-3xs ]" style="display: none" x-show="signedIn">
					<p><span class="[ color-ink-muted ]">Signed in as</span> <strong x-text="account"></strong></p>
					<p><span class="[ color-ink-muted ]">Subscription</span> <span x-text="subscription"></span></p>
				</div>
				<div class="[ flow ] [ flow-space-3xs ]" style="display: none" x-show="isSet">
					<p><span class="[ color-ink-muted ]">Kind</span> <strong x-text="kindName"></strong></p>
					<p><span class="[ color-ink-muted ]">Saved</span> <span x-text="savedDate"></span></p>
				</div>
				<p class="[ color-ink-muted ]" style="display: none" x-show="notSet" x-text="fallbackLine"></p>
				<template x-if="error">
					<div class="[ banner ]" data-tone="danger" role="alert">
						<div class="[ flow ] [ flow-space-3xs grow ]">
							<span x-text="error.message"></span>
							<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
						</div>
						<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
					</div>
				</template>
				<div class="[ cluster ] [ gutter-xs ]">
					<button type="button" class="[ button ]" data-variant="primary" disabled?={ v.SignInDisabled() } { shownIf(!v.SignedIn())... } x-show="signInShown" x-bind:disabled="signInDisabled" x-ref="signin" x-on:click="askSignIn">Sign in with Claude</button>
					<button type="button" class="[ button ]" data-variant="danger" { shownIf(v.SignedIn())... } x-ref="signout" x-show="signedIn" x-bind:disabled="pasteDisabled" x-on:click="askSignOut">Sign out</button>
					<button type="button" class="[ button ]" data-variant={ v.PasteTone() } x-bind:data-variant="pasteTone" x-ref="paste" x-text="pasteLabel" x-bind:disabled="pasteDisabled" x-on:click="askPaste">{ v.PasteLabel() }</button>
					<button type="button" class="[ button ]" data-variant="ghost" x-ref="remove" style="display: none" x-show="isPasted" x-bind:disabled="busy" x-on:click="askRemove">Remove</button>
				</div>
				<p class="[ hint ]" style="display: none" x-show="noSignInHint">Sign in needs the managed claude. <a href="/agent-isolation#claude">Install it first.</a></p>
				<div class="[ flow ] [ flow-space-s ]" role="group" aria-labelledby="project-credential-oauth-title" style="display: none" x-show="signingIn">
					<h3 id="project-credential-oauth-title">Sign in with Claude</h3>
					<ol class="[ flow ] [ flow-space-s ]">
						<li class="[ flow ] [ flow-space-3xs ]">
							<strong>Open the sign-in page</strong>
							<p style="display: none" x-show="starting"><span class="[ color-ink-muted ]">Starting </span><span class="[ font-mono ]">claude auth login</span><span class="[ color-ink-muted ]">…</span></p>
							<div class="[ flow ] [ flow-space-3xs ]" style="display: none" x-show="hasUrl">
								<div class="[ cluster ] [ gutter-xs ]">
									<a class="[ button ]" data-variant="primary" data-size="sm" target="_blank" rel="noopener noreferrer" x-bind:href="oauthUrl" x-on:click="opened">Open in a new tab ↗</a>
									<button type="button" class="[ button ]" data-size="sm" x-on:click="copyLink">Copy link</button>
								</div>
								<p class="[ font-mono text-sm ]" style="overflow-wrap: anywhere" x-text="oauthUrl"></p>
							</div>
						</li>
						<li class="[ flow ] [ flow-space-3xs ]">
							<strong>Approve access in your browser</strong>
							<p class="[ color-ink-muted ]">Sign in to Claude if asked, then choose Authorize. Claude shows a code.</p>
						</li>
						<li class="[ flow ] [ flow-space-3xs ]">
							<strong>Paste the code here</strong>
							<form class="[ cluster ] [ gutter-xs ]" novalidate autocomplete="off" x-on:submit.prevent="submitCode">
								<label class="[ visually-hidden ]" for="project-credential-oauth-code">Code from Claude</label>
								<input id="project-credential-oauth-code" type="password" class="[ font-mono text-sm ]" style="width: 20rem" autocomplete="off" autocapitalize="off" spellcheck="false" x-ref="code" x-bind:disabled="codeDisabled"/>
								<button type="submit" class="[ button ]" data-variant="primary" data-size="sm" x-bind:disabled="codeDisabled">Save code</button>
							</form>
						</li>
					</ol>
					<p role="status" aria-live="polite" class="[ color-ink-muted ]" x-text="oauthStatusLine"></p>
					<div class="[ cluster ] [ gutter-xs ]">
						<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="cancelSignIn">Cancel sign-in</button>
					</div>
				</div>
				<div id="project-credential-oauth-failed" class="[ banner ]" data-tone="danger" role="alert" style="display: none" x-show="signInFailed">
					<div class="[ flow ] [ flow-space-3xs grow ]">
						<span><strong x-text="oauthMessage"></strong></span>
						<span class="[ font-mono text-sm ]" style="display: none" x-show="hasDetail" x-text="oauthDetail"></span>
						<div class="[ cluster ] [ gutter-xs ]">
							<button type="button" class="[ button ]" data-size="sm" x-bind:disabled="signInDisabled" x-on:click="startSignIn">Start again</button>
							<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="cancelSignIn">Dismiss</button>
						</div>
					</div>
				</div>
				<div class="[ banner ]" data-tone="signal" role="status" style="display: none" x-show="signInSaved">
					<span><strong>Signed in.</strong> Claude keeps the login in this project's own Claude home; sessions of this project started from now on use it.</span>
				</div>
				<div class="[ banner ]" data-tone="attention" role="alertdialog" aria-labelledby="project-credential-remove-title" aria-describedby="project-credential-remove-text" style="display: none" x-show="confirming" x-on:keydown.escape="keep">
					<div class="[ flow ] [ flow-space-xs grow ]">
						<h3 id="project-credential-remove-title">Remove this project's credential?</h3>
						<p id="project-credential-remove-text">Running sessions keep working until they end. Sessions started after this use the global credential again.</p>
						<div class="[ cluster ] [ gutter-xs ]">
							<button type="button" class="[ button ]" data-variant="danger" data-size="sm" x-on:click="remove">Remove credential</button>
							<button type="button" class="[ button ]" data-size="sm" x-ref="keep" x-on:click="keep">Keep it</button>
						</div>
					</div>
				</div>
				<div id="project-credential-replace" class="[ banner ]" data-tone="attention" role="alertdialog" aria-labelledby="project-credential-replace-title" aria-describedby="project-credential-replace-text" style="display: none" x-show="replacing !== ''" x-on:keydown.escape="keepReplacing">
					<div class="[ flow ] [ flow-space-xs grow ]">
						<h3 id="project-credential-replace-title" x-text="replaceTitle"></h3>
						<p id="project-credential-replace-text" x-text="replaceText"></p>
						<div class="[ cluster ] [ gutter-xs ]">
							<button type="button" class="[ button ]" data-variant="danger" data-size="sm" x-text="replaceConfirm" x-on:click="confirmReplacing"></button>
							<button type="button" class="[ button ]" data-size="sm" x-ref="keepreplace" x-on:click="keepReplacing">Keep it</button>
						</div>
					</div>
				</div>
				<form class="[ flow ] [ flow-space-s ]" style="display: none" novalidate autocomplete="off" x-show="pasting" x-on:submit.prevent="save">
					<fieldset class="[ flow ] [ flow-space-3xs ]">
						<legend>Kind</legend>
						<label>
							<input type="radio" name="project-credential-kind" value="oauth" checked x-bind:checked="oauthChosen" x-on:change="chooseKind"/>
							OAuth token <span class="[ hint ]">from <span class="[ font-mono ]">claude setup-token</span>, starts with sk-ant-oat</span>
						</label>
						<label>
							<input type="radio" name="project-credential-kind" value="api_key" x-bind:checked="apiKeyChosen" x-on:change="chooseKind"/>
							Anthropic API key <span class="[ hint ]">starts with sk-ant-api</span>
						</label>
					</fieldset>
					<div class="[ field ]">
						<label for="project-credential-value">Token or key</label>
						<input id="project-credential-value" type="password" class="[ font-mono text-sm ]" autocomplete="off" autocapitalize="off" spellcheck="false" x-ref="value" x-on:input="detectKind"/>
					</div>
					<div class="[ cluster ] [ gutter-xs ]">
						<button type="submit" class="[ button ]" data-variant="primary" x-bind:disabled="busy">Save credential</button>
						<button type="button" class="[ button ]" data-variant="ghost" x-on:click="cancelPaste">Cancel</button>
					</div>
				</form>
			</div>
		</div>
	</section>
}

// shownIf hides an element the server knows is hidden until Alpine shows it.
func shownIf(shown bool) templ.Attributes {
	if shown {
		return templ.Attributes{}
	}
	return templ.Attributes{"style": "display: none"}
}
