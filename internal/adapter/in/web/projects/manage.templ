package projects

import (
	"operators-mcp/internal/adapter/in/web/components"
	"operators-mcp/internal/adapter/in/web/shell"
)

// ListPage is every project at a glance: whether agents work there now,
// its repositories, open tasks and last activity.
templ ListPage(v ListView) {
	@shell.AppShell(v.Frame) {
		<main class="[ frame ]">
			@templ.JSONScript("projects-seed", v.Seed)
			<header class="[ toolbar ]">
				<h1>Projects</h1>
				<div class="[ actions ]">
					<a class="[ button ]" data-size="sm" href="/projects/new">New project</a>
				</div>
			</header>
			<div data-scroll>
				<div class="[ wrapper flow ] [ region ]" style="--wrapper-max: 56rem">
					<div x-ignore data-ssr class="[ flow ]">
						if len(v.Rows) == 0 {
							@components.Empty("No projects yet", "A project is a directory the harness works on, usually holding several git repositories. Create one to give agents tasks there.")
						} else {
							<section class="[ pane ]" aria-label="Projects">
								for _, r := range v.Rows {
									@summaryRow(r)
								}
							</section>
							<p class="[ text-sm color-ink-faint ]">{ v.Total }</p>
						}
					</div>
				</div>
			</div>
		</main>
	}
}

// summaryRow is one project on the list: its name opens it, Settings its
// settings.
templ summaryRow(r SummaryRow) {
	<div class="[ row ]" style="--row-columns: minmax(0, 1fr) auto" data-project-id={ r.ID }>
		<span class="[ flow ] [ flow-space-3xs pad-block-xs ]" style="min-inline-size: 0">
			<span class="[ cluster ] [ gutter-s ]">
				<a class="[ weight-medium ]" href={ templ.SafeURL(r.Href) }>{ r.Name }</a>
				<span class="[ status ]" data-state={ r.State }>{ r.Word }</span>
			</span>
			<span class="[ text-sm color-ink-muted ]">{ r.Meta }</span>
			<span class="[ truncate ] [ font-mono text-xs color-ink-faint ]">{ r.RootDir }</span>
		</span>
		<a class="[ button ]" data-variant="ghost" data-size="sm" href={ templ.SafeURL(r.SettingsHref) } aria-label={ "Settings of " + r.Name }>Settings</a>
	</div>
}

// SettingsPage renames, re-points, tunes or deletes one project.
templ SettingsPage(v SettingsView) {
	@shell.AppShell(v.Frame) {
		<main class="[ frame ]">
			@templ.JSONScript("settings-seed", v.Seed)
			<header class="[ toolbar ]">
				<a class="[ crumb ]" href={ templ.SafeURL("/projects/" + v.Project.ID) }>{ v.Project.Name } /</a>
				<h1>Settings</h1>
			</header>
			<div data-scroll>
				<div class="[ wrapper flow ] [ region ]" style="--wrapper-max: 44rem">
					<form class="[ flow ] [ flow-space-m ]" aria-labelledby="settings-general">
						<h2 id="settings-general">General</h2>
						<div class="[ field ]">
							<label for="project-name">Name</label>
							<input id="project-name" name="name" autocomplete="off" value={ v.Project.Name }/>
						</div>
						<div class="[ field ]">
							<label for="project-root">Directory</label>
							<input id="project-root" name="root_dir" class="[ font-mono text-sm ]" autocomplete="off" value={ v.Project.RootDir } aria-describedby="project-root-hint"/>
							<span class="[ hint ]" id="project-root-hint">The absolute path of the project's directory on the machine the server runs on (~ is its user's home). Running sessions keep their worktrees.</span>
						</div>
						<div class="[ cluster ]">
							<button type="submit" class="[ button ]" data-variant="primary" disabled>Save changes</button>
						</div>
					</form>

					<section class="[ flow ] [ flow-space-m ]" aria-labelledby="settings-ignored">
						<h2 id="settings-ignored">Ignored paths</h2>
						<p class="[ text-sm color-ink-muted ]">Hidden from the project's file tree, with everything inside them. Relative to the project's directory.</p>
						<div x-ignore data-ssr>
							if len(v.Project.IgnoredPaths) == 0 {
								<p class="[ text-sm color-ink-faint ]">No ignored paths.</p>
							} else {
								<div class="[ pane ]">
									for _, p := range v.Project.IgnoredPaths {
										<div class="[ row ]" style="--row-columns: minmax(0, 1fr)">
											<span class="[ title ] [ font-mono text-sm ]">{ p }</span>
										</div>
									}
								</div>
							}
						</div>
					</section>

					<section class="[ flow ] [ flow-space-s ]" aria-labelledby="settings-repositories">
						<h2 id="settings-repositories">Repositories and env files</h2>
						<div class="[ pane ]">
							<a class="[ row ]" href={ templ.SafeURL(v.RepositoriesHref) } style="--row-columns: minmax(0, 1fr) auto">
								<span class="[ title ]">Repositories</span>
								<span class="[ meta ]">{ countOrNone(len(v.Repositories), "repository", "repositories") } →</span>
							</a>
							for _, r := range v.Repositories {
								<a class="[ row ]" href={ templ.SafeURL(r.EnvHref) } style="--row-columns: minmax(0, 1fr) auto">
									<span class="[ title ]">Env files of { r.Name }</span>
									<span class="[ meta ]">→</span>
								</a>
							}
						</div>
					</section>

					<section class="[ pane ]" data-tone="danger" aria-labelledby="settings-danger">
						<header><span id="settings-danger">Danger zone</span></header>
						<div class="[ flow ] [ flow-space-s ]" style="padding: var(--space-l)">
							<p class="[ text-sm ]">Deleting <b>{ v.Project.Name }</b> removes its tasks, documents, design assets and session history from the harness. Files on disk stay.</p>
							<div><button type="button" class="[ button ]" data-variant="danger" disabled>Delete project…</button></div>
						</div>
					</section>
				</div>
			</div>
		</main>
	}
}
