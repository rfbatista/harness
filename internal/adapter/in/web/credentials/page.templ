package credentials

import (
	"operators-mcp/internal/adapter/in/web/components"
	"operators-mcp/internal/adapter/in/web/shell"
)

// Page is /git-credentials. The server paints the identity and the list in
// [data-ssr]; gitCredentialsPage
// (web/src/modules/credentials/presentation/components/gitCredentialsPage.js)
// takes over from the seed and follows the catalog feed. The token, private
// key and passphrase inputs are uncontrolled (x-ref, never x-model), so no
// secret ever enters the component's state.
templ Page(frame shell.Frame, v View) {
	@shell.AppShell(frame) {
		if v.Seed != nil {
			@templ.JSONScript("credentials-seed", v.Seed)
		}
		<main
			id="main"
			class="[ frame ]"
			x-data="gitCredentialsPage"
			data-seed="credentials-seed"
			data-host={ v.Host }
			data-kind={ v.Kind }
			data-credential={ v.Credential }
			x-on:menu-select="rowAction"
			x-on:dialog-action="dialogAction"
			x-on:pagehide.window="clearSecrets"
		>
			<header class="[ toolbar ]">
				<h1>Git credentials</h1>
				<div class="[ actions ]">
					<button type="button" class="[ button ]" data-size="sm" data-variant="primary" x-ref="addButton" x-bind:disabled="cannotAdd" x-on:click="openAdd()">Add credential</button>
				</div>
			</header>
			<div data-scroll>
				<div class="[ wrapper flow ] [ region ]" style="--wrapper-max: 52rem">
					<p class="[ color-ink-muted ]">The only credentials the harness and its agent sessions use for git remotes and GitHub. Your machine's own git, ssh and gh sign-ins are never used. Secrets are stored encrypted and never shown again.</p>
					<p class="[ visually-hidden ]" role="status" aria-live="polite" x-text="announcement"></p>
					<div class="[ banner ]" data-tone="danger" role="alert" { shownIf(v.Locked())... } x-show="locked">
						<span>{ LockedText }</span>
					</div>
					<template x-if="error">
						<div class="[ banner ]" data-tone="danger" role="alert">
							<div class="[ flow ] [ flow-space-3xs grow ]">
								<span x-text="error.message"></span>
								<span class="[ code ]"><span x-text="error.code"></span> · <span x-text="error.next"></span></span>
							</div>
							<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissError">Dismiss</button>
						</div>
					</template>
					<div class="[ banner ]" data-tone="attention" role="status" style="display: none" x-show="notice">
						<div class="[ repel ] [ grow ]">
							<span x-text="notice"></span>
							<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="dismissNotice">Dismiss</button>
						</div>
					</div>
					@credentialForm()
					@identitySection(v)
					@credentialList(v)
				</div>
			</div>
			@deleteConfirm()
		</main>
	}
}

// credentialForm adds a credential, edits one, or replaces its secret.
templ credentialForm() {
	<form class="[ pane ] [ credential-form ]" aria-labelledby="credential-form-title" novalidate autocomplete="off" style="display: none" x-show="formOpen" x-on:submit.prevent="submit" x-on:keydown.escape="cancelForm">
		<header><h2 id="credential-form-title" x-text="formTitle"></h2></header>
		<div class="[ flow ] [ flow-space-m ]" style="padding: var(--space-l)">
			<fieldset class="[ field ]" x-show="showsKindChoice">
				<legend>Kind</legend>
				<div class="[ field ]" data-inline>
					<input type="radio" id="credential-kind-token" name="kind" value="https_token" x-bind:checked="form.kind === 'https_token'" x-on:change="setKind('https_token')"/>
					<label for="credential-kind-token">HTTPS token</label>
				</div>
				<div class="[ field ]" data-inline>
					<input type="radio" id="credential-kind-key" name="kind" value="ssh_key" x-bind:checked="form.kind === 'ssh_key'" x-on:change="setKind('ssh_key')"/>
					<label for="credential-kind-key">SSH key</label>
				</div>
			</fieldset>
			<div class="[ flow ] [ flow-space-m ]" x-show="showsDetails">
				<div class="[ field ]">
					<label for="credential-name">Name</label>
					<input id="credential-name" autocomplete="off" x-ref="formFirst" x-model="form.name" x-bind:aria-invalid="nameInvalid" aria-describedby="credential-name-error"/>
					<template x-if="nameError">
						<span class="[ error ]" id="credential-name-error"><span x-text="nameError.message"></span> <span class="[ font-mono ]" x-text="nameError.code"></span> · <span x-text="nameError.next"></span></span>
					</template>
				</div>
				<div class="[ field ]">
					<label for="credential-host">Host</label>
					<input id="credential-host" class="[ font-mono text-sm ]" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="github.com" x-model="form.host" x-on:change="suggestDefault" aria-describedby="credential-host-hint"/>
					<span class="[ hint ]" id="credential-host-hint">The host it signs in to, without https:// or a path; add :port when it is not the usual one.</span>
				</div>
				<div class="[ field ]">
					<label for="credential-username">Username</label>
					<input id="credential-username" class="[ font-mono text-sm ]" autocomplete="off" autocapitalize="off" spellcheck="false" x-model="form.username" x-bind:placeholder="usernamePlaceholder" aria-describedby="credential-username-hint"/>
					<span class="[ hint ]" id="credential-username-hint">Leave it empty for the usual one: x-access-token for a token, git for an SSH key.</span>
				</div>
			</div>
			<div class="[ field ]" x-show="showsToken">
				<label for="credential-token">Token</label>
				<input id="credential-token" type="password" class="[ font-mono text-sm ]" autocomplete="off" autocapitalize="off" spellcheck="false" x-ref="token" aria-describedby="credential-token-hint"/>
				<span class="[ hint ]" id="credential-token-hint">A personal access token with access to the repositories. It is stored encrypted and never shown again.</span>
			</div>
			<fieldset class="[ field ]" x-show="showsKeySource">
				<legend>Key</legend>
				<div class="[ field ]" data-inline>
					<input type="radio" id="credential-key-generate" name="key-source" value="generate" x-model="form.keySource"/>
					<label for="credential-key-generate">Generate a new ed25519 key</label>
				</div>
				<div class="[ field ]" data-inline>
					<input type="radio" id="credential-key-file" name="key-source" value="file" x-model="form.keySource"/>
					<label for="credential-key-file">Use a private key file</label>
				</div>
				<div class="[ field ]" data-inline>
					<input type="radio" id="credential-key-paste" name="key-source" value="paste" x-model="form.keySource"/>
					<label for="credential-key-paste">Paste a private key</label>
				</div>
			</fieldset>
			<fieldset class="[ field ]" x-show="showsRekeySource">
				<legend>New key</legend>
				<div class="[ field ]" data-inline>
					<input type="radio" id="credential-rekey-file" name="rekey-source" value="file" x-model="form.keySource"/>
					<label for="credential-rekey-file">From a private key file</label>
				</div>
				<div class="[ field ]" data-inline>
					<input type="radio" id="credential-rekey-paste" name="rekey-source" value="paste" x-model="form.keySource"/>
					<label for="credential-rekey-paste">Paste it</label>
				</div>
			</fieldset>
			<div class="[ field ]" x-show="showsFile">
				<label for="credential-key-file-input">Private key file</label>
				<input id="credential-key-file-input" type="file" x-ref="keyFile"/>
				<span class="[ hint ]">Read here only to send it; it is stored encrypted and never shown again.</span>
			</div>
			<div class="[ field ]" x-show="showsPaste">
				<label for="credential-private-key">Private key</label>
				<textarea id="credential-private-key" rows="6" class="[ font-mono text-xs ]" data-masked autocomplete="off" autocapitalize="off" spellcheck="false" x-ref="privateKey" placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"></textarea>
				<span class="[ hint ]">OpenSSH or PEM. It is masked while you paste and never shown again.</span>
			</div>
			<div class="[ field ]" x-show="showsKeyInput">
				<label for="credential-passphrase">Passphrase <span class="[ color-ink-faint ]">(only for an encrypted key)</span></label>
				<input id="credential-passphrase" type="password" autocomplete="off" x-ref="passphrase" aria-describedby="credential-passphrase-hint"/>
				<span class="[ hint ]" id="credential-passphrase-hint">Used once to open the key, never stored.</span>
			</div>
			<div class="[ field ]" data-inline x-show="showsDetails">
				<input type="checkbox" id="credential-default" x-model="form.isDefault" x-on:change="touchDefault"/>
				<label for="credential-default" x-text="defaultLabel"></label>
			</div>
			<template x-if="formError">
				<div class="[ banner ]" data-tone="danger" role="alert">
					<div class="[ flow ] [ flow-space-3xs grow ]">
						<span x-text="formError.message"></span>
						<template x-if="formError.code"><span class="[ code ]"><span x-text="formError.code"></span> · <span x-text="formError.next"></span></span></template>
						<template x-if="hasPinnedRepositories">
							<ul class="[ flow ] [ flow-space-3xs ]" style="padding-inline-start: 1rem" aria-label="Pinned repositories">
								<template x-for="r in pinnedRepositories" x-bind:key="r.id">
									<li x-text="r.name"></li>
								</template>
							</ul>
						</template>
					</div>
				</div>
			</template>
			<div class="[ cluster ]">
				<button type="submit" class="[ button ]" data-variant="primary" x-bind:disabled="cannotSubmit" x-bind:aria-busy="submitting" x-text="submitLabel">Save</button>
				<button type="button" class="[ button ]" data-variant="ghost" x-on:click="cancelForm">Cancel</button>
			</div>
		</div>
	</form>
}

// identitySection is the author of commits made in harness worktrees.
templ identitySection(v View) {
	<section class="[ flow ] [ flow-space-s ]" aria-labelledby="identity-title">
		<h2 id="identity-title">Author identity</h2>
		<p class="[ text-sm color-ink-muted ]">The name and email on commits agents make in harness worktrees.</p>
		<div class="[ banner ]" data-tone="attention" role="status" { shownIf(v.IdentityUnset())... } x-show="identityUnset">
			<span>No author is set: commits in harness worktrees have no author until you set one.</span>
		</div>
		<form class="[ flow ] [ flow-space-m ]" x-on:submit.prevent="saveIdentity" x-on:keydown.escape="resetIdentity">
			<div class="[ grid ]" style="--grid-min: 16rem">
				<div class="[ field ]">
					<label for="identity-name">Name</label>
					<input id="identity-name" autocomplete="name" value={ v.IdentityName() } x-model="identityName"/>
				</div>
				<div class="[ field ]">
					<label for="identity-email">Email</label>
					<input id="identity-email" type="email" autocomplete="email" value={ v.IdentityEmail() } x-model="identityEmail" x-bind:aria-invalid="identityProblemText !== ''" aria-describedby="identity-problem"/>
					<span class="[ error ]" id="identity-problem" x-text="identityProblemText"></span>
				</div>
			</div>
			<template x-if="identityError">
				<div class="[ banner ]" data-tone="danger" role="alert">
					<span><span x-text="identityError.message"></span> <span class="[ font-mono ]" x-text="identityError.code"></span> · <span x-text="identityError.next"></span></span>
				</div>
			</template>
			<div class="[ cluster ]">
				<button type="submit" class="[ button ]" disabled x-bind:disabled="cannotSaveIdentity" x-bind:aria-busy="savingIdentity">Save identity</button>
				<button type="button" class="[ button ]" data-variant="ghost" style="display: none" x-show="identityDirty" x-on:click="resetIdentity">Undo</button>
				<span class="[ text-sm color-ink-muted ]" id="identity-notice" role="status" x-text="identityNotice"></span>
			</div>
		</form>
	</section>
}

// credentialList is every credential, one pane per host.
templ credentialList(v View) {
	<section class="[ flow ] [ flow-space-s ]" aria-labelledby="credentials-title">
		<h2 id="credentials-title">Credentials</h2>
		<div x-ignore data-ssr class="[ flow ] [ flow-space-s ]">
			if v.Empty() {
				@noCredentials()
			}
			for _, g := range v.Groups() {
				<section class="[ pane ]" aria-label={ g.Host }>
					<header><span class="[ font-mono ]">{ g.Host }</span></header>
					for _, r := range g.Rows {
						<div class="[ row ] [ credential-row ]" style="--row-columns: minmax(0, 1fr) auto" data-id={ r.ID }>
							<span class="[ flow ] [ flow-space-3xs pad-block-xs ]" style="min-inline-size: 0">
								<span class="[ cluster ] [ gutter-xs ]">
									<span class="[ title ] [ weight-medium ]">{ r.Name }</span>
									<span class="[ badge ]">{ r.KindLabel }</span>
									if r.IsDefault {
										<span class="[ badge ]" data-tone="signal">Default</span>
									}
								</span>
								<span class="[ truncate ] [ font-mono text-xs color-ink-faint ]">{ r.Meta }</span>
							</span>
						</div>
					}
				</section>
			}
		</div>
		<template x-if="isEmpty">
			@noCredentials()
		</template>
		<template x-for="g in groups" x-bind:key="g.host">
			<section class="[ pane ]" x-bind:aria-labelledby="g.headingId">
				<header><span class="[ font-mono ]" x-bind:id="g.headingId" x-text="g.host"></span></header>
				<template x-for="r in g.rows" x-bind:key="r.id">
					@liveRow()
				</template>
			</section>
		</template>
	</section>
}

templ noCredentials() {
	@components.Empty("No git credentials yet", "Add a token or an SSH key for each host your repositories push to. Until then pushes and pull requests fail.")
}

// liveRow is one credential once the browser has taken over: its badges and
// meta, Test, its public key, and its menu.
templ liveRow() {
	<div class="[ row ] [ credential-row ]" style="--row-columns: minmax(0, 1fr) auto" x-bind:data-id="r.id" x-bind:data-highlighted="r.highlighted">
		<span class="[ flow ] [ flow-space-2xs pad-block-xs ]" style="min-inline-size: 0">
			<span class="[ cluster ] [ gutter-xs ]">
				<span class="[ title ] [ weight-medium ]" x-text="r.name"></span>
				<span class="[ badge ]" x-text="r.kindLabel"></span>
				<template x-if="r.isDefault"><span class="[ badge ]" data-tone="signal">Default</span></template>
			</span>
			<span class="[ truncate ] [ font-mono text-xs color-ink-faint ]" x-text="r.meta"></span>
			<template x-if="r.keyOpen">
				<span class="[ key-line ]">
					<code x-text="r.publicKey"></code>
					<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-on:click="copyKey(r.id)">Copy</button>
				</span>
			</template>
			<template x-if="r.tested">
				<span class="[ banner ]" x-bind:data-tone="r.testOk ? 'success' : 'danger'" role="status">
					<span class="[ text-sm ]" x-text="r.testLine"></span>
				</span>
			</template>
		</span>
		<span class="[ cluster ] [ gutter-xs ]">
			<template x-if="r.hasPublicKey">
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-expanded="r.keyOpen" x-on:click="toggleKey(r.id)">Public key</button>
			</template>
			<button type="button" class="[ button ]" data-size="sm" x-bind:aria-label="r.testLabel" x-bind:disabled="locked || r.testing" x-bind:aria-busy="r.testing" x-on:click="test(r.id)">Test</button>
			<div class="[ menu ]" x-data="menu" data-align="end">
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:aria-label="r.menuLabel">⋯</button>
				<div class="[ popup ]" role="menu">
					<button type="button" role="menuitem" data-action="edit">Edit…</button>
					<button type="button" role="menuitem" data-action="replace" x-bind:aria-disabled="locked">Replace secret…</button>
					<template x-if="r.canSetDefault">
						<button type="button" role="menuitem" data-action="default">Set as default</button>
					</template>
					<template x-if="!r.canSetDefault">
						<button type="button" role="menuitem" data-action="undefault">Stop being the default</button>
					</template>
					<hr role="separator"/>
					<button type="button" role="menuitem" data-action="delete" data-tone="danger">Delete…</button>
				</div>
			</div>
		</span>
	</div>
}

// deleteConfirm asks before a credential goes; anchored to its ⋯, a sheet on a phone.
// A click on either button bubbles to the footer, which closes it after
// Delete has acted (the CSP build takes one statement per handler).
templ deleteConfirm() {
	<div class="[ popup ]" role="alertdialog" id="credential-delete" popover="manual" data-trap aria-labelledby="credential-delete-title" aria-describedby="credential-delete-text" x-data="popupDialog" x-on:dialog-open.window="openFrom($event)">
		<div class="[ confirm-panel ]">
			<h3 id="credential-delete-title">Delete this credential?</h3>
			<p id="credential-delete-text" x-text="deleteText"></p>
		</div>
		<footer x-on:click="close">
			<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" data-initial-focus>Keep it</button>
			<button type="button" class="[ button ]" data-variant="danger" data-size="sm" x-bind:aria-busy="deleting" x-on:click="act('delete')">Delete credential</button>
		</footer>
	</div>
}

// shownIf hides an element the server knows is empty until Alpine shows it.
func shownIf(shown bool) templ.Attributes {
	if shown {
		return templ.Attributes{}
	}
	return templ.Attributes{"style": "display: none"}
}
