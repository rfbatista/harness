package credentials

// RepositorySeed embeds the Repositories page's credentials seed once; the
// rows' repositoryCredential components share it through one store.
templ RepositorySeed(seed *RepositoriesSeed) {
	if seed != nil {
		@templ.JSONScript("repository-credentials-seed", seed)
	}
}

// RepositoryLine is a repository's credential as the server paints it, in
// a row's [data-ssr] part.
templ RepositoryLine(line BindingLine) {
	<span class="[ repository-credential ] [ text-sm ]" data-state={ line.State }>
		if line.Name != "" {
			Credential: <b>{ line.Name }</b> · { line.Text }
		} else {
			<span>{ line.Text }</span>
			if line.AddHref != "" {
				{ " " }<a href={ templ.SafeURL(line.AddHref) }>Add one</a>
			}
		}
	</span>
	if line.PullText != "" {
		<span class="[ repository-pull-requests ] [ text-sm color-ink-muted ]">
			{ line.PullText }
			if line.PullAddHref != "" {
				{ " " }<a href={ templ.SafeURL(line.PullAddHref) }>Add a token</a>
			}
		</span>
	}
}

// RepositoryCredential is a repository's credential once the browser has
// taken over, inside a row of the Repositories page's x-for (r is the row):
// what its pushes use, the Listbox select to pin one or go back to
// automatic, and Test (repositoryCredential,
// web/src/modules/credentials/presentation/components/repositoryCredential.js).
templ RepositoryCredential() {
	<div class="[ repository-credential ] [ flow ] [ flow-space-2xs ]" x-data="repositoryCredential" x-bind:data-repository-id="r.id" x-bind:data-repository-name="r.name">
		<span class="[ cluster ] [ gutter-xs ] [ text-sm ]" x-bind:data-state="line.state">
			<template x-if="line.name">
				<span>Credential: <b x-text="line.name"></b> · <span x-text="line.text"></span></span>
			</template>
			<template x-if="!line.name">
				<span x-bind:class="line.state === 'none' ? 'color-attention' : 'color-ink-muted'" x-text="line.text"></span>
			</template>
			<template x-if="line.addHref">
				<a x-bind:href="line.addHref">Add one</a>
			</template>
		</span>
		<template x-if="line.pullText">
			<span class="[ repository-pull-requests ] [ text-sm color-ink-muted ]">
				<span x-text="line.pullText"></span>
				<template x-if="line.pullAddHref">
					<a x-bind:href="line.pullAddHref">Add a token</a>
				</template>
			</span>
		</template>
		<template x-if="known">
			<span class="[ cluster ] [ gutter-xs ]">
				<div class="[ dropdown ]" x-data="dropdown" data-size="sm" data-fit x-bind:data-error="pickError || null" x-bind:aria-busy="busy" x-on:dropdown-retry="retry">
					<select aria-label="Credential" x-bind:aria-label="pickLabel" x-effect="fill($el)" x-on:change="pick($event.target)"></select>
				</div>
				<button type="button" class="[ button ]" data-variant="ghost" data-size="sm" x-bind:disabled="cannotTest" x-bind:aria-busy="testing" x-on:click="test">Test</button>
			</span>
		</template>
		<template x-if="testText">
			<span class="[ text-sm ]" role="status" x-bind:class="testOk ? 'color-success' : 'color-danger'" x-text="testText"></span>
		</template>
	</div>
}
