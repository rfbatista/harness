{
  "$comment": "Single source of truth for the harness design tokens. Edit here, then run `go run ./cmd/designtokens` to regenerate css/global/tokens.css and css/utilities/tokens.css. Never edit the generated files by hand.",

  "font": {
    "sans": "\"Atkinson Hyperlegible Next\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "mono": "\"Atkinson Hyperlegible Mono\", ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
  },
  "text": {
    "xs": "0.75rem",
    "sm": "0.8125rem",
    "base": "0.875rem",
    "md": "1rem",
    "lg": "1.125rem",
    "xl": "1.375rem",
    "2xl": "1.75rem"
  },
  "leading": {
    "tight": "1.25",
    "snug": "1.4",
    "normal": "1.55"
  },
  "weight": {
    "regular": "400",
    "medium": "500",
    "bold": "700"
  },
  "space": {
    "3xs": "0.125rem",
    "2xs": "0.25rem",
    "xs": "0.375rem",
    "s": "0.5rem",
    "m": "0.75rem",
    "l": "1rem",
    "xl": "1.5rem",
    "2xl": "2rem",
    "3xl": "3rem"
  },
  "size": {
    "control-sm": "1.625rem",
    "control-md": "2rem",
    "row": "2.25rem",
    "touch": "2.75rem",
    "measure": "68ch",
    "sidebar": "15rem",
    "wrapper": "72rem"
  },
  "radius": {
    "xs": "3px",
    "sm": "5px",
    "md": "8px",
    "round": "999px"
  },
  "border": {
    "width": "1px",
    "focus-width": "2px",
    "focus-offset": "2px",
    "icon-width": "1.5px"
  },
  "ease": {
    "out": "cubic-bezier(0.25, 1, 0.5, 1)",
    "out-expo": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "duration": {
    "instant": "90ms",
    "quick": "160ms",
    "settle": "240ms",
    "signal": "1200ms"
  },
  "z": {
    "base": "0",
    "sticky": "10",
    "dropdown": "20",
    "overlay": "30",
    "dialog": "40",
    "toast": "50",
    "tooltip": "60"
  },

  "themes": {
    "light": {
      "color": {
        "canvas": "oklch(0.985 0.003 190)",
        "panel": "oklch(0.962 0.005 190)",
        "raised": "oklch(1 0 0)",
        "sunken": "oklch(0.94 0.006 190)",
        "hover": "oklch(0.22 0.01 190 / 0.05)",
        "pressed": "oklch(0.22 0.01 190 / 0.09)",
        "selected": "oklch(0.5 0.095 182 / 0.1)",
        "line": "oklch(0.9 0.006 190)",
        "line-strong": "oklch(0.8 0.008 190)",
        "line-control": "oklch(0.64 0.012 190)",
        "ink": "oklch(0.22 0.01 190)",
        "ink-muted": "oklch(0.45 0.012 190)",
        "ink-faint": "oklch(0.53 0.012 190)",
        "signal": "oklch(0.5 0.095 182)",
        "signal-strong": "oklch(0.44 0.09 182)",
        "signal-ink": "oklch(0.99 0.008 182)",
        "signal-wash": "oklch(0.5 0.095 182 / 0.1)",
        "attention": "oklch(0.52 0.12 65)",
        "attention-wash": "oklch(0.75 0.13 75 / 0.16)",
        "danger": "oklch(0.52 0.18 27)",
        "danger-strong": "oklch(0.46 0.17 27)",
        "danger-ink": "oklch(0.99 0.01 27)",
        "danger-wash": "oklch(0.52 0.18 27 / 0.09)",
        "success": "oklch(0.5 0.11 150)",
        "success-wash": "oklch(0.5 0.11 150 / 0.1)",
        "focus": "oklch(0.5 0.095 182)",
        "scrim": "oklch(0.22 0.01 190 / 0.28)"
      },
      "shadow": {
        "float": "0 1px 2px oklch(0.22 0.01 190 / 0.06), 0 8px 24px -4px oklch(0.22 0.01 190 / 0.14)"
      }
    },
    "dark": {
      "color": {
        "canvas": "oklch(0.17 0.006 190)",
        "panel": "oklch(0.2 0.007 190)",
        "raised": "oklch(0.235 0.008 190)",
        "sunken": "oklch(0.145 0.006 190)",
        "hover": "oklch(0.94 0.006 190 / 0.05)",
        "pressed": "oklch(0.94 0.006 190 / 0.09)",
        "selected": "oklch(0.78 0.1 182 / 0.12)",
        "line": "oklch(0.29 0.008 190)",
        "line-strong": "oklch(0.4 0.01 190)",
        "line-control": "oklch(0.53 0.012 190)",
        "ink": "oklch(0.94 0.006 190)",
        "ink-muted": "oklch(0.76 0.01 190)",
        "ink-faint": "oklch(0.65 0.012 190)",
        "signal": "oklch(0.78 0.1 182)",
        "signal-strong": "oklch(0.84 0.09 182)",
        "signal-ink": "oklch(0.18 0.03 182)",
        "signal-wash": "oklch(0.78 0.1 182 / 0.12)",
        "attention": "oklch(0.81 0.13 75)",
        "attention-wash": "oklch(0.81 0.13 75 / 0.13)",
        "danger": "oklch(0.72 0.16 25)",
        "danger-strong": "oklch(0.78 0.13 25)",
        "danger-ink": "oklch(0.18 0.03 25)",
        "danger-wash": "oklch(0.72 0.16 25 / 0.12)",
        "success": "oklch(0.78 0.13 150)",
        "success-wash": "oklch(0.78 0.13 150 / 0.12)",
        "focus": "oklch(0.78 0.1 182)",
        "scrim": "oklch(0.1 0.005 190 / 0.6)"
      },
      "shadow": {
        "float": "0 1px 2px oklch(0 0 0 / 0.4), 0 12px 32px -6px oklch(0 0 0 / 0.55)"
      }
    }
  },

  "utilities": [
    { "prefix": "color", "property": "color", "group": "color",
      "only": ["ink", "ink-muted", "ink-faint", "signal", "attention", "danger", "success"] },
    { "prefix": "bg", "property": "background", "group": "color",
      "only": ["canvas", "panel", "raised", "sunken"] },
    { "prefix": "font", "property": "font-family", "group": "font" },
    { "prefix": "text", "property": "font-size", "group": "text" },
    { "prefix": "weight", "property": "font-weight", "group": "weight" },
    { "prefix": "leading", "property": "line-height", "group": "leading" },
    { "prefix": "flow-space", "property": "--flow-space", "group": "space" },
    { "prefix": "gutter", "property": "--gutter", "group": "space" },
    { "prefix": "pad", "property": "padding", "group": "space" },
    { "prefix": "pad-inline", "property": "padding-inline", "group": "space" },
    { "prefix": "pad-block", "property": "padding-block", "group": "space" }
  ]
}
