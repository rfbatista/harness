# Copy to .env and adjust values. The Makefile loads this file automatically (`-include .env`).

# --- HTTP / MCP server ---
# UI + REST API (Flutter uses http://localhost:8080/api on desktop)
HTTP_ADDR=:8080
# MCP streamable HTTP endpoint (IDE / Cursor connects here)
MCP_ADDR=:8081
# Bearer token every /api request must carry (but /api/health). Leave empty
# only while the server listens on 127.0.0.1; with an address like :8080 that
# reaches the network it logs a warning, since anyone could drive the agents.
# tui-client reads the same variable, or takes --token.
CODING_POOL_TOKEN=
# SQLite database file (use :memory: for ephemeral dev)
DB_PATH=data.db
# Default project root for blueprint operations (defaults to current working directory)
PROJECT_ROOT=
# Proxy embedded UI to Vite dev server (legacy React UI; use with `make web-dev`)
DEV_MODE=false

# --- Claude agent runtime ---
# Path to the Claude Code CLI binary
CLAUDE_BIN=claude
# Set to 1 to use the fake Claude CLI (tests / offline dev without a real binary)
CLAUDE_FAKE=0

# --- Genkit / AI execution ---
# OpenAI key enables GPT models; leave empty to use Ollama only
OPENAI_API_KEY=
GENKIT_DEFAULT_MODEL=openai/gpt-4o
GENKIT_OPENAI_MODEL=openai/gpt-4o
GENKIT_OLLAMA_MODEL=qwen3-coder:latest
OLLAMA_SERVER_URL=http://127.0.0.1:11434
GENKIT_MAX_TURNS=10

# --- Optional integrations ---
POSTMAN_API_KEY=
POSTMAN_MCP_URL=https://mcp.postman.com/mcp
